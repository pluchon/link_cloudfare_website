# 环境变量示例（不要把真实密钥提交进 Git）
# 本地：复制为 .env 后按需填写
# Cloudflare Pages：Settings → Environment variables（Production）

# Turnstile Site Key（公开，构建时打进前端）
PUBLIC_TURNSTILE_SITE_KEY=

# Turnstile Secret Key（仅服务端，Pages Function 使用，务必 Encrypt）
TURNSTILE_SECRET_KEY=

# 进站 Cookie 签名密钥（随机长字符串，务必 Encrypt）
GATE_COOKIE_SECRET=
