---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBackdrop from '../../components/PageBackdrop.astro';
import { jelly2048Art, pageBackdrops } from '../../config/site';
import { getGames } from '../../lib/content';

const entry = (await getGames()).find((item) => item.data.play === jelly2048Art.play);
const title = entry?.data.title ?? '果冻 2048';
const summary = entry?.data.summary ?? '';
---

<BaseLayout title={title} description={summary}>
  <PageBackdrop art={pageBackdrops.game} />

  <section class="wrap jelly-page">
    <header class="jelly-head">
      <h1 class="jelly-head__title">{title}</h1>
      <a class="jelly-head__back" href="/game/"><span aria-hidden="true">←</span> 游戏大厅</a>
    </header>

    <div class="jelly" data-jelly>
      <aside class="jelly__side">
        <div class="jelly__panel">
          <dl class="jelly__stats">
            <div>
              <dt>分数</dt>
              <dd data-score>0</dd>
            </div>
            <div>
              <dt>最高</dt>
              <dd data-best>0</dd>
            </div>
            <div>
              <dt>用时</dt>
              <dd data-time>00:00</dd>
            </div>
            <div>
              <dt>最大</dt>
              <dd data-tile>2</dd>
            </div>
          </dl>

          <section class="jelly__ladder">
            <h2 class="jelly__label">合成进度 <span>2 → 8192</span></h2>
            <ol class="jelly__ladder-dots" data-ladder></ol>
          </section>

          <div class="jelly__actions">
            <button type="button" class="jelly-btn" data-pause aria-pressed="false">
              <svg class="jelly-btn__icon jelly-btn__icon--on" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 6v12M15 6v12" />
              </svg>
              <svg class="jelly-btn__icon jelly-btn__icon--off" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5.5v13l10.5-6.5z" />
              </svg>
              <span data-text>暂停</span>
            </button>
            <button type="button" class="jelly-btn jelly-btn--sound" data-mute aria-pressed="true">
              <svg class="jelly-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" />
                <path class="jelly-btn__wave" d="M15.5 9.5a3.5 3.5 0 0 1 0 5M18 7a7 7 0 0 1 0 10" />
                <path class="jelly-btn__mute" d="M16 9.5l5 5M21 9.5l-5 5" />
              </svg>
              <span data-text>音效</span>
            </button>
            <button type="button" class="jelly-btn" data-restart>
              <svg class="jelly-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.5 12a6.5 6.5 0 1 0 2-4.7" />
                <path d="M5 4.5v3.8h3.8" />
              </svg>
              <span data-text>重开</span>
            </button>
          </div>
        </div>

        <section class="jelly__records" data-records-box aria-labelledby="jelly-records-title">
          <header class="jelly__records-head">
            <h2 class="jelly__label" id="jelly-records-title">本机成绩记录</h2>
            <button type="button" class="jelly-btn jelly-btn--mini" data-clear-records>
              <svg class="jelly-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 7h14M10 7V5h4v2" />
                <path d="M7 7l.8 12h8.4L17 7" />
                <path class="jelly-btn__pink" d="M10.5 11v4.5M13.5 11v4.5" />
              </svg>
              <span>清空本机成绩</span>
            </button>
          </header>
          <table class="jelly__table" data-records-table>
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">分数</th>
                <th scope="col">最大</th>
                <th scope="col">用时</th>
                <th scope="col">日期</th>
              </tr>
            </thead>
            <tbody data-records></tbody>
          </table>
          <figure class="jelly__empty" data-records-empty hidden>
            <img class="jelly__empty-art jelly__empty-art--day" src={jelly2048Art.emptyRecords.light} alt="" loading="lazy" />
            <img class="jelly__empty-art jelly__empty-art--night" src={jelly2048Art.emptyRecords.dark} alt="" loading="lazy" />
            <figcaption>还没有记录，先来一局吧</figcaption>
          </figure>
        </section>
      </aside>

      <div class="jelly__board">
        <canvas class="jelly__canvas" data-canvas aria-label="果冻 2048 游戏画面：按住托盘里的果冻往外拉，松手弹出去：往下进井，往上或横着拉在托盘里弹"></canvas>
        <div class="jelly__overlay" data-overlay hidden>
          <p class="jelly__overlay-title" data-overlay-title></p>
          <p class="jelly__overlay-text" data-overlay-text></p>
          <button type="button" class="jelly-btn jelly-btn--main" data-overlay-btn></button>
        </div>
      </div>

      <!-- 一局进行中点重开、点链接离开时问一句：一行说明，两个按钮并排居中，确定在左、继续玩在右。默认焦点在「继续玩」上 -->
      <dialog class="jelly-confirm" data-confirm aria-labelledby="jelly-confirm-text">
        <p class="jelly-confirm__text" id="jelly-confirm-text" data-confirm-text></p>
        <div class="jelly-confirm__actions">
          <button type="button" class="jelly-btn" data-confirm-ok>结算</button>
          <button type="button" class="jelly-btn jelly-btn--main" data-confirm-cancel autofocus>继续玩</button>
        </div>
      </dialog>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountJelly } from '../../game/jelly/game';

  let destroy: (() => void) | null = null;

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-jelly]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = '1';
    destroy = mountJelly(root);
  }

  // 这段脚本可能在第一次 astro:page-load 之后才执行，所以先跑一次
  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    destroy?.();
    destroy = null;
  });
</script>

<style>
  .jelly-page {
    position: relative;
    z-index: 1;
    padding-block: 1rem 1.25rem;
  }

  .jelly-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    margin-bottom: 1rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .jelly-head__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .jelly-head__back {
    padding: 0.3rem 0.7rem;
    border: var(--hair) solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .jelly-head__back:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* 返回箭头悬停时往左挪一点 */
  .jelly-head__back span {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .jelly-head__back:hover span {
    transform: translateX(-3px);
  }

  /* 按钮：图标 + 文字，左上角一个粉色小折角，悬停时折角和边框一起变成强调色 */
  .jelly-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.42rem 0.5rem;
    border: var(--hair) solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .jelly-btn::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 0.4rem;
    height: 0.4rem;
    border-top: 1.5px solid var(--icon-pink);
    border-left: 1.5px solid var(--icon-pink);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .jelly-btn:hover,
  .jelly-btn:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--bg) 86%, var(--accent-wash));
  }

  .jelly-btn:hover::before,
  .jelly-btn:focus-visible::before {
    border-color: var(--accent);
  }

  /* 悬停时内侧多一圈粉色虚线框；按下时往下沉 1px */
  .jelly-btn::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: var(--hair) dashed transparent;
    pointer-events: none;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .jelly-btn:hover::after,
  .jelly-btn:focus-visible::after {
    border-color: color-mix(in srgb, var(--icon-pink) 70%, transparent);
  }

  .jelly-btn:active {
    transform: translateY(1px);
  }

  .jelly-btn__icon {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 暂停键：进行中显示两竖，暂停时换成三角 */
  .jelly-btn[aria-pressed="true"] .jelly-btn__icon--on,
  .jelly-btn[aria-pressed="false"] .jelly-btn__icon--off {
    display: none;
  }

  /* 音效键：开着画声波，关了画叉。这颗按钮的 aria-pressed 表示「声音开着」 */
  .jelly-btn--sound[aria-pressed="true"] .jelly-btn__mute,
  .jelly-btn--sound[aria-pressed="false"] .jelly-btn__wave {
    display: none;
  }

  /* 小号按钮：记录面板标题行右边的「清空本机成绩」，图标里两道粉色竖线；没有记录时变淡、点不了 */
  .jelly-btn--mini {
    padding: 0.2rem 0.45rem 0.2rem 0.4rem;
    gap: 0.3rem;
    font-size: 0.6875rem;
  }

  .jelly-btn--mini .jelly-btn__icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .jelly-btn__pink {
    stroke: var(--icon-pink);
  }

  .jelly-btn:disabled {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }

  .jelly-btn--main {
    padding: 0.5rem 1.4rem;
    color: var(--fg);
  }

  /* PC：左边一列面板，右边整块都是画板 */
  .jelly {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: stretch;
    /* 顶栏、标题行、上下留白和页脚加起来约 18.75rem，剩下的给游戏区，PC 上整页不滚动 */
    /* 用 svh 不用 dvh：手机滑动时地址栏收起、展开，dvh 跟着变，画板就会被一下一下地缩放 */
    height: clamp(26rem, calc(100svh - 18.75rem), 52rem);
  }

  /* 面板和画板四角各一个折角，左上和右下压一点粉色；顶上靠左一小段强调色短条（和游戏大厅标题下那条一样） */
  .jelly__side,
  .jelly__board {
    position: relative;
    border: var(--hair) solid var(--line);
    background:
      linear-gradient(var(--accent), var(--accent)) 1.1rem 0 / 2.2rem 2px no-repeat,
      color-mix(in srgb, var(--bg) 84%, transparent);
  }

  /* 面板再铺一层很淡的点阵底纹，不那么空 */
  .jelly__side {
    background:
      linear-gradient(var(--accent), var(--accent)) 1.1rem 0 / 2.2rem 2px no-repeat,
      radial-gradient(color-mix(in srgb, var(--line-strong) 70%, transparent) 0.7px, transparent 1px) 0 0 / 14px 14px,
      color-mix(in srgb, var(--bg) 84%, transparent);
  }

  .jelly__panel {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .jelly__side::before,
  .jelly__side::after,
  .jelly__board::before,
  .jelly__board::after {
    content: "";
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    pointer-events: none;
  }

  .jelly__side::before,
  .jelly__board::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--icon-pink);
    border-left: 2px solid var(--icon-pink);
  }

  .jelly__side::after,
  .jelly__board::after {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--line-strong);
    border-bottom: 2px solid var(--line-strong);
  }

  .jelly__side {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.8rem 1.1rem;
    overflow: hidden auto;
    scrollbar-width: none;
  }

  /* 计分：一行一项，名字在左、数字在右，中间一条点线连着 */
  .jelly__stats {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .jelly__stats > div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.28rem 0.1rem;
    border-bottom: var(--hair) dashed var(--line);
  }

  .jelly__stats > div::after {
    content: "";
    order: 1;
    flex: 1;
    align-self: center;
    border-bottom: var(--hair) dotted var(--line-strong);
    opacity: 0.6;
  }

  .jelly__stats dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  /* 名字前一个粉色小方点 */
  .jelly__stats dt::before {
    content: "";
    width: 4px;
    height: 4px;
    background: var(--icon-pink);
  }

  .jelly__stats dd {
    order: 2;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .jelly__stats > div:first-child dd {
    color: var(--accent);
  }

  .jelly__label {
    display: flex;
    justify-content: space-between;
    margin: 0 0 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }

  .jelly__label span {
    letter-spacing: 0.04em;
  }

  .jelly__ladder-dots {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jelly__ladder-dots :global(li) {
    width: 0.62rem;
    height: 0.62rem;
    border: 1.5px solid var(--dot);
    border-radius: 50%;
    opacity: 0.45;
    transition:
      background var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .jelly__ladder-dots :global(li.is-on) {
    background: var(--dot);
    opacity: 1;
  }

  .jelly__ladder-dots :global(li.is-top) {
    outline: 1px solid var(--dot);
    outline-offset: 2px;
  }

  .jelly__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  /* 本机最佳：占满面板剩下的高度，放得下几行就显示几行（脚本把放不下的整行藏掉，不会露半行） */
  /* 记录面板标题行：左边小标题，右边清空按钮 */
  .jelly__records-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .jelly__records-head .jelly__label {
    margin: 0;
  }

  .jelly__records {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding-top: 0.75rem;
    border-top: var(--hair) dashed var(--line);
  }

  .jelly__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .jelly__table th,
  .jelly__table :global(td) {
    padding: 0.3rem 0.25rem;
    text-align: right;
    white-space: nowrap;
  }

  .jelly__table th:first-child,
  .jelly__table :global(td:first-child) {
    width: 1.4rem;
    padding-left: 0;
    text-align: left;
  }

  .jelly__table th {
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    border-top: var(--hair) solid var(--line);
    border-bottom: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, var(--accent-wash));
  }

  .jelly__table :global(td) {
    color: var(--fg-faint);
    border-bottom: var(--hair) dashed var(--line);
  }

  .jelly__table :global(td:first-child) {
    color: var(--icon-pink);
    font-weight: 600;
  }

  .jelly__table :global(td:nth-child(2)) {
    color: var(--fg);
    font-weight: 600;
  }

  .jelly__table :global(td:nth-child(3)) {
    color: var(--fg-muted);
  }

  /* 第一名那行垫一层很淡的粉 */
  .jelly__table :global(tr:first-child td) {
    background: color-mix(in srgb, var(--icon-pink) 10%, transparent);
  }

  .jelly__empty {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    flex: 1;
    min-height: 0;
    max-height: 10rem;
    margin: auto 0;
    padding-block: 0.4rem;
    gap: 0.35rem;
    font-size: 0.75rem;
    text-align: center;
    color: var(--fg-faint);
  }

  .jelly__empty[hidden],
  .jelly__empty-art--night,
  :global(:root[data-theme='dark']) .jelly__empty-art--day {
    display: none;
  }

  .jelly__empty-art {
    width: min(100%, 8rem);
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  :global(:root[data-theme='dark']) .jelly__empty-art--night {
    display: block;
  }

  /* 画板：画布按逻辑宽高比装进来，居中 */
  .jelly__board {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    padding: 0.5rem;
  }

  .jelly__canvas {
    display: block;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .jelly__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
  }

  .jelly__overlay[hidden] {
    display: none;
  }

  .jelly__overlay-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .jelly__overlay-text {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }

  /* 确认框：小小一块，发丝线边框加粉色折角，说明一行、两个按钮并排居中 */
  .jelly-confirm {
    margin: auto;
    padding: 1.35rem 1.5rem 1.25rem;
    width: min(19rem, calc(100vw - 2rem));
    border: var(--hair) solid var(--line-strong);
    background: var(--bg);
    color: var(--fg);
    text-align: center;
  }

  .jelly-confirm::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2px solid var(--icon-pink);
    border-left: 2px solid var(--icon-pink);
  }

  .jelly-confirm::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
  }

  .jelly-confirm__text {
    margin: 0 0 1.1rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .jelly-confirm__actions {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .jelly-confirm__actions .jelly-btn {
    min-width: 5.5rem;
  }

  /* 窄屏：上下排，但尽量还是 PC 那套面板。
     上面一块面板（计分一行四格、合成进度、三个按钮），中间画板，下面一块记录面板；
     两块面板都和 PC 一样有折角、强调色短条和点阵底纹 */
  @media (max-width: 48rem) {
    .jelly-page {
      padding-block: 0.75rem 2.5rem;
    }

    .jelly-head {
      padding-bottom: 0.6rem;
      margin-bottom: 0.75rem;
    }

    .jelly-head__title {
      font-size: 1.3rem;
