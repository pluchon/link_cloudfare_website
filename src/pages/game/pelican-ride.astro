---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBackdrop from '../../components/PageBackdrop.astro';
import { pageBackdrops } from '../../config/site';
import { getGames } from '../../lib/content';

const PLAY = '/game/pelican-ride/';
const entry = (await getGames()).find((item) => item.data.play === PLAY);
const title = entry?.data.title ?? '鹈鹕骑车';
const summary = entry?.data.summary ?? '';
---

<BaseLayout title={title} description={summary}>
  <PageBackdrop art={pageBackdrops.game} />

  <section class="wrap pelican-page">
    <header class="pelican-head">
      <h1 class="pelican-head__title">{title}</h1>
      <a class="pelican-head__back" href="/game/"><span aria-hidden="true">←</span> 游戏大厅</a>
    </header>

    <div class="pelican" data-pelican data-state="ready" data-title={title}>
      <!-- 外框画成一台掌机（用户要求）：上沿是铭牌、出声孔和电源灯，下沿是十字键、按键说明和两颗圆键 -->
      <div class="pelican__top" aria-hidden="true">
        <span class="pelican__brand">NUONUO · PELICAN RIDE</span>
        <span class="pelican__vents"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        <span class="pelican__lamp"></span>
      </div>
      <div class="pelican__stage" data-stage>
        <canvas class="pelican__canvas" data-canvas aria-label="鹈鹕骑车游戏画面：左右压车，按住上方向键冲刺，按住空格猛冲"></canvas>
        <!-- 冲刺、猛冲、超级加速时盖在画面上的速度线，脚本每帧画 -->
        <canvas class="pelican__rush" data-rush aria-hidden="true"></canvas>

        <!-- 路程：贴着画面上沿的一根细线 -->
        <div class="pelican__progress" aria-hidden="true"><i data-progress></i></div>

        <div class="pelican__hud">
          <!-- 左上角的小格子：只放分数（小鱼和纪念品数用户说顶上不用放，生命挪到了左下角） -->
          <div class="pelican__cells">
            <p class="pelican__cell pelican__panel">
              <svg class="pelican__cell-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" /></svg>
              <span class="pelican__label">分数</span>
              <b data-score>0</b>
            </p>
          </div>
          <div class="pelican__tools">
            <button type="button" class="pelican-btn pelican-btn--icon pelican-btn--sound" data-mute aria-pressed="true" aria-label="声音开关">
              <svg class="pelican-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" />
                <path class="pelican-btn__wave" d="M15.5 9.5a3.5 3.5 0 0 1 0 5M18 7a7 7 0 0 1 0 10" />
                <path class="pelican-btn__mute" d="M16 9.5l5 5M21 9.5l-5 5" />
              </svg>
            </button>
            <button type="button" class="pelican-btn pelican-btn--icon" data-pause aria-pressed="false" aria-label="暂停或继续">
              <svg class="pelican-btn__icon pelican-btn__icon--on" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 6v12M15 6v12" />
              </svg>
              <svg class="pelican-btn__icon pelican-btn__icon--off" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5.5v13l10.5-6.5z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- 连续穿圈时顶上正中的「连续得分」 -->
        <p class="pelican__combo" data-combo aria-live="polite">
          <span class="pelican__combo-label">连续得分</span>
          <b data-combo-score>0</b>
          <em data-combo-mult>×1</em>
        </p>

        <!-- 进新场景时报一次站名，几秒后自己淡掉 -->
        <div class="pelican__toasts" data-toasts aria-live="polite"></div>

        <!-- 左下角两条线：冲刺还剩多少，现在骑多快。每条线分四格：i 是长度，三个 b 是刻度 -->
        <div class="pelican__meters pelican__panel" data-boost-box data-level="high" aria-hidden="true">
          <p class="pelican__panel-title">状态<small>STATUS</small></p>
          <div class="pelican__meter pelican__meter--boost">
            <svg class="pelican__meter-icon" viewBox="0 0 24 24"><path d="M13.5 2.5 5.5 13.5h5.5l-1 8 8.5-11.5h-5.5z" /></svg>
            <span class="pelican__label" data-boost-label>冲刺</span>
            <span class="pelican__meter-line">
              <i data-boost></i><b></b><b></b><b></b>
              <span class="pelican__flames" data-flames>
                {Array.from({ length: 14 }, () => <u />)}
              </span>
            </span>
            <em class="pelican__meter-num" data-boost-num></em>
          </div>
          <div class="pelican__meter pelican__meter--speed">
            <svg class="pelican__meter-icon" viewBox="0 0 24 24"><path d="M4 17a8.5 8.5 0 1 1 16 0M12 16l4.5-6" /></svg>
            <span class="pelican__label">速度</span>
            <span class="pelican__meter-line"><i data-speed></i><b></b><b></b><b></b></span>
            <em class="pelican__meter-num" data-speed-num>0</em>
          </div>
          <!-- 生命：四格对四颗心，每颗心掉得了半颗；右边是还剩百分之几 -->
          <div class="pelican__meter pelican__meter--life" data-life>
            <svg class="pelican__meter-icon" viewBox="0 0 24 24"><path d="M12 20.4C5.6 15.6 3 12.2 3 8.8A4.6 4.6 0 0 1 12 7.2a4.6 4.6 0 0 1 9 1.6c0 3.4-2.6 6.8-9 11.6z" /></svg>
            <span class="pelican__label">生命</span>
            <span class="pelican__meter-line"><i data-life-bar></i><b></b><b></b><b></b></span>
            <em class="pelican__meter-num" data-life-num>100%</em>
          </div>
        </div>

        <!-- 右下角：吃到的道具还剩多久，一条一条往回缩，最多三条（同时有更多时只放剩得最少的三个） -->
        <div class="pelican__timers pelican__panel" data-timers aria-hidden="true">
          <p class="pelican__panel-title">道具<small>ITEMS</small></p>
          <div class="pelican__meter pelican__timer" data-timer>
            <svg class="pelican__meter-icon" viewBox="0 0 24 24" data-timer-icon></svg>
            <span class="pelican__label" data-timer-name></span>
            <span class="pelican__meter-line"><i data-timer-bar></i><b></b><b></b><b></b></span>
            <em class="pelican__meter-num" data-timer-num></em>
          </div>
          <div class="pelican__meter pelican__timer" data-timer>
            <svg class="pelican__meter-icon" viewBox="0 0 24 24" data-timer-icon></svg>
            <span class="pelican__label" data-timer-name></span>
            <span class="pelican__meter-line"><i data-timer-bar></i><b></b><b></b><b></b></span>
            <em class="pelican__meter-num" data-timer-num></em>
          </div>
          <div class="pelican__meter pelican__timer" data-timer>
            <svg class="pelican__meter-icon" viewBox="0 0 24 24" data-timer-icon></svg>
            <span class="pelican__label" data-timer-name></span>
            <span class="pelican__meter-line"><i data-timer-bar></i><b></b><b></b><b></b></span>
            <em class="pelican__meter-num" data-timer-num></em>
          </div>
        </div>

        <!-- 只在触屏上出现：左边是摇杆（左右换道、往上推冲刺），右下角按住是加速（和电脑上的空格一样） -->
        <div class="pelican__stick" data-stick aria-hidden="true"><i class="pelican__knob" data-knob></i></div>
        <button type="button" class="pelican-btn pelican__boost" data-turbo>加速</button>

        <div class="pelican__overlay" data-overlay hidden>
          <div class="pelican__card pelican__panel">
            <p class="pelican__overlay-title" data-overlay-title></p>
            <!-- 出发前选角色，按钮由脚本按 rider.ts 的 CHARACTERS 生成 -->
            <div class="pelican__picks" data-picks role="group" aria-label="选角色"></div>
            <dl class="pelican__stats" data-overlay-stats hidden>
              <div>
                <dt>分数</dt>
                <dd data-stat-score>0</dd>
              </div>
              <div>
                <dt>用时</dt>
                <dd data-stat-time>00:00</dd>
              </div>
            </dl>
            <p class="pelican__overlay-text" data-overlay-text></p>
            <button type="button" class="pelican-btn pelican-btn--main" data-overlay-btn></button>
          </div>
        </div>

        <p class="pelican__nogl" data-nogl hidden>这台设备的浏览器不支持 WebGL2，暂时玩不了这个游戏。</p>
      </div>

      <!-- 画面下面一行：左边是成绩，右边是按键说明 -->
      <div class="pelican__foot">
        <svg class="pelican__dpad" viewBox="0 0 44 44" aria-hidden="true">
          <rect class="pelican__key pelican__key--l" x="4" y="16" width="12" height="12" />
          <rect class="pelican__key pelican__key--r" x="28" y="16" width="12" height="12" />
          <rect class="pelican__key pelican__key--u" x="16" y="4" width="12" height="12" />
          <path d="M16 4h12v12h12v12H28v12H16V28H4V16h12z" />
          <path d="M22 8.5v3M8.5 22h3M32.5 22h3M22 32.5v3" />
        </svg>
        <p class="pelican__record" data-record aria-live="polite"></p>
        <p class="pelican__keys">
          <span><kbd>←</kbd><kbd>→</kbd> 压车</span>
          <span><kbd>↑</kbd> 冲刺</span>
          <span><kbd>空格</kbd> 猛冲</span>
          <span><kbd>P</kbd> 暂停</span>
          <span><kbd>M</kbd> 静音</span>
        </p>
        <svg class="pelican__ab" viewBox="0 0 50 44" aria-hidden="true">
          <circle class="pelican__key pelican__key--u" cx="13" cy="29" r="9.5" />
          <circle class="pelican__key pelican__key--a" cx="37" cy="15" r="9.5" />
          <text x="13" y="32">B</text>
          <text x="37" y="18">A</text>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountPelican, supportsWebGL2 } from '../../game/pelican/game';

  let destroy: (() => void) | null = null;

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-pelican]');
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = '1';
    if (!supportsWebGL2()) {
      root.querySelector<HTMLElement>('[data-nogl]')!.hidden = false;
      root.dataset.state = 'nogl';
      return;
    }
    destroy = mountPelican(root);
  }

  // 这段脚本可能在第一次 astro:page-load 之后才执行，所以先跑一次
  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    destroy?.();
    destroy = null;
  });
</script>

<style>
  .pelican-page {
    position: relative;
    z-index: 1;
    padding-block: 1rem 1.25rem;
  }

  .pelican-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    margin-bottom: 1rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .pelican-head__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .pelican-head__back {
    padding: 0.3rem 0.7rem;
    border: var(--hair) solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .pelican-head__back:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pelican-head__back span {
    display: inline-block;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .pelican-head__back:hover span {
    transform: translateX(-3px);
  }

  /* 画面里的面板和按钮跟着场景换颜色（用户要求）：底色取这个场景地平线的颜色，字按底色深浅取黑或白，
     强调色取这个场景路沿的颜色。三个值由脚本在进新场景时写到 .pelican 上，没写之前先用站点自己的颜色 */
  .pelican {
    padding: 0.55rem 0.8rem 0.6rem;
    border: var(--hair) solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    --hud-paper: var(--bg);
    --hud-ink: var(--fg);
    --hud-accent: var(--accent);
    --hud-line: color-mix(in srgb, var(--hud-ink) 32%, transparent);
    --hud-soft: color-mix(in srgb, var(--hud-ink) 66%, transparent);
  }

  .pelican__panel,
  .pelican__stage .pelican-btn {
    border: var(--hair) solid var(--hud-line);
    background: color-mix(in srgb, var(--hud-paper) 80%, transparent);
    color: var(--hud-ink);
    transition:
      background-color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out);
  }

  /* 掌机上沿：铭牌、一排出声孔、电源灯（骑着的时候亮） */
  .pelican__top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .pelican__brand {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .pelican__vents {
    display: flex;
    gap: 3px;
  }

  .pelican__vents i {
    width: var(--hair);
    height: 0.6rem;
    background: var(--line-strong);
    transform: skewX(-18deg);
  }

  .pelican__lamp {
    width: 0.4rem;
    height: 0.4rem;
    border: var(--hair) solid var(--line-strong);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .pelican[data-state="playing"] .pelican__lamp {
    border-color: var(--accent);
    background: var(--accent);
  }

  /* 十字键和圆键：只是线条，按下对应的键时那一格填上强调色 */
  .pelican__dpad,
  .pelican__ab {
    flex: none;
    height: 2.6rem;
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .pelican__ab text {
    fill: var(--fg-faint);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 8px;
    text-anchor: middle;
  }

  .pelican__key {
    stroke: none;
    fill: transparent;
    transition: fill var(--dur-1) var(--ease-out);
  }

  .pelican__ab .pelican__key {
    stroke: var(--line-strong);
  }

  .pelican[data-press~="l"] .pelican__key--l,
  .pelican[data-press~="r"] .pelican__key--r,
  .pelican[data-press~="u"] .pelican__key--u,
  .pelican[data-press~="a"] .pelican__key--a {
    fill: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  /* 画面占满一整块，界面只在四个角各放一样东西 */
  .pelican__stage {
    position: relative;
    /* 顶栏、标题行、掌机外框的上下两沿和留白加起来约 18.5rem，剩下的都给画面 */
    /* 用 svh 不用 dvh：手机滑动时地址栏收起、展开，dvh 跟着变，画面会被一下一下地缩放 */
    height: clamp(20rem, calc(100svh - 18.5rem), 46rem);
    border: var(--hair) solid var(--line-strong);
    background: var(--bg-sunken);
    overflow: hidden;
    /* 按住画面压车时不让浏览器当成滚动或缩放手势 */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .pelican__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pelican__rush {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pelican__progress {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: color-mix(in srgb, var(--hud-ink) 14%, transparent);
  }

  .pelican__progress i,
  .pelican__meter-line i {
    display: block;
    height: 100%;
    background: var(--hud-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: background-color var(--dur-3) var(--ease-out);
  }

  .pelican__hud {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1rem 1.1rem;
    pointer-events: none;
  }

  .pelican__hud > * {
    pointer-events: auto;
  }

  .pelican__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--hud-soft);
    transition: color var(--dur-3) var(--ease-out);
  }

  /* 左上角一排小格子，格子之间留一点空，每格是图标、名字、数字 */
  .pelican__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pelican__cell {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.35rem 0.6rem;
  }

  .pelican__cell-icon {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--hud-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke var(--dur-3) var(--ease-out);
  }

  .pelican__cell b {
    min-width: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .pelican__cell b small {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--hud-soft);
  }

  .pelican__meters {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    pointer-events: none;
  }

  /* 一行：图标、名字、线、数字，两行的每一列对齐 */
  .pelican__meter {
    display: grid;
    grid-template-columns: 0.85rem auto clamp(5.5rem, 17vw, 9.5rem) 1.5rem;
    align-items: center;
    gap: 0.55rem;
  }

  /* 冲刺条的颜色跟着余量走：多是青绿，不多是琥珀，快没了是红。速度条用场景的强调色 */
  .pelican__meter--boost {
    --meter: #3fae9c;
  }

  .pelican__meters[data-level="mid"] .pelican__meter--boost {
    --meter: #e0a02a;
  }

  .pelican__meters[data-level="low"] .pelican__meter--boost {
    --meter: #e0563e;
  }

  .pelican__meter--speed {
    --meter: var(--hud-accent);
  }

  .pelican__meter-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: var(--meter);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      fill var(--dur-2) var(--ease-out),
      stroke var(--dur-2) var(--ease-out);
  }

  .pelican__meter-line {
    position: relative;
    display: block;
    height: 5px;
    background: color-mix(in srgb, var(--hud-ink) 16%, transparent);
  }

  .pelican__meter-line i {
    background: var(--meter);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  /* 两头各一道竖线收口，中间三道刻度把线分成四格 */
  .pelican__meter-line::before,
  .pelican__meter-line::after {
    content: "";
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: var(--hair);
    background: var(--hud-line);
  }

  .pelican__meter-line::before {
    left: -2px;
  }

  .pelican__meter-line::after {
    right: -2px;
  }

  .pelican__meter-line b {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: color-mix(in srgb, var(--hud-paper) 82%, transparent);
  }

  .pelican__meter-line b:nth-of-type(1) {
    left: 25%;
  }

  .pelican__meter-line b:nth-of-type(2) {
    left: 50%;
  }

  .pelican__meter-line b:nth-of-type(3) {
    left: 75%;
  }

  .pelican__meter-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-style: normal;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--hud-soft);
  }

  /* 猛冲时整条烧成橙红 */
  .pelican__meters[data-burn="2"] .pelican__meter--boost {
    --meter: #f0642e;
  }

  /* 生命：多是绿，不多是琥珀，快没了是红；掉血那一下整行的字和线换成红色 */
  .pelican__meter--life {
    --meter: #55b86a;
  }

  .pelican__meters[data-life="mid"] .pelican__meter--life {
    --meter: #e0a02a;
  }

  .pelican__meters[data-life="low"] .pelican__meter--life {
    --meter: #e0563e;
  }

  .pelican__meters[data-hurt] .pelican__meter--life .pelican__label,
  .pelican__meters[data-hurt] .pelican__meter--life .pelican__meter-num {
    color: #e0563e;
  }

  .pelican__meters[data-hurt] .pelican__meter--life .pelican__meter-icon {
    fill: #e0563e;
  }

  /* 右下角的道具计时：和左下角同一种线；每条用道具自己的颜色，剩一半以下变琥珀，剩四分之一以下变红 */
  /* 右下角道具计时的进出场（用户要「向左弹入、向右弹出」）：整块面板没有道具时缩在画面右边外面，有了就弹进来；
     每一条也一样，开始时从右边弹进来、到时间往右弹出去，同时把高度收起来，下面的往上补。弹的那一下用越过头再回来的缓动 */
  .pelican__timers {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: grid;
    gap: 0;
    padding: 0.5rem 0.7rem;
    pointer-events: none;
    opacity: 0;
    transform: translateX(calc(100% + 2rem));
    transition:
      transform var(--dur-3) cubic-bezier(0.34, 1.45, 0.64, 1),
      opacity var(--dur-2) var(--ease-out);
  }

  .pelican__timers[data-on] {
    opacity: 1;
    transform: none;
  }

  .pelican__timer {
    grid-template-columns: 0.85rem 2.6rem clamp(4.5rem, 12vw, 7rem) 1.9rem;
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    transform: translateX(120%);
    transition:
      transform var(--dur-3) cubic-bezier(0.34, 1.45, 0.64, 1),
      opacity var(--dur-2) var(--ease-out),
      max-height var(--dur-2) var(--ease-out),
      margin-top var(--dur-2) var(--ease-out);
  }

  .pelican__timer[data-on] {
    max-height: 1.6rem;
    margin-top: 0.4rem;
    opacity: 1;
    transform: none;
  }

  .pelican__timer[data-left="mid"] {
    --meter: #e0a02a !important;
  }

  .pelican__timer[data-left="low"] {
    --meter: #e0563e !important;
  }

  .pelican__timer .pelican__meter-icon {
    fill: none;
  }

  /* 连续穿圈：画面顶上正中一块「连续得分」，每穿一个圈弹一下、抖一下，大小和位置由脚本每帧给 */
  .pelican__combo {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    padding: 0.3rem 0.9rem 0.4rem;
    border-bottom: 2px solid var(--hud-accent);
    color: var(--hud-ink);
    background: color-mix(in srgb, var(--hud-paper) 80%, transparent);
    pointer-events: none;
    transform: translateX(-50%);
    transform-origin: center top;
    opacity: 0;
  }

  .pelican__combo-label {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }

  .pelican__combo b {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--hud-accent);
  }

  .pelican__combo em {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 600;
    color: #e0563e;
  }

  /* 吃了火箭（超级加速）：整条变成青色、按剩下的时间往回缩，火苗也是青白色的 */
  .pelican__meters[data-burn="4"] .pelican__meter--boost {
    --meter: #3fc8f0;
  }

  .pelican__meters[data-burn="4"] .pelican__flames u {
    background: #7fe2ff;
  }

  .pelican__meters[data-burn="4"] .pelican__flames u:nth-child(3n + 1) {
    background: #3fb0f0;
  }

  .pelican__meters[data-burn="4"] .pelican__flames u:nth-child(3n + 2) {
    background: #eafcff;
  }

  /* 速度超过猛冲那一档时，速度条也跟着变青 */
  .pelican__meters[data-burn="4"] .pelican__meter--speed {
    --meter: #3fc8f0;
  }

  /* 吃了辣椒：冲刺条不掉，整条是金色的 */
  .pelican__meters[data-burn="3"] .pelican__meter--boost {
    --meter: #f6c12e;
  }

  /* 冲刺时烧在冲刺条上的一排火苗：每根是一个三角，高矮由脚本每帧给 */
  .pelican__flames {
    position: absolute;
    left: 0;
    bottom: 100%;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 13px;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .pelican__meters[data-burn] .pelican__flames {
    opacity: 1;
  }

  .pelican__flames u {
    flex: 1 1 0;
    height: 100%;
    margin-inline: -1px;
    background: #f2a23a;
    clip-path: polygon(0 100%, 55% 0, 100% 100%);
    transform: scaleY(0);
    transform-origin: center bottom;
  }

  .pelican__flames u:nth-child(3n + 1) {
    background: #e0563e;
  }

  .pelican__flames u:nth-child(3n + 2) {
    background: #f6cf5a;
    clip-path: polygon(0 100%, 40% 20%, 100% 100%);
  }

  /* 正在冲刺：闪电填满，「冲刺」两个字也换成冲刺条的颜色 */
  .pelican__meters[data-active] .pelican__meter--boost .pelican__label {
    color: var(--meter);
  }

  .pelican__meters[data-active] .pelican__meter--boost .pelican__meter-icon {
    fill: var(--meter);
  }

  /* ---- 画面上的几块面板和按钮（2026-11-13 用户要「左右两块面板颜色样式不一样、分数和静音暂停也设计一下，半透明，加点装饰」）----
     左下「状态」：深色的毛玻璃，浅色的字，左边一道场景强调色的竖条，右上角一个折角；
     右下「道具」：浅色的毛玻璃，右边一道琥珀色的竖条，左下角一个折角；
     分数和两个小按钮：半透明的毛玻璃，左上角一个小折角。都还是发丝线，不加阴影 */
  .pelican__meters,
  .pelican__timers {
    -webkit-backdrop-filter: blur(7px) saturate(1.2);
    backdrop-filter: blur(7px) saturate(1.2);
  }

  .pelican__meters {
    padding: 0.45rem 0.75rem 0.55rem 1rem;
    border-color: color-mix(in srgb, #ffffff 24%, transparent);
    background: color-mix(in srgb, #0f1720 58%, transparent);
    color: #f2f4f6;
  }

  .pelican__meters .pelican__label {
    color: color-mix(in srgb, #f2f4f6 74%, transparent);
  }

  .pelican__meters .pelican__meter-num {
    color: color-mix(in srgb, #f2f4f6 88%, transparent);
  }

  .pelican__meters .pelican__meter-line {
    background: color-mix(in srgb, #ffffff 15%, transparent);
  }

  .pelican__meters .pelican__meter-line b {
    background: color-mix(in srgb, #0f1720 85%, transparent);
  }

  .pelican__meters .pelican__meter-line::before,
  .pelican__meters .pelican__meter-line::after {
    background: color-mix(in srgb, #ffffff 34%, transparent);
  }

  .pelican__meters::before,
  .pelican__timers::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 3px;
  }

  .pelican__meters::before {
    left: 0;
    background: var(--hud-accent);
  }

  .pelican__meters::after,
  .pelican__timers::after,
  .pelican__cell::after,
  .pelican__tools .pelican-btn::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    pointer-events: none;
  }

  .pelican__meters::after {
    top: -1px;
    right: -1px;
    border-top: 2px solid var(--hud-accent);
    border-right: 2px solid var(--hud-accent);
  }

  .pelican__timers {
    padding: 0.45rem 1rem 0.55rem 0.75rem;
    border-color: color-mix(in srgb, var(--hud-ink) 26%, transparent);
    background: color-mix(in srgb, var(--hud-paper) 46%, transparent);
  }

  .pelican__timers::before {
    right: 0;
    background: #f2b93a;
  }

  .pelican__timers::after {
    bottom: -1px;
    left: -1px;
    border-bottom: 2px solid #f2b93a;
    border-left: 2px solid #f2b93a;
  }

  /* 两块面板顶上一行小标题：中文加一行等宽的英文，下面一道发丝线 */
  .pelican__panel-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.1rem;
    padding-bottom: 0.25rem;
    border-bottom: var(--hair) solid color-mix(in srgb, currentColor 22%, transparent);
    font-family: var(--font-serif);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .pelican__panel-title small {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    opacity: 0.6;
  }

  .pelican__timers .pelican__panel-title {
    color: var(--hud-ink);
  }

  /* 分数：半透明的毛玻璃，底边一道强调色，左上角一个小折角，数字用强调色 */
  .pelican__cell {
    position: relative;
    border-color: color-mix(in srgb, var(--hud-ink) 24%, transparent);
    border-bottom: 2px solid var(--hud-accent);
    background: color-mix(in srgb, var(--hud-paper) 42%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .pelican__cell b {
    color: var(--hud-accent);
    font-size: 1.05rem;
  }

  .pelican__cell::after {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--hud-accent);
    border-left: 2px solid var(--hud-accent);
  }

  /* 右上角的静音和暂停：深色半透明的小方块，白色图标，左上角一个折角；指上去时边框和折角换成强调色 */
  .pelican__tools .pelican-btn {
    position: relative;
    border-color: color-mix(in srgb, #ffffff 30%, transparent);
    background: color-mix(in srgb, #0f1720 40%, transparent);
    color: #f6f7f8;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .pelican__tools .pelican-btn::after {
    top: -1px;
    left: -1px;
    border-top: 2px solid color-mix(in srgb, #ffffff 70%, transparent);
    border-left: 2px solid color-mix(in srgb, #ffffff 70%, transparent);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .pelican__tools .pelican-btn:hover::after,
  .pelican__tools .pelican-btn:focus-visible::after {
    border-color: var(--hud-accent);
  }

  /* 顶上的提示也半透明一点 */
  .pelican__toast {
    background: color-mix(in srgb, var(--hud-paper) 70%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .pelican-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.42rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    cursor: pointer;
  }

  .pelican__stage .pelican-btn:hover,
  .pelican__stage .pelican-btn:focus-visible {
    border-color: var(--hud-accent);
    color: var(--hud-accent);
  }

  .pelican-btn:active {
    transform: translateY(1px);
  }

  .pelican-btn:disabled {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }

  .pelican-btn[hidden] {
    display: none;
  }

  .pelican-btn--icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
  }

  .pelican-btn__icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 暂停键：进行中显示两竖，暂停时换成三角 */
  .pelican-btn[aria-pressed="true"] .pelican-btn__icon--on,
  .pelican-btn[aria-pressed="false"] .pelican-btn__icon--off {
    display: none;
  }

  /* 声音键：开着画声波，关了画叉。这颗按钮的 aria-pressed 表示「声音开着」 */
  .pelican-btn--sound[aria-pressed="true"] .pelican-btn__mute,
  .pelican-btn--sound[aria-pressed="false"] .pelican-btn__wave {
    display: none;
  }

  .pelican__tools {
    display: flex;
    gap: 0.5rem;
  }

  .pelican-btn--main {
    padding: 0.6rem 1.9rem;
    font-size: 0.8125rem;
  }

  /* 触屏上的冲刺和猛冲：右下角两个方块，鼠标设备上不出现 */
  /* 手机上的摇杆（用户要的）：左半边任何地方按下去，摇杆就出现在手指下面；平时停在左下角冲刺条上面。
     往左右推是换道（推得越多压得越狠），往上推是冲刺。圆的底盘和圆的摇头，都是发丝线 */
  .pelican__stick {
    position: absolute;
    left: var(--stick-x, 4.2rem);
    top: var(--stick-y, calc(100% - 11.6rem));
    display: none;
    width: 6.4rem;
    height: 6.4rem;
    margin: -3.2rem 0 0 -3.2rem;
    border: var(--hair) solid var(--hud-line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--hud-paper) 34%, transparent);
    pointer-events: none;
    opacity: 0.55;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .pelican__stick[data-held] {
    opacity: 1;
  }

  /* 往上推到冲刺的那一截，底盘上沿画一道强调色的弧 */
  .pelican__stick::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 2px solid transparent;
    border-top-color: var(--hud-accent);
    border-radius: 50%;
    opacity: 0.35;
  }

  .pelican__stick[data-dash]::before {
    opacity: 1;
  }

  .pelican__knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.6rem;
    height: 2.6rem;
    margin: -1.3rem 0 0 -1.3rem;
    border: var(--hair) solid var(--hud-ink);
    border-radius: 50%;
    background: color-mix(in srgb, var(--hud-paper) 80%, transparent);
  }

  /* 右下角一颗大圆键：按住就是猛冲，和电脑上按住空格一样 */
  .pelican__boost {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: none;
    width: 4.8rem;
    height: 4.8rem;
    padding: 0;
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    touch-action: none;
  }

  .pelican__boost[data-held] {
    border-color: var(--hud-accent);
    color: var(--hud-accent);
  }

  @media (hover: none) and (pointer: coarse) {
    .pelican[data-state="playing"] .pelican__stick,
    .pelican[data-state="playing"] .pelican__boost {
      display: block;
    }

    /* 右下角让给加速键；下面左边是状态，道具计时挪到右上角两个小按钮下面，不和状态叠在一起 */
    .pelican__timers {
      top: 3.6rem;
      bottom: auto;
    }

    .pelican__keys,
    .pelican__dpad,
    .pelican__ab {
      display: none;
    }
  }

  /* 面板这一层本身不接点击：暂停时点画面任何空白处都能继续，四角的按钮也照常能点 */
  .pelican__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    pointer-events: none;
  }

  .pelican__overlay[hidden] {
    display: none;
  }

  /* 出发前标题放在画面下方，把中间让给鹈鹕；暂停和结算都在正中 */
  .pelican[data-state="ready"] .pelican__overlay {
    align-items: flex-end;
    padding-bottom: clamp(1.25rem, 5vh, 2.5rem);
  }

  /* 面板弹出来：从下面一点、小一点的地方浮上来，顶上一道强调色的线从左画到右 */
  .pelican__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: 100%;
    padding: 1.3rem 2.4rem 1.4rem;
    background: color-mix(in srgb, var(--hud-paper) 88%, transparent);
    text-align: center;
    pointer-events: auto;
    opacity: 0;
    transform: translateY(0.9rem) scale(0.97);
    transition:
      opacity var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-out),
      background-color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out);
  }

  .pelican__card::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto;
    height: 2px;
    background: var(--hud-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-3) var(--ease-out) var(--dur-2);
  }

  .pelican__overlay[data-open] .pelican__card {
    opacity: 1;
    transform: none;
  }

  .pelican__overlay[data-open] .pelican__card::before {
    transform: scaleX(1);
  }

  /* 暂停时面板上没有按钮，整块都不挡点击 */
  .pelican[data-state="paused"] .pelican__card {
    pointer-events: none;
  }

  /* 出发前没有面板（用户要求）：标题和提示直接写在画面上，字外面描一圈底色，压在什么景色上都看得清 */
  .pelican[data-state="ready"] .pelican__card {
    padding: 0;
    border-color: transparent;
    background: transparent;
    pointer-events: none;
  }

  .pelican[data-state="ready"] .pelican__card::before {
    display: none;
  }

  /* 出发前画面上只留标题、提示和右上角的声音键，分数和两条线等骑起来再出现 */
  .pelican[data-state="ready"] .pelican__cells,
  .pelican[data-state="ready"] .pelican__meters {
    visibility: hidden;
  }

  .pelican[data-state="ready"] .pelican__overlay-title,
  .pelican[data-state="ready"] .pelican__overlay-text {
    -webkit-text-stroke: 0.14em var(--hud-paper);
    paint-order: stroke fill;
  }

  .pelican[data-state="ready"] .pelican__overlay-title {
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    letter-spacing: 0.2em;
  }

  /* 小字不描边：字太细，描边会把笔画吃掉。改成垫一圈底色的晕 */
  .pelican[data-state="ready"] .pelican__overlay-text {
    -webkit-text-stroke-width: 0;
    text-shadow:
      0 0 2px var(--hud-paper),
      0 0 4px var(--hud-paper),
      0 0 8px var(--hud-paper);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--hud-ink);
  }

  /* 结算是一块横着的长方形：左边标题，中间两格成绩，右边按钮 */
  .pelican[data-state="finished"] .pelican__card {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem 2.4rem;
    padding: 1.7rem 2.6rem;
  }

  /* 出发前选角色：标题下面一排小卡片（用户要「装饰一下」）。每张卡片上面一排这个角色身上的几种颜色、下面名字；
     半透明的毛玻璃（用户说下面那行英文不要），选中的那张往上浮一点，边框、名字换成强调色，底边一道强调色的线，左上角一个折角。只在出发前出现 */
  .pelican__picks {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    max-width: 34rem;
    padding-top: 0.2rem;
  }

  .pelican[data-state="ready"] .pelican__picks {
    display: flex;
  }

  .pelican__stage .pelican__pick {
    position: relative;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 4.9rem;
    padding: 0.5rem 0.7rem 0.42rem;
