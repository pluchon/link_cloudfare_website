---
import '../../styles/prose.css';
import '../../styles/notice.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBackdrop from '../../components/PageBackdrop.astro';
import PixelBackdrop from '../../components/PixelBackdrop.astro';
import KindIcon from '../../components/KindIcon.astro';
import TargetCursor from '../../components/TargetCursor.astro';
import { gameAlbums, games as fallbackGames, jelly2048Art, pageBackdrops, site } from '../../config/site';
import { getGames } from '../../lib/content';
import { resolveEmbeds } from '../../lib/embeds';

const collectionGames = await getGames();

const items =
  collectionGames.length > 0
    ? await Promise.all(
        collectionGames.map(async (entry, idx) => {
          const href = entry.data.play ?? '';
          const album = gameAlbums[href] ?? [];
          return {
            id: String(idx + 1).padStart(2, '0'),
            slug: entry.data.slug,
            title: entry.data.title,
            summary: entry.data.summary,
            tag: entry.data.tags.slice(0, 2).join(' / ') || '小游戏',
            cover: href === jelly2048Art.play ? jelly2048Art.cover.light : entry.data.cover ?? '',
            coverDark: href === jelly2048Art.play ? jelly2048Art.cover.dark : '',
            href,
            rulesHtml: entry.body?.trim()
              ? await resolveEmbeds(entry.rendered?.html ?? '')
              : '',
            album,
          };
        }),
      )
    : fallbackGames.map((item) => ({
        ...item,
        slug: item.id,
        coverDark: '',
        rulesHtml: '',
        album: gameAlbums[item.href] ?? [],
      }));
---

<BaseLayout title="游戏" description={site.gameLine}>
  <PageBackdrop art={pageBackdrops.game} />
  <PixelBackdrop />
  <!-- 和首页导图同一套瞄准光标，只在正文里接管（和首页只管画布一样，顶栏、页脚是普通鼠标）：瞄准游戏卡片、规则按钮与画册按钮。具体游戏页不用 -->
  <TargetCursor area="main" targets=".game-card, .game-card__rules-btn, .game-card__album-btn" />

  <section class="wrap game-head">
    <div class="game-head__row" data-reveal>
      <h1 class="game-head__title">
        <KindIcon name="game" class="game-head__icon" />
        游戏
      </h1>
      <p class="game-head__desc">{site.gameLine}</p>
    </div>
  </section>

  <div class="wrap">
    <div class="rule-tab" aria-hidden="true"></div>
  </div>

  <section class="wrap game-body" aria-label="游戏列表">
    <ol class="game-grid">
      {
        items.map((item, i) => {
          const ready = Boolean(item.href);
          const hasRules = Boolean(item.rulesHtml);
          const hasAlbum = item.album.length > 0;
          const albumReadyCount = item.album.filter((shot) => Boolean(shot.src)).length;
          // 最新上架、能玩的那一款挂一枚「正热乎」小印章
          const hot = ready && i === items.length - 1;
          return (
            <li data-reveal style={`--reveal-i: ${Math.min(i + 1, 7)}`}>
              <article class:list={['game-card', !ready && 'game-card--coming']}>
                <header class="game-card__bar">
                  <span class="game-card__no">GAME {item.id}</span>
                  <span class="game-card__tag">{item.tag}</span>
                </header>

                <div class="game-card__cover-wrap">
                  {item.cover ? (
                    <>
                      <img class:list={['game-card__cover', { 'game-card__cover--day': item.coverDark }]} src={item.cover} alt="" loading="lazy" />
                      {item.coverDark && <img class="game-card__cover game-card__cover--night" src={item.coverDark} alt="" loading="lazy" />}
                    </>
                  ) : (
                    <div class="game-card__cover cover-ph">
                      <svg class="game-card__motif" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                        <rect x="14" y="8" width="36" height="24" rx="2" />
                        <path d="M22 20h6M25 17v6" />
                        <circle class="game-card__motif-dot" cx="40" cy="18" r="2" />
                        <circle cx="36" cy="22" r="1.5" />
                      </svg>
                      <span>封面待补</span>
                    </div>
                  )}
                </div>

                <div class:list={['game-card__body', { 'game-card__body--hot': hot }]}>
                  <h2 class="game-card__title">{item.title}</h2>
                  <p class="game-card__summary">{item.summary}</p>
                  {hot && (
                    <span class="game-card__hot" aria-label="热门">
                      <KindIcon name="hot" class="game-card__hot-icon" />
                      <span class="game-card__hot-text">
                        <span class="game-card__hot-en">HOT</span>
                        <span class="game-card__hot-zh">正热乎</span>
                      </span>
                    </span>
                  )}
                </div>

                <footer class="game-card__foot">
                  {(hasRules || hasAlbum) ? (
                    <div class="game-card__actions">
                      {hasRules && (
                        <button
                          type="button"
                          class="game-card__rules-btn"
                          data-open-rules={`game-rules-${item.slug}`}
                        >
                          <svg class="game-card__rules-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3.5 5.5c2.8-1 5.6-.8 8.5.8v13c-2.9-1.6-5.7-1.8-8.5-.8z" />
                            <path d="M20.5 5.5c-2.8-1-5.6-.8-8.5.8v13c2.9-1.6 5.7-1.8 8.5-.8z" />
                            <path class="game-card__rules-mark" d="M15.5 5.6v5.2l1.4-1 1.4 1V5.4" />
                          </svg>
                          游戏规则
                        </button>
                      )}
                      {hasAlbum && (
                        <button
                          type="button"
                          class="game-card__album-btn"
                          data-open-album={`game-album-${item.slug}`}
                        >
                          <svg class="game-card__album-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3.5" y="5" width="17" height="14" />
                            <path d="M4.5 16.2l4.4-4.2 3.3 3 3-3.5 4.3 4.7" />
                            <circle class="game-card__album-dot" cx="8.6" cy="9.4" r="1.2" />
                          </svg>
                          游戏画册
                        </button>
                      )}
                    </div>
                  ) : (
                    <span />
                  )}
                  <span class="game-card__go">
                    <svg class="game-card__paw" viewBox="0 0 24 24" aria-hidden="true">
                      <ellipse cx="12" cy="16" rx="5" ry="4.2" />
                      <ellipse cx="5.2" cy="11" rx="2" ry="2.6" />
                      <ellipse cx="9.6" cy="6.8" rx="2" ry="2.7" />
                      <ellipse cx="14.4" cy="6.8" rx="2" ry="2.7" />
                      <ellipse cx="18.8" cy="11" rx="2" ry="2.6" />
                    </svg>
                    <span class="game-card__state">{ready ? '开始游戏' : '制作中'}</span>
                    <span class="game-card__action" aria-hidden="true">
                      {ready ? '→' : '—'}
                    </span>
                  </span>
                </footer>

                {ready && <a class="game-card__hit" href={item.href} aria-label={item.title} />}
              </article>

              {hasRules && (
                <dialog class="game-rules-modal" id={`game-rules-${item.slug}`} aria-label={`${item.title} 游戏规则`}>
                  <div class="game-rules-modal__panel">
                    <header class="game-rules-modal__head">
                      <h3 class="game-rules-modal__title">{item.title}</h3>
                      <button type="button" class="game-rules-modal__close" data-close-rules aria-label="关闭规则">
                        ×
                      </button>
                    </header>
                    <div class="prose notice__prose game-rules-modal__body" set:html={item.rulesHtml} />
                  </div>
                </dialog>
              )}

              {hasAlbum && (
                <dialog class="game-album-modal" id={`game-album-${item.slug}`} aria-label={`${item.title} 游戏画册`}>
                  <div class="game-album-modal__panel" data-album-panel data-view="grid">
                    <header class="game-album-modal__head">
                      <div class="game-album-modal__head-meta">
                        <span class="game-album-modal__kicker">
                          GAME ALBUM · {String(albumReadyCount).padStart(2, '0')} / {String(item.album.length).padStart(2, '0')}
                        </span>
                        <h3 class="game-album-modal__title">{item.title} · 游戏画册</h3>
                      </div>
                      <div class="game-album-modal__head-tools">
                        <button type="button" class="game-album__back-btn" data-album-back hidden>
                          ← 返回画册
                        </button>
                        <button type="button" class="game-album-modal__close" data-close-album aria-label="关闭画册">
                          ×
                        </button>
                      </div>
                    </header>

                    <div class="game-album-modal__body">
                      <ol class="game-album__grid" data-album-grid>
                        {item.album.map((shot, shotIdx) => {
                          const hasSrc = Boolean(shot.src);
                          return (
                            <li
                              class:list={[
                                'game-album-card',
                                shotIdx < 2 ? 'game-album-card--wide' : 'game-album-card--std',
                                !hasSrc && 'game-album-card--empty',
                              ]}
                            >
                              <header class="game-album-card__bar">
                                <span class="game-album-card__no">FRAME {shot.id}</span>
                                <span class="game-album-card__kind">{shot.kind}</span>
                              </header>

                              {hasSrc ? (
                                <button
                                  type="button"
                                  class="game-album-card__stage"
                                  data-album-open={shotIdx}
                                  data-album-src={shot.src}
                                  data-album-title={shot.title}
                                  data-album-caption={shot.caption}
                                  data-album-kind={shot.kind}
                                  data-album-no={shot.id}
                                  aria-label={`查看大图：${shot.title}`}
                                >
                                  <img
                                    class="game-album-card__img"
                                    src={shot.src}
                                    alt={`${item.title} — ${shot.title}`}
                                    loading="lazy"
                                  />
                                  <span class="game-album-card__zoom" aria-hidden="true">查看大图 ↗</span>
                                </button>
                              ) : (
                                <div class="game-album-card__stage game-album-card__stage--ph cover-ph">
                                  <svg class="game-album-card__ph-svg" viewBox="0 0 72 46" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                                    <rect x="8" y="6" width="56" height="34" />
                                    <path d="M12 34l13-12 9 8.5 9.5-10.5L60 34" />
                                    <circle class="game-album-card__ph-dot" cx="22" cy="15" r="2.2" />
                                  </svg>
                                  <span class="game-album-card__ph-label">插画绘制中 · 待上传 OSS</span>
                                </div>
                              )}

                              <div class="game-album-card__meta">
                                <h4 class="game-album-card__title">{shot.title}</h4>
                                <p class="game-album-card__caption">{shot.caption}</p>
                              </div>
                            </li>
                          );
                        })}
                      </ol>

                      <div class="game-album__viewer" data-album-viewer hidden>
                        <figure class="game-album__stage">
                          <img class="game-album__full" data-album-full src="" alt="" />
                        </figure>
                        <div class="game-album__viewer-foot">
                          <div class="game-album__viewer-copy">
                            <span class="game-album__viewer-meta" data-album-meta />
                            <h4 class="game-album__viewer-title" data-album-vtitle />
                            <p class="game-album__viewer-caption" data-album-vcaption />
                          </div>
                          <div class="game-album__viewer-nav">
                            <button type="button" class="game-album__nav-btn" data-album-prev aria-label="上一张">
                              ← 上一张
                            </button>
                            <button type="button" class="game-album__nav-btn" data-album-next aria-label="下一张">
                              下一张 →
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </dialog>
              )}
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<script>
  function wireGameModals() {
    document.querySelectorAll<HTMLButtonElement>('[data-open-rules], [data-open-album]').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.openRules || btn.dataset.openAlbum;
        const dialog = id ? (document.getElementById(id) as HTMLDialogElement | null) : null;
        if (!dialog) return;
        const resetAlbum = (dialog as HTMLDialogElement & { __resetAlbum?: () => void }).__resetAlbum;
        resetAlbum?.();
        dialog.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.game-rules-modal').forEach((dialog) => {
      if (dialog.dataset.wired) return;
      dialog.dataset.wired = '1';
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || (e.target as HTMLElement).closest('[data-close-rules]')) {
          dialog.close();
        }
      });
    });

    document.querySelectorAll<HTMLDialogElement>('.game-album-modal').forEach((dialog) => {
      if (dialog.dataset.wired) return;
      dialog.dataset.wired = '1';

      const panel = dialog.querySelector<HTMLElement>('[data-album-panel]');
      const grid = dialog.querySelector<HTMLElement>('[data-album-grid]');
      const viewer = dialog.querySelector<HTMLElement>('[data-album-viewer]');
      const backBtn = dialog.querySelector<HTMLButtonElement>('[data-album-back]');
      const fullImg = dialog.querySelector<HTMLImageElement>('[data-album-full]');
      const metaEl = dialog.querySelector<HTMLElement>('[data-album-meta]');
      const titleEl = dialog.querySelector<HTMLElement>('[data-album-vtitle]');
      const captionEl = dialog.querySelector<HTMLElement>('[data-album-vcaption]');
      const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-album-prev]');
      const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-album-next]');
      const triggers = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-album-open]'));

      let activePos = -1;

      const setGridMode = () => {
        activePos = -1;
        if (panel) panel.dataset.view = 'grid';
        if (grid) grid.hidden = false;
        if (viewer) viewer.hidden = true;
        if (backBtn) backBtn.hidden = true;
        if (fullImg) fullImg.removeAttribute('src');
      };

      const showItem = (pos: number) => {
        if (!triggers.length) return;
        const wrapped = ((pos % triggers.length) + triggers.length) % triggers.length;
        activePos = wrapped;
        const btn = triggers[wrapped];
        if (!btn) return;
        if (panel) panel.dataset.view = 'viewer';
        if (grid) grid.hidden = true;
        if (viewer) viewer.hidden = false;
        if (backBtn) backBtn.hidden = false;
        if (fullImg) {
          fullImg.src = btn.dataset.albumSrc || '';
          fullImg.alt = btn.dataset.albumTitle || '';
        }
        if (metaEl) {
          metaEl.textContent = `FRAME ${btn.dataset.albumNo || ''} · ${btn.dataset.albumKind || ''}`;
        }
        if (titleEl) titleEl.textContent = btn.dataset.albumTitle || '';
        if (captionEl) captionEl.textContent = btn.dataset.albumCaption || '';
        if (prevBtn) prevBtn.disabled = triggers.length <= 1;
        if (nextBtn) nextBtn.disabled = triggers.length <= 1;
      };

      (dialog as HTMLDialogElement & { __resetAlbum?: () => void }).__resetAlbum = setGridMode;

      triggers.forEach((btn, pos) => {
        btn.addEventListener('click', () => showItem(pos));
      });

      backBtn?.addEventListener('click', setGridMode);
      prevBtn?.addEventListener('click', () => {
        if (activePos >= 0) showItem(activePos - 1);
      });
      nextBtn?.addEventListener('click', () => {
        if (activePos >= 0) showItem(activePos + 1);
      });

      dialog.addEventListener('cancel', (e) => {
        if (panel?.dataset.view === 'viewer') {
          e.preventDefault();
          setGridMode();
        }
      });

      dialog.addEventListener('keydown', (e) => {
        if (panel?.dataset.view !== 'viewer') return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          showItem(activePos - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          showItem(activePos + 1);
        }
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || (e.target as HTMLElement).closest('[data-close-album]')) {
          dialog.close();
        }
      });
    });
  }

  wireGameModals();
  document.addEventListener('astro:page-load', wireGameModals);
</script>

<style>
  /* 背景插画与像素粒子为 fixed，内容层抬起 */
  .game-head,
  .game-body,
  .rule-tab {
    position: relative;
    z-index: 1;
  }

  .game-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
  }

  .game-head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .game-head__title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .game-head__title :global(.game-head__icon) {
    font-size: 0.8em;
    color: var(--fg-muted);
  }

  .game-head__desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-align: right;
  }

  /* 标题下方的虚线 + 左端强调色短横，与列表页保持同一套视觉语法 */
  .rule-tab {
    position: relative;
    height: var(--hair);
    background: repeating-linear-gradient(
      to right,
      var(--line) 0 5px,
      transparent 5px 10px
    );
  }

  .rule-tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 4.5rem;
    height: 3px;
    background: var(--accent);
  }

  /* 主体区：底部留出充足呼吸空间，让左下角背景插画自然透出 */
  .game-body {
    padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(5rem, 11vw, 8rem);
  }

  .game-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* 卡片：只用 1px 发丝线做骨架，薄底板承托文字，不加阴影、圆角或渐变 */
  .game-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    transition:
      border-color var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  /* 顶部朱红发丝线：悬停时从左往右生长 */
  .game-card::before {
    content: "";
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-line);
    z-index: 2;
  }

  .game-card:hover {
    border-color: var(--line-strong);
    background: color-mix(in srgb, var(--bg) 86%, var(--accent-wash));
  }

  .game-card:hover::before {
    transform: scaleX(1);
  }

  /* 顶栏编号与小签 */
  .game-card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.15rem;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .game-card__no {
    color: var(--fg-faint);
  }

  .game-card__tag {
    color: var(--fg-muted);
  }

  /* 封面位：16:10 画幅，支持 OSS 图与发丝线点阵占位 */
  .game-card__cover-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: var(--hair) solid var(--line);
  }

  .game-card__cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-card__cover--night,
  :global(:root[data-theme='dark']) .game-card__cover--day {
    display: none;
  }

  :global(:root[data-theme='dark']) .game-card__cover--night {
    display: block;
  }

  .game-card__cover.cover-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  .game-card__motif {
    width: 3.25rem;
    height: auto;
    color: var(--line-strong);
    transition:
      color var(--dur-2) var(--ease-out),
      transform var(--dur-3) var(--ease-out);
  }

  .game-card__motif-dot {
    fill: var(--icon-pink);
    stroke: none;
  }

  .game-card:hover .game-card__motif {
    color: var(--fg-muted);
    transform: scale(1.05);
  }

  /* 悬停时一道斜光掠过封面，与文章列表封面保持一致 */
  .game-card__cover-wrap::after {
    content: "";
    position: absolute;
    top: -20%;
    left: -70%;
    width: 45%;
    height: 140%;
    background: linear-gradient(
      100deg,
      transparent,
      color-mix(in srgb, var(--fg) 10%, transparent),
      transparent
    );
    transform: skewX(-18deg);
    transition: left 700ms var(--ease-out);
    pointer-events: none;
  }

  .game-card:hover .game-card__cover-wrap::after {
    left: 125%;
  }

  /* 正文：标题与单行简述，克制留白 */
  .game-card__body {
    flex: 1;
    padding: 1.25rem 1.25rem 1.35rem;
  }

  .game-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.02em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .game-card:hover .game-card__title {
    color: var(--accent);
  }

  /* 「正热乎」小印章：正文右侧，粉色虚线框里一朵小火苗、一行 HOT、一行宋体小字，微微斜着；悬停卡片时摆正 */
  .game-card__body--hot {
    position: relative;
    padding-right: 7rem;
  }

  .game-card__hot {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem 0.3rem 0.4rem;
    border: var(--hair) dashed color-mix(in srgb, var(--icon-pink) 80%, transparent);
    color: var(--icon-pink);
    transform: translateY(-50%) rotate(-7deg);
    transition: transform var(--dur-2) var(--ease-out);
    pointer-events: none;
  }

  /* 印章四角外再压一圈细实线，像盖上去的 */
  .game-card__hot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border: var(--hair) solid color-mix(in srgb, var(--icon-pink) 35%, transparent);
  }

  .game-card:hover .game-card__hot {
    transform: translateY(-50%) rotate(0deg);
  }

  .game-card__hot :global(.game-card__hot-icon) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--icon-pink);
  }

  .game-card__hot-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .game-card__hot-en {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.24em;
  }

  .game-card__hot-zh {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }

  .game-card__summary {
    margin: 0.5rem 0 0;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 底栏：虚线分隔，左状态右箭头与小猫爪点缀 */
  .game-card__foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: var(--hair) dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .game-card:not(.game-card--coming) .game-card__state {
    color: var(--fg-muted);
  }

  /* 右边「开始游戏 →」挨在一起，悬停时前面探出一只小猫爪 */
  .game-card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .game-card__actions {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* 规则与画册按钮：统一样式的 1px 发丝框，左上角粉色折角 */
  .game-card__rules-btn,
  .game-card__album-btn {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem 0.25rem 0.5rem;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .game-card__rules-btn::before,
  .game-card__album-btn::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 0.4rem;
    height: 0.4rem;
    border-top: 1.5px solid var(--icon-pink);
    border-left: 1.5px solid var(--icon-pink);
  }

  .game-card__rules-icon,
  .game-card__album-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .game-card__rules-mark,
  .game-card__album-dot {
    stroke: var(--icon-pink);
    fill: var(--icon-pink);
  }

  .game-card__rules-btn:hover,
  .game-card__album-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .game-card__action {
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .game-card:not(.game-card--coming):hover .game-card__action {
    color: var(--accent);
    transform: translateX(3px);
  }

  .game-card__paw {
    width: 0.95rem;
    height: 0.95rem;
    fill: var(--icon-pink);
    opacity: 0;
    transform: scale(0.75) rotate(-10deg);
    transition:
      opacity var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    pointer-events: none;
  }

  .game-card:hover .game-card__paw {
    opacity: 0.9;
    transform: scale(1) rotate(10deg);
  }

  .game-card__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* 游戏规则 / 游戏画册弹窗：共享外观与快速渐显渐隐过渡，不出滚动条 */
  .game-rules-modal,
  .game-album-modal {
    margin: auto;
    padding: 0;
    width: min(calc(var(--page-max) - 2 * var(--gut)), calc(100vw - 2 * var(--gut)));
    max-width: none;
    max-height: calc(100dvh - 3rem);
    border: var(--hair) solid var(--line-strong);
    background: var(--bg);
    color: var(--fg);
    scrollbar-width: none;
    opacity: 0;
    transform: translateY(6px) scale(0.985);
    transition:
      opacity var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out),
      overlay var(--dur-1) allow-discrete,
      display var(--dur-1) allow-discrete;
  }

  .game-rules-modal[open],
  .game-album-modal[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .game-rules-modal[open],
    .game-album-modal[open] {
      opacity: 0;
      transform: translateY(6px) scale(0.985);
    }

    .game-rules-modal[open]::backdrop,
    .game-album-modal[open]::backdrop {
      opacity: 0;
    }
  }

  .game-rules-modal::-webkit-scrollbar,
  .game-rules-modal__body::-webkit-scrollbar,
  .game-album-modal::-webkit-scrollbar,
  .game-album-modal__body::-webkit-scrollbar {
    display: none;
  }

  /* 左上粉色折角，和卡片上的按钮呼应 */
  .game-rules-modal__panel::before,
  .game-album-modal__panel::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 0.7rem;
    height: 0.7rem;
    border-top: 2px solid var(--icon-pink);
    border-left: 2px solid var(--icon-pink);
    pointer-events: none;
  }

  /* 特性卡：每条「**名字**：说明」一格，三列，格子之间是发丝线 */
  /* 小萌提示框自带的上边距叠在内边距上太空，弹窗里第一个元素贴着内边距 */
  .game-rules-modal__body > :global(:first-child) {
    margin-top: 0;
  }

  .game-rules-modal__body :global(ul) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hair) solid var(--line);
    border-left: var(--hair) solid var(--line);
    counter-reset: rule;
  }

  /* 每格右上角一个等宽小编号，底边一段点线；悬停时左上角冒出粉色折角、底板泛一点暖色 */
  .game-rules-modal__body :global(li) {
    position: relative;
    margin: 0;
    padding: 1rem 1.25rem 1.1rem;
    border-right: var(--hair) solid var(--line);
    border-bottom: var(--hair) solid var(--line);
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--fg-muted);
    counter-increment: rule;
    transition: background var(--dur-1) var(--ease-out);
  }

  .game-rules-modal__body :global(li::after) {
    content: "0" counter(rule);
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }

  .game-rules-modal__body :global(li::before) {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 0.55rem;
    height: 0.55rem;
    border-top: 1.5px solid var(--icon-pink);
    border-left: 1.5px solid var(--icon-pink);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease-out);
  }

  .game-rules-modal__body :global(li:hover) {
    background: color-mix(in srgb, var(--bg) 88%, var(--accent-wash));
  }

  .game-rules-modal__body :global(li:hover::before) {
    opacity: 1;
  }

  .game-rules-modal__body :global(li strong) {
    display: block;
    width: fit-content;
    margin-bottom: 0.4rem;
    padding-bottom: 0.2rem;
    border-bottom: var(--hair) dashed color-mix(in srgb, var(--icon-pink) 70%, transparent);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--fg);
  }

  .game-rules-modal__body :global(li strong::before) {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 0.45rem 0.2em 0;
    vertical-align: middle;
    background: var(--icon-pink);
  }

  .game-rules-modal::backdrop,
  .game-album-modal::backdrop {
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition:
      opacity var(--dur-1) var(--ease-out),
      overlay var(--dur-1) allow-discrete,
      display var(--dur-1) allow-discrete;
  }

  .game-rules-modal[open]::backdrop,
  .game-album-modal[open]::backdrop {
    opacity: 1;
  }

  .game-rules-modal__panel,
  .game-album-modal__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 3rem);
  }

  .game-rules-modal__head,
  .game-album-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.5rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .game-album-modal__head-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .game-album-modal__kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
  }

  .game-rules-modal__title,
  .game-album-modal__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .game-album-modal__head-tools {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  /* 关闭 / 返回 / 上下张统一方形或发丝线控件 */
  .game-rules-modal__close,
  .game-album-modal__close {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: var(--hair) solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .game-album__back-btn,
  .game-album__nav-btn {
    padding: 0.32rem 0.72rem;
    border: var(--hair) solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .game-rules-modal__close:hover,
  .game-album-modal__close:hover,
  .game-album__back-btn:hover,
  .game-album__nav-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .game-album__nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* 正文铺满弹窗宽度（不受文章版心限制），格子更宽、左右不留大片空白 */
  .game-rules-modal__body,
  .game-album-modal__body {
    width: 100%;
    max-width: none;
    padding: 1.25rem 1.5rem 1.75rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  /* 游戏画册：6 列展陈网格，前 2 张各占半行，后 3 张均分第二行 */
  .game-album__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game-album-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .game-album-card--wide {
    grid-column: span 3;
  }

  .game-album-card--std {
    grid-column: span 2;
  }

  .game-album-card:not(.game-album-card--empty):hover {
    border-color: var(--accent);
  }

  .game-album-card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .game-album-card__kind {
    color: var(--fg-muted);
  }

  .game-album-card__stage {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-bottom: var(--hair) solid var(--line);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--fg) 2.5%, transparent);
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 10%, transparent) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  button.game-album-card__stage {
    cursor: zoom-in;
  }

  .game-album-card__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    transition: transform var(--dur-2) var(--ease-out);
  }

  button.game-album-card__stage:hover .game-album-card__img {
    transform: scale(1.025);
  }

  .game-album-card__zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    padding: 0.18rem 0.45rem;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  button.game-album-card__stage:hover .game-album-card__zoom {
    opacity: 1;
    transform: translateY(0);
    color: var(--accent);
    border-color: var(--accent);
  }

  .game-album-card__stage--ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    color: var(--fg-faint);
  }

  .game-album-card__ph-svg {
    width: 3.1rem;
    height: 2rem;
    opacity: 0.65;
  }

  .game-album-card__ph-dot {
    fill: var(--icon-pink);
    stroke: none;
  }

  .game-album-card__ph-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .game-album-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 0.85rem 0.85rem;
  }

  .game-album-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--fg);
  }

  .game-album-card__caption {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }

  /* 单图放大浏览态 */
  .game-album__viewer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: opacity var(--dur-1) var(--ease-out);
  }

  .game-album__viewer[hidden],
  .game-album__grid[hidden],
  .game-album__back-btn[hidden] {
    display: none;
  }

  .game-album__stage {
    margin: 0;
    border: var(--hair) solid var(--line);
    background-color: color-mix(in srgb, var(--fg) 2.5%, transparent);
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 10%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    display: grid;
    place-items: center;
    padding: 0.75rem;
  }

  .game-album__full {
    max-width: 100%;
    max-height: min(62dvh, 520px);
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .game-album__viewer-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: var(--hair) dashed var(--line);
  }

  .game-album__viewer-copy {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }

  .game-album__viewer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }

  .game-album__viewer-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .game-album__viewer-caption {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .game-album__viewer-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* 平板端：两列排布 */
  @media (max-width: 58rem) {
    .game-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .game-rules-modal__body :global(ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .game-album__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .game-album-card--wide,
    .game-album-card--std {
      grid-column: span 1;
    }

    .game-head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .game-head__desc {
      text-align: left;
    }
  }

  /* 移动端：单列展开，保证触屏点击区域舒展、375/320 零横向溢出 */
  @media (max-width: 38rem) {
    .game-head {
      padding-block: 1.75rem 1.25rem;
    }

    .game-body {
      padding-block: 1.75rem 4rem;
    }

    .game-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .game-card__body {
      padding: 1.1rem 1.1rem 1.2rem;
    }

    .game-card__bar,
    .game-card__foot {
      padding-inline: 1.1rem;
    }

    .game-rules-modal__head,
    .game-rules-modal__body,
    .game-album-modal__head,
    .game-album-modal__body {
      padding-inline: 1.1rem;
    }

    /* 手机：规则与画册从底部升起的一张抽屉，铺满宽度，最多占屏幕 85% */
    .game-rules-modal,
    .game-album-modal {
      width: 100%;
      max-height: 85dvh;
      margin: auto 0 0;
      border-width: var(--hair) 0 0;
      transform: translateY(14px);
    }

    .game-rules-modal[open],
    .game-album-modal[open] {
      transform: translateY(0);
    }

    @starting-style {
      .game-rules-modal[open],
      .game-album-modal[open] {
        opacity: 0;
        transform: translateY(14px);
      }
    }

    .game-rules-modal__panel,
    .game-album-modal__panel {
      max-height: 85dvh;
    }

    .game-rules-modal__body :global(ul) {
      grid-template-columns: minmax(0, 1fr);
      border-left: 0;
      border-top: 0;
    }

    .game-rules-modal__body :global(li) {
      padding: 0.75rem 0.1rem;
      border-right: 0;
      border-bottom: var(--hair) dashed var(--line);
    }

    .game-rules-modal__body :global(li:last-child) {
      border-bottom: 0;
    }

    .game-album__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .game-album__viewer-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }

