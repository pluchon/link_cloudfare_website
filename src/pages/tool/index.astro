---
import ListLayout from '../../layouts/ListLayout.astro';
import { branches } from '../../config/site';
import { getPublished, paginateEntries } from '../../lib/content';

const entries = await getPublished('tool');
const pages = paginateEntries(entries);

const branch = branches.find((b) => b.key === 'tool');
---

<ListLayout
  kind="tool"
  title={branch?.label}
  cover={branch?.cover}
  description={branch?.desc}
  entries={pages[0]}
  page={1}
  totalPages={pages.length}
  basePath="/tool/"
  emptyText="这里还空着..."
/>
