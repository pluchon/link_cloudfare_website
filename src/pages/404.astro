---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。" noindex>
  <section class="wrap notfound">
    <p class="label">Error 404</p>
    <h1 class="notfound__title">这里什么也没有</h1>
    <p class="notfound__text">链接可能过期了，或者这篇内容还没写。</p>
    <p class="notfound__actions">
      <a class="text-link" href="/">回首页</a>
      <a class="text-link" href="/blog/">看文章</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 9rem);
    border-bottom: var(--hair) solid var(--line);
  }

  .notfound__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 1rem 0 0;
    letter-spacing: 0.02em;
  }

  .notfound__text {
    margin: 1rem 0 0;
    color: var(--fg-muted);
  }

  .notfound__actions {
    display: flex;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }
</style>
