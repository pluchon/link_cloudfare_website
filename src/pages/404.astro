---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const poster = site.notFoundPoster;
---

<BaseLayout title="页面不存在" description="没有找到这个页面。" noindex>
  <section class="wrap notfound">
    <div
      class="notfound__poster"
      aria-hidden="true"
      data-reveal
      style={{
        '--poster-day': `url('${poster.light}')`,
        '--poster-night': `url('${poster.dark}')`,
        '--poster-day-tall': `url('${poster.lightPortrait}')`,
        '--poster-night-tall': `url('${poster.darkPortrait}')`,
      }}
    />

    <div class="notfound__row" data-reveal style="--reveal-i: 1">
      <h1 class="notfound__title">这里啥也没有</h1>
      <p class="notfound__text">链接可能过期了，或者这篇内容还没写</p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - 12rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .notfound__poster {
    --poster-light: var(--poster-day);
    --poster-dark: var(--poster-night);
    flex: 1 0 auto;
    min-height: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--poster-light) center / cover no-repeat;
    border: var(--hair) solid var(--line);
  }

  :global(:root[data-theme='dark']) .notfound__poster {
    background-image: var(--poster-dark);
  }

  @media (max-aspect-ratio: 4 / 5) {
    .notfound__poster {
      --poster-light: var(--poster-day-tall);
      --poster-dark: var(--poster-night-tall);
      aspect-ratio: 9 / 16;
    }
  }

  /* 标题在左，说明贴到同一行的最右侧 */
  .notfound__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.75rem;
  }

  .notfound__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .notfound__text {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    text-align: right;
  }

  @media (max-width: 44rem) {
    /* 窄屏页脚会换行变高，12rem 的预留不够，整页会溢出半屏 */
    .notfound { min-height: calc(100dvh - 16rem); }

    .notfound__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .notfound__title { white-space: normal; }
    .notfound__text { text-align: left; }
  }
</style>
