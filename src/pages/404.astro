---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。" noindex variant="bare">
  <section class="wrap notfound">
    <img
      class="notfound__poster"
      src={site.notFoundPoster}
      alt=""
      data-reveal
      width="1600"
      height="900"
    />

    <div class="notfound__row" data-reveal style="--reveal-i: 1">
      <h1 class="notfound__title">这里啥也没有</h1>
      <p class="notfound__text">链接可能过期了，或者这篇内容还没写</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* 一屏放完：海报吃掉剩余高度，不产生滚动 */
  .notfound {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - 12rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .notfound__poster {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    border: var(--hair) solid var(--line);
  }

  /* 标题在左，说明贴到同一行的最右侧 */
  .notfound__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.75rem;
  }

  .notfound__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .notfound__text {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    text-align: right;
  }

  @media (max-width: 44rem) {
    .notfound__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .notfound__title { white-space: normal; }
    .notfound__text { text-align: left; }
  }
</style>
