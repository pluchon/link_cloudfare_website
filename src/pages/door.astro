  { id: 'base', text: '基地', href: '', sub: 'BASE' },
  ...branches.map((b) => ({ id: b.key, text: b.label, href: b.href, sub: b.key.toUpperCase() })),
];

// ---- 嵌入 3D 基地书房构建期数据（文章 1:1 实体书本 + 游戏大厅 + 公告 + 画廊 + 标签 + 关于） ----
const bookColors = bookColorsRaw as Record<string, string>;

const SHELF_HOTSPOT_MAP: Record<ContentKind, HotspotId> = {
  project: 'shelf-project',
  tool: 'shelf-tool',
  explore: 'shelf-explore',
  daily: 'shelf-daily',
  xiaomeng: 'shelf-xiaomeng',
};

const FALLBACK_COLORS: Record<ContentKind, string> = {
  project: '#4e6b8a',
  tool: '#5e7a68',
  explore: '#6c5b8c',
  daily: '#b87a56',
  xiaomeng: '#c985a8',
};

function extractHeadings(body = ''): string[] {
  const out: string[] = [];
  for (const line of body.split(/\r?\n/)) {
    const m = line.match(/^\s*##\s+(.+?)\s*$/);
    if (m) {
      out.push(m[1].replace(/[*_`~]/g, '').trim());
      if (out.length >= 6) break;
    }
  }
  return out;
}

function buildExcerpt(body = ''): string {
  const cleaned = body
    .replace(/^\s*#\s+.*$/m, '')
    .replace(/^\s*>\s*.*$/gm, '')
    .trim();
  const txt = plainText(cleaned);
  return txt.length > 260 ? `${txt.slice(0, 260)}……` : txt;
}

const roomBranches = await Promise.all(
  branches.map(async (b) => {
    const kind = b.key as ContentKind;
    const entries = await getPublished(kind);
    return {
      key: b.key as BranchKey,
      hotspotId: SHELF_HOTSPOT_MAP[kind],
      label: b.label,
      desc: b.desc,
      href: b.href,
      total: entries.length,
      books: entries.map((entry) => {
        const key = `${kind}/${entry.data.slug}`;
        const rawCover = entryCover(entry);
        return {
          id: key,
          kind: kind as BranchKey,
          categoryLabel: b.label,
          title: entry.data.title,
          summary: entry.data.summary,
          excerpt: buildExcerpt(entry.body),
          headings: extractHeadings(entry.body),
          date: formatDate(entry.data.publishedAt),
          at: entry.data.publishedAt.toISOString(),
          href: entryHref(kind, entry.data.slug),
          cover: thumbUrl(rawCover),
          coverColor: bookColors[key] ?? FALLBACK_COLORS[kind],
          tags: [...entry.data.tags.slice(0, 4)],
        };
      }),
    };
  }),
);

const collectionGames = await getGames();
const roomGames =
  collectionGames.length > 0
    ? collectionGames.map((entry, idx) => ({
        id: String(idx + 1).padStart(2, '0'),
        title: entry.data.title,
        summary: entry.data.summary,
        tag: entry.data.tags.slice(0, 2).join(' / ') || '小游戏',
        href: entry.data.play ?? '/game/',
