---
// 门户页：站在绕黑洞公转的空间站观景甲板上望向黑洞。按住拖动可以 360° 看，一拖动镜头就慢慢退出
// 空间站、变成绕黑洞的自由视角（可以一直转到正上方俯视）；双击回到甲板。
// 点黑洞（或引线上的文字）俯冲进去，落到思维导图首页；五个分类各是一个绕黑洞运行的探测器，点了直接去那个分类。
// 每个会话第一次打开首页时会被送到这里（判断写在 BaseLayout 的首帧脚本里）
import { site, branches } from '../config/site';
import { getPublished, formatDate, entryCover, thumbUrl, type ContentKind } from '../lib/content';
import { AZIMUTH_LABELS, STAR_NODES } from '../door/starmap';
import '../styles/warp.css';

// 五个探测器的信标色与轨道遥测参数（与 scene.ts 的 PROBE_ORBITS / PROBE_BEACONS 严格对应）
const probeMeta: Record<string, { tint: string; orbit: string }> = {
  project: { tint: '#ffc070', orbit: '13 Rs · e 0.12' },
  tool: { tint: '#8fd4ff', orbit: '18 Rs · e 0.08' },
  explore: { tint: '#c8a0ff', orbit: '24 Rs · e 0.16' },
  daily: { tint: '#9fe6b0', orbit: '30 Rs · e 0.10' },
  xiaomeng: { tint: '#ffa6c9', orbit: '37 Rs · e 0.18' },
};

// 终端屏幕：点探测器后镜头飞过去停靠，屏幕上是这个分类此刻的样子。
// 内容在构建时取，和分类页本身同一份数据——站点只在推送时构建，所以它和真实页面一样「实时」。
// 不用 iframe 嵌真页面：站点头里是 X-Frame-Options: DENY，而且那会再开一个页面和一个 WebGL 背景
const terminals = await Promise.all(
  branches.map(async (b, idx) => {
    const entries = await getPublished(b.key as ContentKind);
    const meta = probeMeta[b.key] ?? { tint: '#8fd4ff', orbit: '20 Rs' };
    return {
      ...b,
      code: `PRB-0${idx + 1}`,
      tint: meta.tint,
      orbit: meta.orbit,
      total: entries.length,
      latest: entries.slice(0, 4).map((e) => ({
        title: e.data.title,
        summary: e.data.summary,
        date: formatDate(e.data.publishedAt),
        // 封面走 OSS 缩略图样式，和首页导图一样，省流量
        cover: thumbUrl(entryCover(e)),
      })),
    };
  }),
);

// 标注：一条引线 + 端点圈 + 文字。黑洞、基地、五个探测器各一组，位置由 scene.ts 每帧更新
const tags = [
  { id: 'hole', text: '穿越黑洞来到基地', href: '/', sub: 'EVENT HORIZON' },
  { id: 'base', text: '基地', href: '', sub: 'BASE' },
  ...branches.map((b) => ({ id: b.key, text: b.label, href: b.href, sub: b.key.toUpperCase() })),
];
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#020308" />
    <title>{site.name}</title>
    <link rel="icon" href="/icon-64.png" type="image/png" sizes="64x64" />
    <link rel="prefetch" href="/" />
    <script is:inline>
      try {
        sessionStorage.setItem('nn-entered', '1');
      } catch (e) {
        /* 隐私模式写不进去也无妨，最多下次再看一遍门户 */
      }
    </script>
  </head>
  <body>
    <!-- 开场加载画面「校准星图」：写在 HTML 里，页面一打开就有，不等脚本。
         视界 + 一圈刻度表盘，进度是沿表盘点亮的弧线；七颗星随进度依次亮起、连成星座。
         进度按真实里程碑走（见下面的内联脚本和场景脚本里的 __boot 调用） -->
    <div class="boot" data-boot role="progressbar" aria-label="正在校准星图" aria-valuemin="0" aria-valuemax="100">
      <!-- 四周装饰：和门户 HUD 同一套语言，像观测站开机时的仪表 -->
      <div class="boot__frame" aria-hidden="true">
        <span class="boot__corner boot__corner--tl"></span>
        <span class="boot__corner boot__corner--tr"></span>
        <span class="boot__corner boot__corner--bl"></span>
        <span class="boot__corner boot__corner--br"></span>
        <span class="boot__tape boot__tape--top"></span>
        <span class="boot__tape boot__tape--left"></span>
        <span class="boot__tag boot__tag--tl">OBS-01 · 观测甲板</span>
        <span class="boot__tag boot__tag--tr">SYS · BOOT</span>
        <span class="boot__tag boot__tag--bl">RA 17h 45m 40s · DEC −29° 00′ 28″</span>
        <span class="boot__tag boot__tag--br">LINK · STANDBY</span>
      </div>
      <svg class="boot__chart" viewBox="-200 -190 400 300" aria-hidden="true">
        <polyline class="boot__lines" data-boot-lines points="-150,-92 -96,-138 -18,-160 58,-128 128,-150 160,-60 118,40"></polyline>
        {
          [
            [-150, -92],
            [-96, -138],
            [-18, -160],
            [58, -128],
            [128, -150],
            [160, -60],
            [118, 40],
          ].map(([x, y], i) => <circle class="boot__star" data-boot-star={i} cx={x} cy={y} r={i % 3 === 0 ? 3.2 : 2.2} />)
        }
        <circle class="boot__dial" r="74"></circle>
        <circle class="boot__ticks" r="82"></circle>
        <circle class="boot__arc" data-boot-arc r="74" transform="rotate(-90)"></circle>
        <circle class="boot__glow" r="40"></circle>
        <circle class="boot__horizon" r="34"></circle>
      </svg>
      <p class="boot__label">正在校准星图 · <span data-boot-pct>0%</span></p>
      <p class="boot__sub">STAR CHART CALIBRATION</p>
    </div>
    <script is:inline>
      // 开场加载的进度：分几个真实里程碑，每段之间缓慢逼近这一段的上限，不会停在一个数上不动。
      //   页面解析完 0.2 → 场景脚本开始执行 0.5 → 场景搭好 0.8 → 着色器编译完 1
      // 走到 1 之后渐隐收起。场景脚本没跑起来（不支持 WebGL2、脚本出错）也最多等 12 秒
      (function () {
        var root = document.querySelector('[data-boot]');
        if (!root) return;
        var arc = root.querySelector('[data-boot-arc]');
        var lines = root.querySelector('[data-boot-lines]');
        var stars = root.querySelectorAll('[data-boot-star]');
        var pct = root.querySelector('[data-boot-pct]');
        var CIRC = 2 * Math.PI * 74;
        var LINE = lines.getTotalLength ? lines.getTotalLength() : 600;
        arc.style.strokeDasharray = CIRC;
        lines.style.strokeDasharray = LINE;
        var shown = 0;
        var floor = 0;
        var cap = 0.18;
        var done = false;
        var last = performance.now();
        function paint() {
          arc.style.strokeDashoffset = CIRC * (1 - shown);
          lines.style.strokeDashoffset = LINE * (1 - shown);
          for (var i = 0; i < stars.length; i++) stars[i].classList.toggle('on', shown >= (i + 0.5) / stars.length);
          var p = Math.round(shown * 100);
          pct.textContent = p + '%';
          root.setAttribute('aria-valuenow', p);
        }
        function tick() {
          var now = performance.now();
          var dt = Math.min((now - last) / 1000, 0.25);
          last = now;
          // 先追到已确认的进度，再往这一段的上限慢慢爬；都按时间算，后台降帧也照样走
          var goal = Math.max(floor, shown + (cap - shown) * Math.min(dt * 0.6, 1));
          shown += (goal - shown) * Math.min(dt * 5, 1);
          if (done && 1 - shown < 0.004) {
            shown = 1;
            paint();
            root.dataset.state = 'done';
            setTimeout(function () {
              root.hidden = true;
            }, 700);
            return;
          }
          paint();
          requestAnimationFrame(tick);
        }
        window.__boot = {
          reach: function (value, nextCap) {
            floor = Math.max(floor, value);
            cap = Math.max(cap, nextCap || value);
          },
          done: function () {
            floor = 1;
            cap = 1;
            done = true;
          },
        };
        document.addEventListener('DOMContentLoaded', function () {
          window.__boot.reach(0.2, 0.45);
        });
        setTimeout(window.__boot.done, 12000);
        requestAnimationFrame(tick);
      })();
    </script>

    <canvas class="stage" data-stage tabindex="0" aria-label="黑洞场景：按住拖动换视角，双击回到甲板，点击黑洞进入"></canvas>

    <div class="vignette" aria-hidden="true"></div>

    <!-- 右上角实时微缩斯隆长城星图窗（基地时直接展示星图画面；进入具体黑洞星系后标注所在位置并显示 ← 返回斯隆长城） -->
    <button
      type="button"
      class="starmap-mini"
      data-starmap-mini
      data-mode="deck"
      aria-label="进入斯隆长城星图"
    >
      <span class="starmap-mini__corner starmap-mini__corner--tl" aria-hidden="true"></span>
      <span class="starmap-mini__corner starmap-mini__corner--tr" aria-hidden="true"></span>
      <span class="starmap-mini__corner starmap-mini__corner--bl" aria-hidden="true"></span>
      <span class="starmap-mini__corner starmap-mini__corner--br" aria-hidden="true"></span>
      <span class="starmap-mini__head">
        <span class="starmap-mini__code"><i class="starmap-mini__dot" aria-hidden="true"></i>00 · 斯隆长城</span>
        <span class="starmap-mini__arrow" aria-hidden="true">→</span>
      </span>
      <canvas class="starmap-mini__canvas" data-starmap-preview aria-hidden="true"></canvas>
      <span class="starmap-mini__enter-line">点击进入</span>
      <span class="starmap-mini__back-line">← 返回斯隆长城</span>
    </button>

    <!-- 右侧共用竖向对数尺度滑尺：顶部 6 RS 为基地人马座 A* 最近处，穿过 35% 分界阈值平滑过渡至下方 1.4 GLY 斯隆长城全景 -->
    <div class="starmap-scale" data-starmap-scale data-mode="deck" aria-label="基地至斯隆长城尺度缩放">
      <span class="starmap-scale__end">6 RS</span>
      <span class="starmap-scale__track" data-starmap-track>
        <span class="starmap-scale__ticks" aria-hidden="true"></span>
        <span class="starmap-scale__seam" aria-hidden="true"></span>
        <span class="starmap-scale__thumb" data-starmap-thumb></span>
      </span>
      <span class="starmap-scale__end">1.4 GLY</span>
    </div>

    <!-- 斯隆长城星图与星系黑洞近景专属 UI（始终保持在文档流中以便首帧量取文字宽度，平时透明且穿透鼠标） -->
    <div class="starmap-layer" data-starmap-layer data-mode="deck">
      <svg class="callout starmap-callout" aria-hidden="true">
        {
          STAR_NODES.map((n) => (
            <g>
              <polyline class="callout__line" data-star-line={n.id} points="0,0 0,0" style={`stroke: ${n.color}`} />
              <circle class="callout__dot" data-star-dot={n.id} r={n.kind === 'hub' ? 4.5 : 3} style={`stroke: ${n.color}`} />
            </g>
          ))
        }
      </svg>
      {
        STAR_NODES.map((n) => (
          <button
            type="button"
            class:list={['callout__label', 'starmap-label', n.kind === 'hub' && 'starmap-label--hub']}
            data-star-label={n.id}
            style={`--star-tint: ${n.color}`}
          >
            {n.name}
            <small>{n.sub}</small>
          </button>
        ))
      }
      {
        AZIMUTH_LABELS.map((item, idx) => (
          <span class="starmap-azimuth" data-azimuth-label={idx} aria-hidden="true">{item.deg}</span>
        ))
      }

      <!-- 左上角无框位置铭牌（斯隆长城界面仅展示唯一题签，星系核近景展示当前星系黑洞位置） -->
      <header class="starmap-plaque" data-starmap-plaque>
        <p class="starmap-plaque__eyebrow">
          <span data-star-bar-code>DEEP SPACE · 1.37 GLY</span>
          <i aria-hidden="true"></i>
        </p>
        <h2 class="starmap-plaque__title" data-star-bar-title>斯隆长城</h2>
        <p class="starmap-plaque__meta">
          <i aria-hidden="true"></i>
          <span data-star-bar-meta>Z = 0.073 · 大尺度纤维网</span>
        </p>
      </header>
    </div>

    <!-- 标题区做成一块观测站铭牌：眉题 → 逐字浮现的标题 → 分割线里的标语 → 英文副行 → 坐标 -->
    <header class="copy" data-copy>
      <p class="copy__eyebrow">
        <span>{site.door.eyebrow}</span>
        <i aria-hidden="true"></i>
        <span>{site.door.eyebrowCn}</span>
      </p>
      <h1 class="copy__title" aria-label={site.name}>
        {[...site.name].map((ch, i) => <span style={`--i: ${i}`} aria-hidden="true">{ch}</span>)}
      </h1>
      <p class="copy__rule">
        <i aria-hidden="true"></i>
        <span>{site.doorLine.split(/[，,]/).join(' · ')}</span>
        <i aria-hidden="true"></i>
      </p>
      <p class="copy__en">{site.door.en}</p>
      <p class="copy__coord">{site.door.coord}</p>
    </header>

    <svg class="callout" aria-hidden="true">
      {
        tags.map((t) => (
          <g>
            <polyline class="callout__line" data-tag-line={t.id} points="0,0 0,0" />
            <circle class="callout__dot" data-tag-dot={t.id} r={t.id === 'hole' ? 3 : 5} />
          </g>
        ))
      }
    </svg>
    {
      tags.map((t) =>
        t.href ? (
          <a class:list={['callout__label', t.id === 'hole' && 'callout__label--hole']} data-tag-label={t.id} href={t.href}>
            <span data-tag-text={t.id}>{t.text}</span>
            {t.sub && <small>{t.sub}</small>}
          </a>
        ) : (
          <span class="callout__label callout__label--quiet" data-tag-label={t.id}>
            {t.text}
            <small>{t.sub}</small>
          </span>
        ),
      )
    }

    <!-- 探测器终端：停靠后从探测器那侧展开；点屏幕先收起面板，再穿过黑洞去这个分类 -->
    {
      terminals.map((t) => (
        <a
          class="terminal"
          data-terminal={t.key}
          href={t.href}
          hidden
          style={`--probe-tint: ${t.tint}`}
          aria-label={`跃迁至${t.label}`}
        >
          <span class="terminal__corner terminal__corner--tl" aria-hidden="true"></span>
          <span class="terminal__corner terminal__corner--tr" aria-hidden="true"></span>
          <span class="terminal__corner terminal__corner--bl" aria-hidden="true"></span>
          <span class="terminal__corner terminal__corner--br" aria-hidden="true"></span>
          <span class="terminal__tether" aria-hidden="true"></span>
          <span class="terminal__bar">
            <span class="terminal__bar-left">
              <i class="terminal__dot" aria-hidden="true"></i>
              <span>{t.code} · {t.key.toUpperCase()}</span>
              <span class="terminal__orbit">ORBIT {t.orbit}</span>
            </span>
            <span class="terminal__bar-right">LINK LOCKED · 共 {t.total} 篇</span>
          </span>
          <span class="terminal__head">
            <span class="terminal__title-wrap">
              <i class="terminal__accent" aria-hidden="true"></i>
              <span class="terminal__title">{t.label}</span>
            </span>
            <span class="terminal__desc">{t.desc}</span>
          </span>
          <span class="terminal__list">
            {t.latest.map((item, idx) => (
              <span class="terminal__item">
                {item.cover ? (
                  <img class="terminal__cover" src={item.cover} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="terminal__cover" />
                )}
                <span class="terminal__meta">
                  <span class="terminal__row">
                    <span class="terminal__idx">0{idx + 1}</span>
                    <span class="terminal__name">{item.title}</span>
                    <span class="terminal__date">{item.date}</span>
                  </span>
                  {item.summary && <span class="terminal__summary">{item.summary}</span>}
                </span>
              </span>
            ))}
            {t.latest.length === 0 && <span class="terminal__empty">这里还没有内容</span>}
          </span>
          <span class="terminal__go">
            <span class="terminal__go-code">WARP // {t.key.toUpperCase()}</span>
            <span>点击屏幕 · 跃迁至「{t.label}」</span>
            <span class="terminal__go-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }

    <!-- 四周的装饰：角框、方位刻度带、俯仰刻度、读数 -->
    <div class="hud" aria-hidden="true">
      <span class="hud__corner hud__corner--tl"></span>
      <span class="hud__corner hud__corner--tr"></span>
      <span class="hud__corner hud__corner--bl"></span>
      <span class="hud__corner hud__corner--br"></span>
      <div class="hud__tape hud__tape--heading" data-heading-tape></div>
      <span class="hud__caret"></span>
      <div class="hud__tape hud__tape--pitch" data-pitch-tape></div>
      <span class="hud__read hud__read--tr" data-view>视角 · 甲板</span>
      <span class="hud__read hud__read--bl" data-distance></span>
      <span class="hud__read hud__read--br" data-heading></span>
      <!-- 操作引导：给第一次来的人看，三块遥测仪表小面板各讲一种操作，随当前视角状态联动 -->
      <ul class="guide" data-guide data-mode="deck">
        <li class="guide__item guide__item--drag">
          <span class="guide__head">
            <span class="guide__code"><i class="guide__dot"></i>01 · ORBIT CAM</span>
            <span class="guide__state">DRAG</span>
          </span>
          <span class="guide__body">
            <svg class="guide__icon" viewBox="0 0 24 24">
              <path d="M12 3v18M3 12h18M12 3 9.5 5.5M12 3l2.5 2.5M12 21l-2.5-2.5M12 21l2.5-2.5M3 12l2.5-2.5M3 12l2.5 2.5M21 12l-2.5-2.5M21 12l-2.5 2.5" />
            </svg>
            <span class="guide__text">
              <span class="guide__title guide__title--base">按住拖动</span>
              <span class="guide__title guide__title--map">漫游星海</span>
              <span class="guide__title guide__title--galaxy">贴近吸积激流</span>
              <span class="guide__desc guide__desc--base"><span class="guide__desc-extra">环顾四周 · </span>脱离甲板<span class="guide__desc-extra">自由</span>巡航</span>
              <span class="guide__desc guide__desc--map">拨转十亿光年<span class="guide__desc-extra"> · 凝望星辰流转</span></span>
              <span class="guide__desc guide__desc--galaxy">掠过光速火环<span class="guide__desc-extra"> · 感受时空弯曲</span></span>
            </span>
          </span>
        </li>
        <li class="guide__item guide__item--probe">
          <span class="guide__head">
            <span class="guide__code"><i class="guide__dot"></i>02 · TELEMETRY</span>
            <span class="guide__state">CLICK</span>
          </span>
          <span class="guide__body">
            <svg class="guide__icon" viewBox="0 0 24 24">
              <path d="M3 6.5 6.5 3 10 6.5 6.5 10ZM14 17.5l3.5-3.5 3.5 3.5-3.5 3.5ZM12 9l3 3-3 3-3-3ZM8.5 8.5l2 2M13.5 13.5l2 2M14.5 9.5 17 7M17 4a3 3 0 0 1 3 3" />
            </svg>
            <span class="guide__text">
              <span class="guide__title guide__title--base">点击探测器</span>
              <span class="guide__title guide__title--map">奔赴引力深处</span>
              <span class="guide__title guide__title--galaxy">坠入事件视界</span>
              <span class="guide__desc guide__desc--base"><span class="guide__desc-extra">停靠轨道信标 · </span>查看分类近况</span>
              <span class="guide__desc guide__desc--map">择一星系奇点<span class="guide__desc-extra"> · 俯瞰巨洞沉浮</span></span>
              <span class="guide__desc guide__desc--galaxy">跨越临界之门<span class="guide__desc-extra"> · 跃迁星系彼岸</span></span>
            </span>
          </span>
        </li>
        <li class="guide__item guide__item--recall">
          <span class="guide__head">
            <span class="guide__code"><i class="guide__dot"></i>03 · AUTO RETURN</span>
            <span class="guide__state">DBL-CLK</span>
          </span>
          <span class="guide__body">
            <svg class="guide__icon" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="2" />
              <circle cx="12" cy="12" r="5.5" />
              <circle cx="12" cy="12" r="9" />
            </svg>
            <span class="guide__text">
              <span class="guide__title guide__title--base">双击画面</span>
              <span class="guide__title guide__title--map">归航观测甲板</span>
              <span class="guide__title guide__title--galaxy">脱离引力深井</span>
              <span class="guide__desc guide__desc--base"><span class="guide__desc-extra">断开巡航链路 · </span>自动飞回甲板</span>
              <span class="guide__desc guide__desc--map"><span class="guide__desc-extra">循着引力波纹 · </span>折返人马座 A*</span>
              <span class="guide__desc guide__desc--galaxy"><span class="guide__desc-extra">回望巨洞微光 · </span>重返斯隆长城</span>
            </span>
          </span>
        </li>
      </ul>
    </div>

    <div class="veil" data-veil aria-hidden="true"></div>

