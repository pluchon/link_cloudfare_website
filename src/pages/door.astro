// 五个探测器的信标色与轨道遥测参数（与 scene.ts 的 PROBE_ORBITS / PROBE_BEACONS 严格对应）
const probeMeta: Record<string, { tint: string; orbit: string }> = {
  project: { tint: '#ffc070', orbit: '13 Rs · e 0.12' },
  tool: { tint: '#8fd4ff', orbit: '18 Rs · e 0.08' },
  explore: { tint: '#c8a0ff', orbit: '24 Rs · e 0.16' },
  daily: { tint: '#9fe6b0', orbit: '30 Rs · e 0.10' },
  xiaomeng: { tint: '#ffa6c9', orbit: '37 Rs · e 0.18' },
};

// 终端屏幕：点探测器后镜头飞过去停靠，屏幕上是这个分类此刻的样子。
// 内容在构建时取，和分类页本身同一份数据——站点只在推送时构建，所以它和真实页面一样「实时」。
// 不用 iframe 嵌真页面：站点头里是 X-Frame-Options: DENY，而且那会再开一个页面和一个 WebGL 背景
const terminals = await Promise.all(
  branches.map(async (b, idx) => {
    const entries = await getPublished(b.key as ContentKind);
    const meta = probeMeta[b.key] ?? { tint: '#8fd4ff', orbit: '20 Rs' };
    return {
      ...b,
      code: `PRB-0${idx + 1}`,
      tint: meta.tint,
      orbit: meta.orbit,
      total: entries.length,
      latest: entries.slice(0, 4).map((e) => ({
        title: e.data.title,
        summary: e.data.summary,
        date: formatDate(e.data.publishedAt),
        // 封面走 OSS 缩略图样式，和首页导图一样，省流量
        cover: thumbUrl(entryCover(e)),
      })),
    };
  }),
);

// 标注：一条引线 + 端点圈 + 文字。黑洞、基地、五个探测器各一组，位置由 scene.ts 每帧更新
const tags = [
