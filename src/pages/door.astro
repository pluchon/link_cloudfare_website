import { site, branches, games as fallbackGames, palettes, profile } from '../config/site';
import KindIcon from '../components/KindIcon.astro';
import {
  getPublished,
  getAllPublished,
  getGames,
  getNotices,
  getLatestNotice,
  formatDate,
  entryCover,
  entryHref,
  isPinned,
  noticeHref,
  noticeType,
  plainText,
  tagCounts,
  thumbUrl,
