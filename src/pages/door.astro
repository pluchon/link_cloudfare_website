    : fallbackGames.map((g) => ({
        id: g.id,
        title: g.title,
        summary: g.summary,
        tag: g.tag,
        href: g.href || '/game/',
      }));

const roomNoticeEntries = await getNotices();
const latestNotice = await getLatestNotice();
const roomNotices = roomNoticeEntries.slice(0, 6).map((entry) => ({
  title: entry.data.title,
  summary: entry.data.summary,
  date: formatDate(entry.data.publishedAt),
  at: entry.data.publishedAt.toISOString(),
  href: noticeHref(entry.data.slug),
  pinned: isPinned(entry),
  type: noticeType(entry),
}));

const roomGallery = galleryRaw.map((item) => ({
  id: item.id,
  title: item.title,
  summary: item.summary,
  category: item.category,
  src: item.src,
  thumb: thumbUrl(item.src) ?? item.src,
  cutout: 'cutout' in item ? Boolean(item.cutout) : false,
}));

const allPublished = await getAllPublished();
const roomTags = tagCounts(allPublished.map((x) => x.entry))
  .slice(0, 18)
  .map((item) => ({
    tag: item.tag,
    count: item.count,
    href: `/tags/${encodeURIComponent(item.tag)}/`,
  }));

const profileDocs = await getCollection('profile');
const introDoc = profileDocs.find((d) => d.id === 'my_introduction') ?? profileDocs[0];
const introText = plainText(
  (introDoc?.body ?? '')
    .replace(/^\s*#\s+.*$/m, '')
    .replace(/^\s*>\s*.*$/gm, '')
    .trim(),
).slice(0, 140);

const roomPayload: RoomPayload = {
  branches: roomBranches,
  games: roomGames,
  notices: roomNotices,
  latestNoticeAt: latestNotice?.data.publishedAt.toISOString(),
  gallery: roomGallery,
  tags: roomTags,
  profile: {
    name: profile.name,
    bio: profile.bio,
    avatar: thumbUrl(profile.avatar) ?? profile.avatar,
    skills: [...(introDoc?.data.skills ?? [])],
    links: profile.links.map((l) => ({ label: l.label })),
