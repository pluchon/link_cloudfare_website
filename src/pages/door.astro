        document.documentElement.dataset.palette = savedPal || 'ink';
      } catch (e) {
        document.documentElement.dataset.palette = 'ink';
      }
    </script>
  </head>
  <body>
    <!-- 开场加载画面「校准星图」：写在 HTML 里，页面一打开就有，不等脚本。
         外围为构建期静态天球赤经/赤纬坐标网与八大真实星座图谱，中心为正交同心五轨星盘；
         待 3D 黑洞、轨道探测器、引线标注与 HUD 全部编译渲染完成后才允许推进至 100% 并揭开 -->
    <div class="boot" data-boot role="progressbar" aria-label="正在校准星图" aria-valuemin="0" aria-valuemax="100">
      <!-- 全屏极坐标天球星图（赤经辐射线、赤纬圈、偏心黄道/银道弧与八大真实星座） -->
      <svg class="boot__cosmos" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {
          bootDecRadii.map((r, i) => (
            <circle
              class:list={['boot__dec', i % 2 === 1 && 'boot__dec--dash']}
              cx="800"
              cy="450"
              r={r}
            />
          ))
        }
        {
          bootRaLines.map((line) => (
            <g>
              <line
                class:list={['boot__ra', line.major && 'boot__ra--major']}
                x1={line.x1}
                y1={line.y1}
                x2={line.x2}
                y2={line.y2}
              />
              {line.hour && (
                <text class="boot__ra-label" x={line.lx} y={line.ly}>
                  {line.hour}
                </text>
              )}
            </g>
          ))
        }
        {
          bootDecLabels.map((d) => (
            <text class="boot__dec-label" x={d.x} y={d.y}>
              {d.deg}
            </text>
          ))
        }
        <g transform="rotate(-14 800 450)">
          <ellipse class="boot__ecliptic" cx="800" cy="450" rx="760" ry="185" />
          <ellipse class="boot__ecliptic boot__ecliptic--ticks" cx="800" cy="450" rx="766" ry="191" />
        </g>
        {bootBgStars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill={s.c} opacity={s.o} />)}
        {
          bootConstellations.map((c) => (
            <g class="boot__constellation">
              <text class="boot__const-name" x={c.lx} y={c.ly}>
                {c.name}
              </text>
              {c.lines.map(([a, b]) => (
                <line
                  class="boot__const-line"
                  x1={c.stars[a].x}
                  y1={c.stars[a].y}
                  x2={c.stars[b].x}
                  y2={c.stars[b].y}
                />
              ))}
              {c.stars.map((st) => (
                <g transform={`translate(${st.x} ${st.y})`} style={st.c ? `color: ${st.c}` : undefined}>
                  {st.ring && <circle class="boot__const-ring" r="6" />}
                  <circle class="boot__const-star" r={st.r} fill={st.c ?? '#e9e6f0'} />
                  {st.bayer && (
                    <text class="boot__const-bayer" x="6" y="-4">
                      {st.bayer}
                    </text>
                  )}
                </g>
              ))}
            </g>
          ))
        }
      </svg>
      <!-- 四周装饰：和门户 HUD 同一套语言，像观测站开机时的仪表 -->
      <div class="boot__frame" aria-hidden="true">
        <span class="boot__corner boot__corner--tl"></span>
        <span class="boot__corner boot__corner--tr"></span>
        <span class="boot__corner boot__corner--bl"></span>
        <span class="boot__corner boot__corner--br"></span>
        <span class="boot__tape boot__tape--top"></span>
        <span class="boot__tape boot__tape--left"></span>
        <span class="boot__tag boot__tag--tl">OBS-01 · 观测甲板</span>
        <span class="boot__tag boot__tag--tr">SYS · BOOT</span>
        <span class="boot__tag boot__tag--bl">RA 17h 45m 40s · DEC −29° 00′ 28″</span>
        <span class="boot__tag boot__tag--br" data-boot-link>LINK · STANDBY</span>
      </div>
      <!-- 中心同心正交星盘（Planisphere）：SGR A* 视界 + 60 格刻度校准环 + 五轨分类星盘 -->
      <svg class="boot__chart" viewBox="-220 -175 440 350" aria-hidden="true">
        <path class="boot__cross" d="M -152 0 H -68 M 68 0 H 152 M 0 -152 V -68 M 0 68 V 152"></path>
        {bootOrbitRingRadii.map((r) => <circle class="boot__ring" r={r} />)}
        <polyline class="boot__lines" data-boot-lines points={bootOrbitPolygon}></polyline>
        {
          bootOrbits.map((o, i) => (
            <g class="boot__orbit-node" data-boot-star={i} style={`--probe-tint: ${o.tint}`}>
              <line class="boot__sightline" x1={o.ix} y1={o.iy} x2={o.x} y2={o.y} />
              <g transform={`translate(${o.x} ${o.y})`}>
                <circle class="boot__node-ring" r="6" />
                <circle class="boot__star" r="2.6" />
                <text class="boot__node-code" x={o.dx} y={o.dy} text-anchor={o.anchor}>
                  {o.label}
                </text>
              </g>
            </g>
          ))
        }
        <circle class="boot__ticks" r="60"></circle>
        <circle class="boot__dial" r="52"></circle>
        <circle class="boot__arc" data-boot-arc r="52" transform="rotate(-90)"></circle>
        <circle class="boot__glow" r="32"></circle>
        <circle class="boot__horizon" r="28"></circle>
      </svg>
      <p class="boot__label">正在校准星图 · <span data-boot-pct>0%</span></p>
      <p class="boot__sub">STAR CHART CALIBRATION</p>
      <p class="boot__stage" data-boot-stage>01/05 · 锁定人马座 A* 历表</p>
    </div>
    <script is:inline>
      // 开场加载的进度：严格锁定在 95% 以内，直到 3D 场景着色器编译、字体测量并完成首轮完整画面渲染合成后，
      // 才会通过 window.__boot.done() 走完 100% 并渐隐收起。
      (function () {
        var root = document.querySelector('[data-boot]');
        if (!root) return;
        var arc = root.querySelector('[data-boot-arc]');
        var lines = root.querySelector('[data-boot-lines]');
        var stars = root.querySelectorAll('[data-boot-star]');
        var stageEl = root.querySelector('[data-boot-stage]');
        var linkTag = root.querySelector('[data-boot-link]');
        var pct = root.querySelector('[data-boot-pct]');
        var CIRC = 2 * Math.PI * 52;
        var LINE = lines && lines.getTotalLength ? lines.getTotalLength() : 620;
        var THRESHOLDS = [0.12, 0.32, 0.55, 0.73, 0.88];
        arc.style.strokeDasharray = CIRC;
        if (lines) lines.style.strokeDasharray = LINE;
        var stages = [
          [0, '01/05 · 锁定人马座 A* 历表'],
          [0.32, '02/05 · 编译引力透镜着色器'],
          [0.58, '03/05 · 同步五轨探测器信标'],
          [0.82, '04/05 · 校准斯隆长城深空星图'],
          [0.985, '05/05 · 观测甲板就绪'],
        ];
        var shown = 0;
        var floor = 0;
        var cap = 0.22;
        var done = false;
        var finishing = false;
        var lastStage = '';
        var lastPct = -1;
        var last = performance.now();
        function paint() {
          var ratio = done ? shown : Math.min(shown, 0.95);
          arc.style.strokeDashoffset = CIRC * (1 - ratio);
          if (lines) {
            var polyRatio = Math.max(0, Math.min((ratio - 0.12) / 0.88, 1));
            lines.style.strokeDashoffset = LINE * (1 - polyRatio);
          }
          for (var i = 0; i < stars.length; i++) stars[i].classList.toggle('on', ratio >= THRESHOLDS[i]);
          var stageText = stages[0][1];
          for (var k = 0; k < stages.length; k++) {
            if (ratio >= stages[k][0]) stageText = stages[k][1];
          }
          if (stageEl && stageText !== lastStage) {
            lastStage = stageText;
            stageEl.textContent = stageText;
          }
          var p = done && ratio >= 0.996 ? 100 : Math.min(Math.round(ratio * 100), 95);
          if (p !== lastPct) {
            lastPct = p;
            pct.textContent = p + '%';
            root.setAttribute('aria-valuenow', p);
          }
        }
        function tick() {
          var now = performance.now();
          var dt = Math.min((now - last) / 1000, 0.25);
          last = now;
          var ceiling = done ? 1 : Math.min(cap, 0.95);
          var goal = Math.max(floor, shown + (ceiling - shown) * Math.min(dt * (done ? 1.8 : 0.6), 1));
          shown += (goal - shown) * Math.min(dt * (done ? 11 : 5), 1);
          if (!done) shown = Math.min(shown, 0.95);
          if (done && 1 - shown < 0.004) {
            shown = 1;
            paint();
            if (!finishing) {
              finishing = true;
              if (linkTag) linkTag.textContent = 'LINK · ONLINE';
              setTimeout(function () {
                root.dataset.state = 'done';
                setTimeout(function () {
                  root.hidden = true;
                }, 700);
              }, 120);
            }
            return;
          }
          paint();
          requestAnimationFrame(tick);
        }
        window.__boot = {
          reach: function (value, nextCap) {
            floor = Math.max(floor, Math.min(value, 0.95));
            cap = Math.max(cap, Math.min(nextCap || value, 0.95));
          },
          done: function () {
            if (done) return;
            floor = 1;
            cap = 1;
            done = true;
          },
        };
        document.addEventListener('DOMContentLoaded', function () {
          window.__boot.reach(0.18, 0.42);
        });
        setTimeout(window.__boot.done, 15000);
        requestAnimationFrame(tick);
      })();
    </script>

    <canvas class="stage" data-stage tabindex="0" aria-label="黑洞场景：按住拖动换视角，双击回到甲板，点击黑洞进入"></canvas>

    <div class="vignette" data-vignette aria-hidden="true"></div>

    <!-- 右上角实时微缩斯隆长城星图窗（基地时直接展示星图画面；进入具体黑洞星系后标注所在位置并显示 ← 返回斯隆长城） -->
    <button
      type="button"
      class="starmap-mini"
      data-starmap-mini
      data-mode="deck"
      aria-label="进入斯隆长城星图"
    >
