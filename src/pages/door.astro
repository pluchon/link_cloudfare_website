      /* 开场加载画面「校准星图」：和跃迁后的网格加载画面是两种主题，
         这边是观测站开机校准，那边是穿越之后的数据流 */
      .boot {
        position: fixed;
        inset: 0;
        z-index: 2147483600;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        /* 几圈很淡的同心圆，像射电望远镜的扫描环 */
        background:
          repeating-radial-gradient(circle at center, transparent 0 119px, rgba(143, 212, 255, 0.05) 119px 120px),
          radial-gradient(ellipse at center, #0a0f20 0%, #020308 70%);
        transition: opacity 700ms ease;
      }

      .boot__frame {
        position: absolute;
        inset: 0;
        pointer-events: none;
        font-family: var(--door-din);
        font-size: 0.6rem;
        letter-spacing: 0.32em;
        color: rgba(233, 230, 240, 0.45);
      }

      .boot__corner {
        position: absolute;
        width: 1.4rem;
        height: 1.4rem;
        border: 0 solid rgba(233, 230, 240, 0.4);
      }

      .boot__corner--tl { left: 1.25rem; top: 1.25rem; border-left-width: 1px; border-top-width: 1px; }
      .boot__corner--tr { right: 1.25rem; top: 1.25rem; border-right-width: 1px; border-top-width: 1px; }
      .boot__corner--bl { left: 1.25rem; bottom: 1.25rem; border-left-width: 1px; border-bottom-width: 1px; }
      .boot__corner--br { right: 1.25rem; bottom: 1.25rem; border-right-width: 1px; border-bottom-width: 1px; }

      /* 刻度带：长短刻度交替，两头渐隐 */
      .boot__tape {
        position: absolute;
        background-repeat: repeat;
      }

      .boot__tape--top {
        left: 50%;
        top: 1.25rem;
        width: min(28rem, 60vw);
        height: 0.7rem;
        transform: translateX(-50%);
        background-image:
          linear-gradient(to right, rgba(233, 230, 240, 0.4) 1px, transparent 1px),
          linear-gradient(to right, rgba(233, 230, 240, 0.18) 1px, transparent 1px);
        background-size:
          40px 100%,
          8px 45%;
        background-repeat: repeat-x;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
      }

      .boot__tape--left {
        left: 1.25rem;
        top: 50%;
        width: 0.7rem;
        height: min(20rem, 40vh);
        transform: translateY(-50%);
        background-image:
          linear-gradient(to bottom, rgba(233, 230, 240, 0.4) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(233, 230, 240, 0.18) 1px, transparent 1px);
        background-size:
          100% 40px,
          45% 8px;
        background-repeat: repeat-y;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
        mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
      }

      .boot__tag {
        position: absolute;
        white-space: nowrap;
      }

      .boot__tag--tl { left: 3.25rem; top: 1.45rem; color: rgba(143, 212, 255, 0.7); }
      .boot__tag--tr { right: 3.25rem; top: 1.45rem; }
      .boot__tag--bl { left: 3.25rem; bottom: 1.4rem; font-family: var(--door-mono); letter-spacing: 0.12em; color: rgba(255, 196, 120, 0.55); }
      .boot__tag--br { right: 3.25rem; bottom: 1.4rem; }

      @media (max-width: 40rem) {
        .boot__tape--top,
        .boot__tape--left,
        .boot__tag--bl {
          display: none;
        }

        .boot__tag--tl { left: 2.65rem; }
        .boot__tag--tr,
        .boot__tag--br { right: 2.65rem; }
      }

      .boot[data-state='done'] {
        opacity: 0;
        pointer-events: none;
      }

      .boot p {
        margin: 0;
      }

      .boot__chart {
        width: min(24rem, 78vw);
        height: auto;
        overflow: visible;
      }

      .boot__lines {
        fill: none;
        stroke: rgba(143, 212, 255, 0.35);
        stroke-width: 1;
      }

      .boot__star {
        fill: rgba(233, 230, 240, 0.18);
        transition:
          fill 400ms ease,
          filter 400ms ease;
      }

      .boot__star.on {
        fill: #f2efe6;
        filter: drop-shadow(0 0 4px rgba(255, 230, 190, 0.9));
      }

      .boot__dial {
        fill: none;
        stroke: rgba(233, 230, 240, 0.14);
        stroke-width: 1;
      }

      /* 60 格刻度：用虚线画在一圈圆上 */
      .boot__ticks {
        fill: none;
        stroke: rgba(233, 230, 240, 0.32);
        stroke-width: 5;
        stroke-dasharray: 0.8 7.79;
      }

      .boot__arc {
        fill: none;
        stroke: #ffc27a;
        stroke-width: 1.6;
        stroke-linecap: round;
        filter: drop-shadow(0 0 3px rgba(255, 194, 122, 0.8));
      }

      .boot__glow {
        fill: none;
        stroke: rgba(255, 214, 160, 0.35);
        stroke-width: 6;
        filter: blur(4px);
      }

      .boot__horizon {
        fill: #000;
        stroke: rgba(255, 228, 190, 0.85);
        stroke-width: 1;
      }

      .boot__label {
        font-size: 0.85rem;
        letter-spacing: 0.32em;
        color: rgba(233, 230, 240, 0.85);
      }

      .boot__label span {
        font-family: var(--door-mono);
        letter-spacing: 0.12em;
        color: #ffc27a;
      }

      .boot__sub {
        font-family: var(--door-din);
        font-size: 0.6rem;
        letter-spacing: 0.5em;
        color: rgba(143, 212, 255, 0.6);
      }

      /* 加载画面：底、地面、四角和进度槽在 warp.css；这里只管进度条本身和上下两行字 */
      .warp {
        --warp-track: rgba(233, 230, 240, 0.15);
        position: fixed;
        inset: 0;
        z-index: 2147483640;
        opacity: 0;
        transition: opacity var(--door-dur);
      }

      .warp[data-state] {
        opacity: 1;
      }

      .warp__fill {
        position: fixed;
        z-index: 2147483647;
        left: 50%;
        top: 50%;
        width: min(18rem, 60vw);
        height: 2px;
        margin: -1px 0 0 calc(min(18rem, 60vw) / -2);
        background: rgba(233, 230, 240, 0.9);
        transform-origin: left center;
        transform: scaleX(0);
      }

      .warp__label,
      .warp__pct {
        position: fixed;
        z-index: 2147483647;
        left: 0;
        right: 0;
        text-align: center;
        font-family: var(--door-mono);
        letter-spacing: 0.24em;
        transition: opacity var(--door-dur);
      }

      .warp__label {
        bottom: calc(50% + 1.1rem);
        font-size: 0.72rem;
        color: rgba(233, 230, 240, 0.8);
      }

      .warp__pct {
        top: calc(50% + 1rem);
        font-size: 0.66rem;
        color: rgba(143, 212, 255, 0.8);
      }

      .warp[data-state='done'] .warp__label,
      .warp[data-state='done'] .warp__pct {
        opacity: 0;
      }

      /* 探测器终端：停靠后从左侧（探测器那边）展开 */
      .terminal {
        --probe-tint: #8fd4ff;
        position: fixed;
        z-index: 2;
        right: clamp(1.5rem, 6vw, 6rem);
        top: 50%;
        width: min(32rem, 43vw);
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 1.05rem 1.3rem 1.1rem;
        box-sizing: border-box;
        color: var(--door-ink);
        text-decoration: none;
        border: 1px solid rgba(143, 212, 255, 0.36);
        background:
          repeating-linear-gradient(to bottom, rgba(143, 212, 255, 0.04) 0 1px, transparent 1px 3px),
          rgba(3, 8, 18, 0.84);
        transform-origin: left center;
        transform: translateY(-50%) perspective(1400px) rotateY(-10deg) scaleX(0.04);
        opacity: 0;
        cursor: pointer;
        transition:
          transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1),
          opacity 320ms,
          border-color var(--door-dur);
      }

      /* 四角精密 L 型角标，跟随当前探测器的信标色 */
      .terminal__corner {
        position: absolute;
        width: 0.75rem;
        height: 0.75rem;
        border: 0 solid var(--probe-tint);
        pointer-events: none;
        opacity: 0.88;
      }

      .terminal__corner--tl {
        left: -1px;
        top: -1px;
        border-left-width: 2px;
        border-top-width: 2px;
      }

      .terminal__corner--tr {
        right: -1px;
        top: -1px;
        border-right-width: 2px;
        border-top-width: 2px;
      }

      .terminal__corner--bl {
        left: -1px;
        bottom: -1px;
        border-left-width: 2px;
        border-bottom-width: 2px;
      }

      .terminal__corner--br {
        right: -1px;
        bottom: -1px;
        border-right-width: 2px;
        border-bottom-width: 2px;
      }

      /* 左侧指向探测器的遥测引线与标尺锚点 */
      .terminal__tether {
        position: absolute;
        left: -2.2rem;
        top: 50%;
        width: 2.2rem;
        height: 1px;
        background: var(--probe-tint);
        opacity: 0.55;
        pointer-events: none;
      }

      .terminal__tether::before {
        content: '';
        position: absolute;
        left: 0;
        top: -3px;
        width: 5px;
        height: 5px;
        border: 1px solid var(--probe-tint);
        background: #020308;
      }

      .terminal[data-state='open'] {
        opacity: 1;
        transform: translateY(-50%) perspective(1400px) rotateY(-10deg) scaleX(1);
      }

      .terminal[data-state='open']:hover {
        border-color: var(--probe-tint);
      }

      .terminal__bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        font-family: var(--door-mono);
        font-size: 0.62rem;
        letter-spacing: 0.15em;
        color: rgba(143, 212, 255, 0.88);
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(143, 212, 255, 0.24);
      }

      .terminal__bar-left {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 0;
      }

      .terminal__dot {
        width: 6px;
        height: 6px;
        background: var(--probe-tint);
        flex: none;
      }

      .terminal__orbit {
        padding-left: 0.55rem;
        border-left: 1px solid rgba(233, 230, 240, 0.22);
        color: rgba(233, 230, 240, 0.62);
      }

      .terminal__bar-right {
        color: var(--probe-tint);
        white-space: nowrap;
      }

      /* 分类名靠左，介绍靠右 */
      .terminal__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.9rem;
      }

      .terminal__title-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .terminal__accent {
        width: 2px;
        height: 1.25rem;
        background: var(--probe-tint);
        flex: none;
      }

      .terminal__title {
        font-size: 1.48rem;
        letter-spacing: 0.14em;
      }

      .terminal__desc {
        font-size: 0.76rem;
        text-align: right;
        opacity: 0.62;
      }

      .terminal__list {
        display: flex;
        flex-direction: column;
      }

      /* 每篇一条：左边封面，右边编号+标题和日期一行、简介在下面最多两行 */
      .terminal__item {
        display: grid;
        grid-template-columns: 5.4rem 1fr;
        gap: 0.85rem;
        align-items: center;
        padding: 0.6rem 0.35rem;
        border-top: 1px solid rgba(233, 230, 240, 0.12);
        transition: background-color var(--door-dur), border-color var(--door-dur);
      }

      .terminal__item:hover {
        background: rgba(143, 212, 255, 0.06);
      }

      .terminal__cover {
        width: 5.4rem;
        height: 3.4rem;
        object-fit: cover;
        box-sizing: border-box;
        border: 1px solid rgba(233, 230, 240, 0.22);
        background: rgba(143, 212, 255, 0.08);
      }

      .terminal__meta {
        display: flex;
        flex-direction: column;
        gap: 0.28rem;
        min-width: 0;
      }

      .terminal__row {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        min-width: 0;
      }

      .terminal__idx {
        flex: none;
        font-family: var(--door-mono);
        font-size: 0.6rem;
        letter-spacing: 0.08em;
        color: var(--probe-tint);
        opacity: 0.85;
      }

      .terminal__name {
        flex: 1;
        min-width: 0;
        font-size: 0.88rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .terminal__date {
        flex: none;
        font-family: var(--door-mono);
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        opacity: 0.55;
      }

      .terminal__summary {
        font-size: 0.74rem;
        line-height: 1.58;
        opacity: 0.64;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .terminal__empty {
        font-size: 0.8rem;
        opacity: 0.5;
      }

      .terminal__go {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid rgba(255, 196, 120, 0.38);
        background: rgba(255, 196, 120, 0.05);
        font-family: var(--door-mono);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        color: rgba(255, 206, 136, 0.96);
        transition: border-color var(--door-dur), background-color var(--door-dur);
      }

      .terminal[data-state='open']:hover .terminal__go {
        border-color: rgba(255, 206, 136, 0.85);
        background: rgba(255, 196, 120, 0.11);
      }

      .terminal__go-code {
        font-family: var(--door-din);
        font-size: 0.58rem;
        letter-spacing: 0.24em;
        color: rgba(233, 230, 240, 0.58);
      }

      .terminal__go-arrow {
        font-family: var(--door-mono);
        color: var(--probe-tint);
      }

      /* 四周装饰 */
      .hud {
        position: fixed;
        inset: 0;
        pointer-events: none;
        font-family: var(--door-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
      }

      .hud__corner {
        position: absolute;
        width: 1.4rem;
        height: 1.4rem;
        border: 0 solid var(--door-line);
      }

      .hud__corner--tl {
        left: 1.25rem;
        top: 1.25rem;
        border-left-width: 1px;
        border-top-width: 1px;
      }

      .hud__corner--tr {
        right: 1.25rem;
        top: 1.25rem;
        border-right-width: 1px;
        border-top-width: 1px;
      }

      .hud__corner--bl {
        left: 1.25rem;
        bottom: 1.25rem;
        border-left-width: 1px;
        border-bottom-width: 1px;
      }

      .hud__corner--br {
        right: 1.25rem;
        bottom: 1.25rem;
        border-right-width: 1px;
        border-bottom-width: 1px;
      }

      /* 方位刻度带：长短刻度交替，背景位置跟着镜头方位滑动 */
      .hud__tape--heading {
        position: absolute;
        left: 50%;
        top: 1.25rem;
        width: min(28rem, 60vw);
        height: 0.7rem;
        transform: translateX(-50%);
        background-image:
          linear-gradient(to right, var(--door-line) 1px, transparent 1px),
          linear-gradient(to right, rgba(233, 230, 240, 0.18) 1px, transparent 1px);
        background-size:
          40px 100%,
          8px 45%;
        background-repeat: repeat-x;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
      }

      .hud__caret {
        position: absolute;
        left: 50%;
        top: 2.3rem;
        width: 0;
        height: 0.5rem;
        border-left: 1px solid var(--door-ink);
      }

      /* 俯仰刻度：贴着左边 */
      .hud__tape--pitch {
        position: absolute;
        left: 1.25rem;
        top: 50%;
        width: 0.7rem;
        height: min(20rem, 40vh);
        transform: translateY(-50%);
        background-image:
          linear-gradient(to bottom, var(--door-line) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(233, 230, 240, 0.18) 1px, transparent 1px);
        background-size:
          100% 40px,
          45% 8px;
        background-repeat: repeat-y;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
        mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
      }

      .hud__read {
        position: absolute;
        opacity: 0.6;
        white-space: nowrap;
      }

      .hud__read--tr {
        left: 3.25rem;
        top: 1.45rem;
      }

      .hud__read--bl {
        left: 3.25rem;
        bottom: 1.4rem;
      }

      .hud__read--br {
        right: 3.25rem;
        bottom: 1.4rem;
      }

      /* 操作引导：三块遥测仪表小面板，带角标、通道编号与扫描线底纹，随当前视角状态联动 */
      .guide {
        position: absolute;
        left: 50%;
        bottom: 1.25rem;
        width: min(44.5rem, calc(100vw - 4.5rem));
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.65rem;
        margin: 0;
        padding: 0;
        list-style: none;
        transform: translateX(-50%);
        transition: opacity var(--door-dur);
      }

      /* 穿越视界时不留在画面上 */
      .guide[data-mode='diving'],
      .guide[data-mode='warping'] {
        opacity: 0;
      }

      .guide__item {
        position: relative;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding: 0.55rem 0.85rem 0.65rem;
        border: 1px solid rgba(143, 212, 255, 0.32);
        background:
          repeating-linear-gradient(to bottom, rgba(143, 212, 255, 0.032) 0 1px, transparent 1px 3px),
          rgba(4, 10, 20, 0.72);
        transition:
          opacity var(--door-dur),
          border-color var(--door-dur);
      }

      /* 对角精密 L 型角标 */
      .guide__item::before,
      .guide__item::after {
        content: '';
        position: absolute;
        width: 0.45rem;
        height: 0.45rem;
        border: 0 solid rgba(143, 212, 255, 0.75);
        pointer-events: none;
      }

      .guide__item::before {
        left: -1px;
        top: -1px;
        border-left-width: 1px;
        border-top-width: 1px;
      }

      .guide__item::after {
        right: -1px;
        bottom: -1px;
        border-right-width: 1px;
        border-bottom-width: 1px;
      }

      /* 甲板模式下尚未离开甲板，第三块「双击飞回甲板」处于半透明待命态；离开甲板或对接后高亮激活 */
      .guide[data-mode='deck'] .guide__item--recall {
        opacity: 0.52;
      }

      /* 操作引导文字随当前模式切换（基地 / 深空星图 / 星系黑洞） */
      .guide__desc--map,
      .guide__desc--galaxy,
      .guide__title--map,
      .guide__title--galaxy {
        display: none;
      }

      .guide[data-mode='starmap'] .guide__desc--base,
      .guide[data-mode='enteringMap'] .guide__desc--base,
      .guide[data-mode='starmap'] .guide__title--base,
      .guide[data-mode='enteringMap'] .guide__title--base,
      .guide[data-mode='galaxy'] .guide__desc--base,
      .guide[data-mode='flyingGalaxy'] .guide__desc--base,
      .guide[data-mode='galaxy'] .guide__title--base,
      .guide[data-mode='flyingGalaxy'] .guide__title--base {
        display: none;
      }

      .guide[data-mode='starmap'] .guide__desc--map,
      .guide[data-mode='enteringMap'] .guide__desc--map,
      .guide[data-mode='starmap'] .guide__title--map,
      .guide[data-mode='enteringMap'] .guide__title--map {
        display: block;
      }

      .guide[data-mode='galaxy'] .guide__desc--galaxy,
      .guide[data-mode='flyingGalaxy'] .guide__desc--galaxy,
      .guide[data-mode='galaxy'] .guide__title--galaxy,
      .guide[data-mode='flyingGalaxy'] .guide__title--galaxy {
        display: block;
      }

      .guide[data-mode='free'] .guide__item--recall,
      .guide[data-mode='leaving'] .guide__item--recall,
      .guide[data-mode='docked'] .guide__item--recall,
      .guide[data-mode='starmap'] .guide__item--recall,
      .guide[data-mode='galaxy'] .guide__item--recall {
        border-color: rgba(255, 196, 120, 0.55);
      }

      .guide[data-mode='free'] .guide__item--recall .guide__dot,
      .guide[data-mode='leaving'] .guide__item--recall .guide__dot,
      .guide[data-mode='docked'] .guide__item--recall .guide__dot,
      .guide[data-mode='starmap'] .guide__item--recall .guide__dot,
      .guide[data-mode='galaxy'] .guide__item--recall .guide__dot {
        background: #ffc27a;
      }

      .guide[data-mode='free'] .guide__item--recall .guide__state,
      .guide[data-mode='leaving'] .guide__item--recall .guide__state,
      .guide[data-mode='docked'] .guide__item--recall .guide__state,
      .guide[data-mode='starmap'] .guide__item--recall .guide__state,
      .guide[data-mode='galaxy'] .guide__item--recall .guide__state {
        color: #ffc27a;
        border-color: rgba(255, 194, 122, 0.45);
      }

      .guide__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid rgba(143, 212, 255, 0.16);
        font-family: var(--door-din);
        font-size: 0.56rem;
        letter-spacing: 0.22em;
        color: rgba(143, 212, 255, 0.72);
      }

      .guide__code {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }

      .guide__dot {
        width: 4px;
        height: 4px;
        background: rgba(143, 212, 255, 0.85);
      }

      .guide__state {
        padding: 0.05rem 0.32rem;
        border: 1px solid rgba(143, 212, 255, 0.28);
        font-family: var(--door-mono);
        font-size: 0.52rem;
        letter-spacing: 0.14em;
        color: rgba(233, 230, 240, 0.72);
      }

      .guide__body {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
      }

      .guide__icon {
        flex: none;
        width: 1.5rem;
        height: 1.5rem;
        fill: none;
        stroke: rgba(143, 212, 255, 0.92);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .guide__text {
        display: flex;
        flex-direction: column;
        gap: 0.16rem;
        min-width: 0;
      }

      .guide__title {
        font-family: var(--door-serif);
        font-size: 0.96rem;
        letter-spacing: 0.08em;
        white-space: nowrap;
        color: var(--door-ink);
      }

      .guide__desc {
        font-family: var(--door-serif);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: rgba(233, 230, 240, 0.66);
      }

      /* 再窄就会撞上左右两个读数，整排抬到读数上面 */
      @media (max-width: 75rem) {
        .guide {
          bottom: 3.2rem;
        }
      }

      @media (max-width: 46rem) {
        .guide__desc-extra {
          display: none;
        }
      }

      /* 不支持 WebGL2：没有场景，黑洞引线的文字原地变成进入链接 */
      :global(.flat) .callout__label--hole {
        opacity: 1;
        transform: translate(clamp(1.5rem, 6vw, 6rem), 60vh);
      }

      :global(.flat) .guide {
        display: none;
      }

      @media (max-width: 40rem) {
        .hud__tape--pitch {
          display: none;
        }

        .hud__tape--heading {
          width: min(13rem, 38vw);
        }

        .hud__read {
          font-size: 0.64rem;
          letter-spacing: 0.1em;
        }

        .hud__read--tr {
          left: 2.65rem;
          top: 1.38rem;
        }

        .hud__read--bl {
          left: 2.65rem;
          bottom: 1.35rem;
        }

        .hud__read--br {
          right: 2.65rem;
          bottom: 1.35rem;
        }

        /* 手机上三块面板等宽并排，图标在上；终端从底部展开时收起，免得从它下面露出来 */
        .guide {
          bottom: 3.1rem;
          width: calc(100vw - 2.5rem);
          gap: 0.55rem;
        }

        .guide[data-mode='docking'],
        .guide[data-mode='docked'] {
          opacity: 0;
        }

        .guide__head {
          display: none;
        }

        .guide__item {
          padding: 0.6rem 0.4rem 0.65rem;
        }

        .guide__body {
          flex-direction: column;
          gap: 0.38rem;
          text-align: center;
        }

        .guide__text {
          width: 100%;
          align-items: center;
        }

        .guide__icon {
          width: 1.25rem;
          height: 1.25rem;
        }

        .guide__title {
          font-size: 0.8rem;
          letter-spacing: 0.04em;
        }

        .guide__desc {
          width: 100%;
          font-size: 0.65rem;
          letter-spacing: 0.02em;
        }

        .guide__desc-extra {
          display: none;
        }

        .starmap-mini {
          right: 1.05rem;
          left: auto;
          top: 2.15rem;
          width: 6.9rem;
          padding: 0.28rem 0.36rem;
          gap: 0.24rem;
        }

        .starmap-mini[data-mode='free'],
        .starmap-mini[data-mode='leaving'] {
          width: min(12.5rem, 50vw);
        }

        .starmap-mini[data-mode='galaxy'] {
          width: 8.4rem;
          padding: 0.32rem 0.4rem;
        }

        .starmap-mini__canvas {
          height: 2.15rem;
        }

        .starmap-mini[data-mode='free'] .starmap-mini__canvas,
        .starmap-mini[data-mode='leaving'] .starmap-mini__canvas {
          height: 4.2rem;
        }

        .starmap-mini[data-mode='galaxy'] .starmap-mini__canvas {
          height: 3.0rem;
        }

        .starmap-mini__enter-line,
        .starmap-mini__back-line {
          font-size: 0.56rem;
          letter-spacing: 0.1em;
          padding-top: 0.22rem;
        }

        .starmap-scale {
          right: 0.6rem;
          top: calc(50% + 1.4rem);
        }

        .starmap-scale__track {
          width: 2.2rem;
          height: min(10.2rem, 27vh);
        }

        .starmap-plaque {
          left: 1.2rem;
          top: 3.6rem;
        }

        .starmap-plaque__eyebrow {
          font-size: 0.52rem;
          letter-spacing: 0.2em;
        }

        .starmap-plaque__title {
          margin-top: 0.4rem;
          font-size: 1.24rem;
          letter-spacing: 0.14em;
        }

        .starmap-plaque__meta {
          margin-top: 0.5rem !important;
          font-size: 0.52rem;
          letter-spacing: 0.1em;
        }

        .copy {
          top: 7.4rem;
          right: 1.5rem;
        }

        .copy__title {
          letter-spacing: 0.1em;
        }

        .copy__eyebrow {
          gap: 0.6rem;
          letter-spacing: 0.28em;
        }

        .copy__eyebrow i,
        .copy__rule i:first-child {
          width: 1.5rem;
        }

        .copy__rule {
          gap: 0.7rem;
          letter-spacing: 0.22em;
        }

        .copy__rule i:last-child {
          width: 2.5rem;
        }

        .copy__en,
        .copy__coord {
          display: none;
        }

        /* 手机上终端从底部展开，占满宽度 */
        .terminal {
          left: 1rem;
          right: 1rem;
          top: auto;
          bottom: 4rem;
          width: auto;
          transform-origin: center bottom;
          transform: scaleY(0.04);
        }

        .terminal__tether,
        .terminal__orbit,
        .terminal__go-code {
          display: none;
        }

        .terminal[data-state='open'] {
          transform: none;
        }

        .terminal__desc {
          display: none;
        }
      }
    </style>

    <script>
      import { mountDoor, supportsWebGL2 } from '../door/scene';
      import { AZIMUTH_LABELS, STAR_NODES } from '../door/starmap';

      // 开场加载画面的进度（定义在页面开头的内联脚本里）。
      // 跑到这里说明 three.js 和场景脚本已经下载并执行了
      type Boot = { reach: (value: number, nextCap?: number) => void; done: () => void };
      const boot = (window as unknown as { __boot?: Boot }).__boot;
      boot?.reach(0.5, 0.75);

      const pick = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
      const tag = (id: string) => ({
        line: pick<SVGPolylineElement>(`[data-tag-line="${id}"]`),
        dot: pick<SVGCircleElement>(`[data-tag-dot="${id}"]`),
        label: pick<HTMLElement>(`[data-tag-label="${id}"]`),
      });
      const starTag = (id: string) => ({
        line: pick<SVGPolylineElement>(`[data-star-line="${id}"]`),
        dot: pick<SVGCircleElement>(`[data-star-dot="${id}"]`),
        label: pick<HTMLElement>(`[data-star-label="${id}"]`),
      });
      // 顺序要和 scene.ts 里的 PROBE_ORBITS 对应：由近到远
      const probes = ['project', 'tool', 'explore', 'daily', 'xiaomeng'].map((key) => ({
        key,
        label: pick<HTMLElement>(`[data-terminal="${key}"] .terminal__title`).textContent ?? key,
        href: `/${key}/`,
        tag: tag(key),
        terminal: pick<HTMLElement>(`[data-terminal="${key}"]`),
      }));

      if (supportsWebGL2()) {
        mountDoor({
          canvas: pick<HTMLCanvasElement>('[data-stage]'),
          target: '/',
          veil: pick<HTMLElement>('[data-veil]'),
          copy: pick<HTMLElement>('[data-copy]'),
          hole: tag('hole'),
          base: tag('base'),
          probes,
          starmap: {
            miniBtn: pick<HTMLButtonElement>('[data-starmap-mini]'),
            miniCanvas: pick<HTMLCanvasElement>('[data-starmap-preview]'),
            layer: pick<HTMLElement>('[data-starmap-layer]'),
            nodeTags: STAR_NODES.map((n) => ({ id: n.id, tag: starTag(n.id) })),
            azimuthLabels: AZIMUTH_LABELS.map((_, i) => pick<HTMLElement>(`[data-azimuth-label="${i}"]`)),
            scaleRoot: pick<HTMLElement>('[data-starmap-scale]'),
            scaleTrack: pick<HTMLElement>('[data-starmap-track]'),
            scaleThumb: pick<HTMLElement>('[data-starmap-thumb]'),
            barCode: pick<HTMLElement>('[data-star-bar-code]'),
            barTitle: pick<HTMLElement>('[data-star-bar-title]'),
            barMeta: pick<HTMLElement>('[data-star-bar-meta]'),
          },
          loader: {
            root: pick<HTMLElement>('[data-warp]'),
            floor: pick<HTMLElement>('[data-warp-floor]'),
            fill: pick<HTMLElement>('[data-warp-fill]'),
            label: pick<HTMLElement>('[data-warp-label]'),
            pct: pick<HTMLElement>('[data-warp-pct]'),
          },
          hud: {
            distance: pick<HTMLElement>('[data-distance]'),
            heading: pick<HTMLElement>('[data-heading]'),
            view: pick<HTMLElement>('[data-view]'),
            headingTape: pick<HTMLElement>('[data-heading-tape]'),
            pitchTape: pick<HTMLElement>('[data-pitch-tape]'),
            guide: pick<HTMLElement>('[data-guide]'),
          },
          // 着色器编译完、第一帧画出来，加载画面收起
          onReady: () => boot?.done(),
        });
        // 场景已经搭好，剩下的是着色器编译
        boot?.reach(0.8, 0.96);
      } else {
        // 不支持 WebGL2：没有场景，引线文字原地变成进入链接
        document.documentElement.classList.add('flat');
        boot?.done();
      }
    </script>
  </body>
</html>
