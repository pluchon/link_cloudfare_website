// 开场天球星图背景（构建期确定性生成，运行期零重绘开销）
const bootRng = ((seed: number) => {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 4294967296;
  };
})(20261119);
const bootSpectra = ['#f4f1ea', '#b9deff', '#ffd59e'];
const bootBgStars = Array.from({ length: 128 }, (_, i) => {
  const x = 28 + bootRng() * 1544;
  const bandY = 450 + (x - 800) * -0.249;
  const inBand = i % 10 < 6;
  let y = inBand ? bandY + (bootRng() + bootRng() - 1) * 260 : 28 + bootRng() * 844;
  if (Math.hypot(x - 800, y - 450) < 185) {
    y = y < 450 ? y - 190 : y + 190;
  }
  const mag = bootRng();
  const r = Number((0.6 + Math.pow(mag, 2.2) * 1.15).toFixed(2));
  const o = Number((0.2 + mag * 0.56).toFixed(2));
  const c = bootSpectra[Math.floor(bootRng() * bootSpectra.length)];
  return { x: Math.round(x), y: Math.round(Math.min(Math.max(y, 24), 876)), r, o, c };
});

// 全屏极坐标天球坐标网：6 圈赤纬同心圆 + 24 条赤经辐射线（中心 r < 186 留空给主星盘）
const bootDecRadii = [210, 310, 420, 540, 670, 810];
const bootDecLabels = [
  { deg: '−15°', r: 210 },
  { deg: '−30°', r: 310 },
  { deg: '−45°', r: 420 },
  { deg: '−60°', r: 540 },
].map((item) => {
  const rad = (42 * Math.PI) / 180;
  return {
    deg: item.deg,
    x: Number((800 + Math.cos(rad) * (item.r + 8)).toFixed(1)),
    y: Number((450 + Math.sin(rad) * (item.r + 8)).toFixed(1)),
  };
});

const bootRaLines = Array.from({ length: 24 }, (_, i) => {
  const deg = i * 15;
  const rad = ((deg - 90) * Math.PI) / 180;
  const c = Math.cos(rad);
  const s = Math.sin(rad);
  const hour = String(i).padStart(2, '0') + 'h';
  return {
    x1: Number((800 + c * 186).toFixed(1)),
    y1: Number((450 + s * 186).toFixed(1)),
    x2: Number((800 + c * 920).toFixed(1)),
    y2: Number((450 + s * 920).toFixed(1)),
    major: i % 2 === 0,
    lx: Number((800 + c * 324).toFixed(1)),
    ly: Number((450 + s * 324 + 3).toFixed(1)),
    hour: i % 2 === 0 ? hour : '',
  };
});

