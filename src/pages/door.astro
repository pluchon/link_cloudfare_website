// 中心同心正交星盘（Planisphere）：5 颗站点分类轨道信标，按顺时针校准弧依次扫过点亮
const bootOrbitRingRadii = [82, 108, 134];
const bootOrbits = [
  { deg: 42, r: 82, label: '01 · PROJECT', tint: probeMeta.project.tint, threshold: 0.12, anchor: 'start', dx: 11, dy: -8 },
  { deg: 116, r: 108, label: '02 · TOOL', tint: probeMeta.tool.tint, threshold: 0.32, anchor: 'start', dx: 11, dy: 4 },
  { deg: 198, r: 134, label: '03 · EXPLORE', tint: probeMeta.explore.tint, threshold: 0.55, anchor: 'end', dx: -11, dy: 9 },
  { deg: 262, r: 108, label: '04 · DAILY', tint: probeMeta.daily.tint, threshold: 0.73, anchor: 'end', dx: -11, dy: 3 },
  { deg: 318, r: 82, label: '05 · XIAOMENG', tint: probeMeta.xiaomeng.tint, threshold: 0.88, anchor: 'end', dx: -11, dy: -8 },
].map((item) => {
  const rad = ((item.deg - 90) * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  return {
    ...item,
    x: Number((cos * item.r).toFixed(1)),
    y: Number((sin * item.r).toFixed(1)),
    ix: Number((cos * 64).toFixed(1)),
    iy: Number((sin * 64).toFixed(1)),
  };
});
const bootOrbitPolygon = [...bootOrbits, bootOrbits[0]].map((o) => `${o.x},${o.y}`).join(' ');

// 穿过视界后的跃迁深空背景数据（构建期静态 SVG 生成，零外部请求、运行期零重绘）
const warpRng = ((seed: number) => {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 4294967296;
  };
})(19151125);

const warpStars = Array.from({ length: 185 }, (_, i) => {
  const x = 24 + warpRng() * 1552;
  const bandY = 450 + (x - 800) * -0.22;
  const inBand = i % 10 < 7;
  let y = inBand ? bandY + (warpRng() + warpRng() - 1) * 225 : 24 + warpRng() * 852;
  // 给正中央水平进度条与上下标题栏让出一块干净留白
  if (Math.abs(x - 800) < 235 && Math.abs(y - 450) < 58) {
    y = y < 450 ? 450 - 72 - warpRng() * 80 : 450 + 72 + warpRng() * 80;
  }
  const mag = warpRng();
  const r = Number((0.55 + Math.pow(mag, 2.3) * 1.2).toFixed(2));
  const o = Number((0.22 + mag * 0.62).toFixed(2));
  const c = bootSpectra[Math.floor(warpRng() * bootSpectra.length)];
  return { x: Math.round(x), y: Math.round(Math.min(Math.max(y, 18), 882)), r, o, c };
});

