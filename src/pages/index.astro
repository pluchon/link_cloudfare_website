        var seen = {};

        pairs.forEach(function (pair) {
          var key = pair[0].getAttribute('data-node') + '>' + pair[1].getAttribute('data-node');
          seen[key] = 1;

          var a = boxIn(pair[0], map);
          var b = boxIn(pair[1], map);
          var x1;
          var y1;
          var x2 = b.x;
          var y2 = b.y + b.h / 2;
