      flex-direction: column;
      align-items: stretch;
      width: auto;
      gap: 0.9rem;
      padding-inline: var(--gut);
      padding-bottom: 3rem;
      transform: none !important;
    }

    .branches,
    .leaves {
      gap: 0.9rem;
    }

    .row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }

    .branches,
    .leaves { padding-left: var(--indent); }

    .node--root,
    .node--branch,
