  .more__count {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .more__go {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .node--more:hover { transform: translateX(0.35rem); }
  .node--more:hover .more__count { color: var(--accent); }
  .node--more:hover .more__go { color: var(--accent); }

