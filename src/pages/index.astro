    display: grid;
    grid-template-columns: 42% minmax(0, 1fr);
    width: 29rem;
    align-items: stretch;
  }

  .node--leaf:hover { transform: translateX(0.35rem); }

  .leaf__cover {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 7.5rem;
    object-fit: cover;
    border-right: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .leaf__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.9rem 1rem;
    min-width: 0;
  }

  .leaf__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .leaf__title {
    margin-top: 0.3rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.45;
  }

  .node--leaf:hover .leaf__title { color: var(--accent); }

  .leaf__summary {
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 整卡可点：铺一层透明链接。按钮必须留在链接外面，
