  .node--tags {
    width: max-content;
    max-width: none;
    padding: 0.75rem 0.9rem;
  }

  .node--tags .tag-row {
    flex-wrap: wrap;
  }

  /* 标签自身不许断行，要断只在标签之间断 */
  .node--tags .tag {
    white-space: nowrap;
  }

  /* ---------- 展开按钮：两根线拼成的 + ---------- */

  .knob {
    position: absolute;
    right: -0.8rem;
    top: 50%;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: -0.8rem;
    padding: 0;
    border: var(--hair) solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg-muted);
    cursor: pointer;
    z-index: 3;
    transition: border-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }

  .knob:hover { border-color: var(--accent); color: var(--accent); }

  /* 绝对定位的子元素不受父级 place-items 影响，必须自己居中 */
  .knob__h,
  .knob__v {
