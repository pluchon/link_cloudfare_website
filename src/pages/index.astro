    }

    function init() {
      teardown();

      var canvas = document.querySelector('[data-canvas]');
      var scene = document.querySelector('[data-scene]');
      var map = document.querySelector('[data-map]');
      var wires = document.querySelector('[data-wires]');
      if (!canvas || !scene || !map || !wires) return;

      var wide = window.matchMedia('(min-width: 60.0625rem)').matches;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var tx = 0;
      var ty = 0;
      var minX = 0;
      var maxX = 0;
      var minY = 0;
      var maxY = 0;
      var dragging = false;
      var moved = 0;
      var startX = 0;
      var startY = 0;
      var originX = 0;
      var originY = 0;
      var scale = 1;
      var litCard = null;

      // null = 跟着自动适应走；一旦用户手动缩放就锁成具体倍率
      var userZoom = null;
      var ZOOM_MIN = 0.3;
      var ZOOM_MAX = 2;
      var zoombar = document.querySelector('[data-zoombar]');

      // 量盒子必须用未经 transform 的布局偏移。getBoundingClientRect 会把
      // 入场动画的 translateX 一起算进去，线就会短一截接不到卡片上
      function boxIn(el, root) {
        var x = 0;
        var y = 0;
        var node = el;
        while (node && node !== root) {
          x += node.offsetLeft;
          y += node.offsetTop;
          node = node.offsetParent;
