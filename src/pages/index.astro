      var ty = 0;
      var minX = 0;
      var maxX = 0;
      var minY = 0;
      var maxY = 0;
      var dragging = false;
      var moved = 0;
      var startX = 0;
      var startY = 0;
      var originX = 0;
      var originY = 0;
