---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EntryRow from '../components/EntryRow.astro';
import { site, home } from '../config/site';
import { getPublished, tagCounts } from '../lib/content';

const blog = await getPublished('blog');
const library = await getPublished('library');
const tags = tagCounts([...blog, ...library]).slice(0, 14);

const recentBlog = blog.slice(0, 5);
const recentLibrary = library.slice(0, 4);
const latest = blog[0] ?? library[0];
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__main">
        <p class="label">{site.tagline}</p>
        <h1 class="hero__title">{site.name}</h1>
        <p class="hero__intro">{home.intro}</p>
        <div class="hero__actions">
          <a class="text-link" href="/blog/">开始阅读</a>
          <a class="text-link" href="/about/">关于我</a>
        </div>
      </div>

      <aside class="hero__side">
        <dl class="stat">
          <div class="stat__row">
            <dt class="label">文章</dt>
            <dd>{String(blog.length).padStart(2, '0')}</dd>
          </div>
          <div class="stat__row">
            <dt class="label">资料</dt>
            <dd>{String(library.length).padStart(2, '0')}</dd>
          </div>
          <div class="stat__row">
            <dt class="label">话题</dt>
            <dd>{String(tagCounts([...blog, ...library]).length).padStart(2, '0')}</dd>
          </div>
        </dl>
        {
          latest && (
            <p class="hero__latest">
              <span class="label">最新</span>
              <a href={`/${blog[0] ? 'blog' : 'library'}/${latest.data.slug}/`}>
                {latest.data.title}
              </a>
            </p>
          )
        }
      </aside>
    </div>
  </section>

  <section class="wrap block">
    <SectionHeading label={home.sections.blog.label} title={home.sections.blog.title} />
    {
      recentBlog.length > 0 ? (
        <div class="entry-list">
          {recentBlog.map((entry) => (
            <EntryRow kind="blog" entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">还没有文章，往 src/content/blog/ 里放第一篇 Markdown 吧。</p>
      )
    }
    <p class="block__more"><a class="text-link" href="/blog/">{home.sections.blog.more}</a></p>
  </section>

  <section class="wrap block">
    <SectionHeading label={home.sections.library.label} title={home.sections.library.title} />
    {
      recentLibrary.length > 0 ? (
        <div class="entry-list">
          {recentLibrary.map((entry) => (
            <EntryRow kind="library" entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">资料区还空着。</p>
      )
    }
    <p class="block__more"><a class="text-link" href="/library/">{home.sections.library.more}</a></p>
  </section>

  {
    tags.length > 0 && (
      <section class="wrap block block--last">
        <SectionHeading label={home.sections.tags.label} title={home.sections.tags.title} />
        <div class="tag-row">
          {tags.map(({ tag, count }) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
              <span class="tag__count">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    border-bottom: var(--hair) solid var(--line);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: stretch;
    padding-block: clamp(3.5rem, 9vw, 7rem);
    gap: 0 clamp(2rem, 5vw, 4rem);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin: 1.1rem 0 0;
  }

  .hero__intro {
    max-width: 34em;
    margin: 1.5rem 0 0;
    color: var(--fg-muted);
    font-size: 1.0625rem;
    line-height: 1.9;
  }

  .hero__actions {
    display: flex;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    padding-left: clamp(1.5rem, 4vw, 3rem);
    border-left: var(--hair) solid var(--line);
  }

  .stat {
    margin: 0;
  }

  .stat__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: var(--hair) solid var(--line);
  }

  .stat__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--fg);
  }

  .hero__latest {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .hero__latest a:hover {
    color: var(--accent);
  }

  .block {
    padding-block: clamp(2.75rem, 6vw, 4.25rem);
    border-bottom: var(--hair) solid var(--line);
  }

  .block--last {
    border-bottom: 0;
  }

  .block__more {
    margin: 1.75rem 0 0;
  }

  .tag__count {
    margin-left: 0.4rem;
    color: var(--fg-faint);
  }

  @media (max-width: 52rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .hero__side {
      padding-left: 0;
      border-left: 0;
      border-top: var(--hair) solid var(--line);
      padding-top: 1.5rem;
    }
  }
</style>
