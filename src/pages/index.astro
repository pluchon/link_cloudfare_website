        if (card && card.classList.contains('node--shelf')) card = null;
        if (card !== litCard) clearGlow(litCard);
        litCard = card;
        if (!card) return;

        clearTimeout(card.__glowTimer);
        card.classList.add('is-lit');

        var r = card.getBoundingClientRect();
        var dx = event.clientX - r.left - r.width / 2;
        var dy = event.clientY - r.top - r.height / 2;
        // 只要指针在卡片上就整段亮起，光落在哪一侧仍由角度决定
        var angle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        if (angle < 0) angle += 360;

        card.style.setProperty('--glow', '1');
        card.style.setProperty('--glow-angle', angle.toFixed(1) + 'deg');
      }

      /* ---------- 平移与缩放 ---------- */

      function apply() {
        scene.style.transform = 'translate3d(' + tx + 'px,' + ty + 'px,0)';
        // 背景插画按平移量反方向挪一点点，做出纵深
        canvas.style.setProperty('--pan-x', tx + 'px');
        canvas.style.setProperty('--pan-y', ty + 'px');
      }

      // 展开的卡片多到一屏放不下时，整张图按比例缩小，最多缩到 45%（五个分类全展开在 900 高的屏上要 0.55 左右）
      function autoScale() {
        var s = Math.min(
          1,
          (canvas.clientWidth - 32) / map.offsetWidth,
          (scene.clientHeight - 32) / map.offsetHeight,
        );
        return Math.max(0.45, s);
      }

      // 宽屏的顶栏是浮在画布上的（半透明），导图要在顶栏以下的那块区域里居中、缩放，
      // 不然展开五个分类时第一张卡的上沿正好压在顶栏底下。窄屏是正常文档流，不需要
      function syncInset() {
        var header = document.querySelector('.site-header');
        scene.style.top = wide && header ? Math.round(header.getBoundingClientRect().bottom) + 'px' : '';
      }

      // 尺子按对数刻度：30% → 0，200% → 1，每放大同样的倍数游标走同样的距离
      function zoomPos(value) {
        return (Math.log(value) - Math.log(ZOOM_MIN)) / (Math.log(ZOOM_MAX) - Math.log(ZOOM_MIN));
      }

      function zoomAt(pos) {
        pos = Math.min(1, Math.max(0, pos));
        return Math.exp(Math.log(ZOOM_MIN) + pos * (Math.log(ZOOM_MAX) - Math.log(ZOOM_MIN)));
      }

      function updateZoomUI() {
        if (!zoombar) return;
        zoombar.hidden = !wide;
        if (!wide) return;
        zoombar.dataset.manual = userZoom === null ? '' : '1';
        var level = zoombar.querySelector('[data-zoom-level]');
        if (level) level.textContent = Math.round(scale * 100) + '%';
        zoombar.style.setProperty('--zoom-pos', zoomPos(scale).toFixed(4));
        var track = zoombar.querySelector('[data-zoom-track]');
        if (track) track.setAttribute('aria-valuenow', String(Math.round(scale * 100)));
        var out = zoombar.querySelector('[data-zoom="out"]');
        var zin = zoombar.querySelector('[data-zoom="in"]');
        if (out) out.disabled = scale <= ZOOM_MIN + 0.001;
        if (zin) zin.disabled = scale >= ZOOM_MAX - 0.001;
      }

      function fit() {
        if (!wide) {
          map.style.transform = '';
          scale = 1;
          updateZoomUI();
          return;
        }
        scale = userZoom === null ? autoScale() : userZoom;
        map.style.transform = 'scale(' + scale + ')';
        updateZoomUI();
      }

      // 缩放时把光标底下那个点钉住，视觉上才是「以鼠标为中心放大」。
      // 先换倍率再量新的位置，差多少就补多少到平移量上，
      // 这样不用关心 transform-origin 到底是哪一点
      function zoomTo(next, clientX, clientY) {
        if (!wide) return;
        next = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, next));
        if (Math.abs(next - scale) < 0.0005) return;

        var anchorX = clientX;
        var anchorY = clientY;
        if (anchorX === undefined) {
          var box = canvas.getBoundingClientRect();
          anchorX = box.left + box.width / 2;
          anchorY = box.top + box.height / 2;
        }

        // 先把进行中的过渡掐掉。点「重置」会给 map 和 scene 各挂一段 420ms 动画，
        // 这时候量 getBoundingClientRect 拿到的是动画中间态，而 scale / tx / ty
        // 已经是终值——两者对不上，锚点就算歪了。
        // 去掉 transition 会让属性立刻落到终值，读一次布局把它逼出来
        map.dataset.instant = '1';
        scene.dataset.eased = '';
        void map.getBoundingClientRect();

        var before = map.getBoundingClientRect();
        var px = (anchorX - before.left) / scale;
        var py = (anchorY - before.top) / scale;

        userZoom = next;
        fit();

        var after = map.getBoundingClientRect();
        tx += anchorX - (after.left + px * scale);
        ty += anchorY - (after.top + py * scale);

        measure();
      }

      // 展开某一支之后把视线带过去：算出「父卡片 + 这一组子卡片」的包围盒，
      // 移到画布正中，顺带在自动适应的基础上放大一点，做出聚焦感。
      //
      // 位置用公式推而不是读 getBoundingClientRect：这一帧 map 上挂着 420ms
      // 的缩放过渡，读到的会是动画中间态。map 的 transform-origin 是 left center，
      // 所以 y 要绕着自身中线换算
      function focusOn(knob, group) {
        if (!wide) return;
        var parent = knob.closest('.node');
        if (!parent) return;

        var left = Infinity;
        var top = Infinity;
        var right = -Infinity;
        var bottom = -Infinity;

        function swallow(el) {
          var b = boxIn(el, map);
          left = Math.min(left, b.x);
          top = Math.min(top, b.y);
          right = Math.max(right, b.x + b.w);
          bottom = Math.max(bottom, b.y + b.h);
        }

        swallow(parent);
        group.querySelectorAll('[data-node]').forEach(function (child) {
          if (child.parentElement.closest('[data-group]') !== group) return;
          swallow(child);
        });

        var bw = right - left;
        var bh = bottom - top;
        if (!(bw > 0) || !(bh > 0)) return;

        // 这一组的卡片自己还能再展开吗？
        var deeper = false;
        group.querySelectorAll('[data-node]').forEach(function (child) {
          if (child.parentElement.closest('[data-group]') !== group) return;
          if (child.querySelector('[data-knob]')) deeper = true;
        });

        var PAD = 72;

        // 最后一层（标签卡）不重新构图。它是从右侧弹出来的一小张卡，
        // 为它重新居中 + 缩放，整张图会毫无必要地动一大下。
        // 这里只做两件事：把上一帧 fit() 改掉的倍率还原，
        // 然后只在它露到视口外时推一下，刚好让它进来；本来看得见就完全不动
        if (!deeper && !group.querySelector('.node--shelf')) {
          var keep = group.__view;
          if (keep && userZoom === null && keep.scale !== scale) {
            scale = keep.scale;
            map.dataset.instant = '';
            map.style.transform = 'scale(' + scale + ')';
            updateZoomUI();
          }

          var overRight = map.offsetLeft + tx + right * scale - (canvas.clientWidth - PAD);
          var mh = map.offsetHeight;
          var screenBottom =
            map.offsetTop + ty + mh / 2 + (bottom - mh / 2) * scale;
          var screenTop = map.offsetTop + ty + mh / 2 + (top - mh / 2) * scale;
          var overBottom = screenBottom - (scene.clientHeight - PAD);

          var dx = overRight > 0 ? -overRight : 0;
          // 往上推之前先确认别把这张卡的顶端顶出视口
          var dy = 0;
          if (overBottom > 0) dy = -Math.min(overBottom, Math.max(0, screenTop - PAD));

          if (dx || dy) {
            scene.dataset.eased = '1';
            tx += dx;
            ty += dy;
            measure();
          }
          return;
        }

        // 用户手动缩放过就别动倍率，只把视线挪过去
        if (userZoom === null) {
          var want = Math.min(
            (canvas.clientWidth - 96) / bw,
            (scene.clientHeight - 96) / bh,
          );
          // 只往自动适应之上够，且不越过 100%——放太大反而看不到上下文
          scale = Math.max(autoScale(), Math.min(1, want));
          map.dataset.instant = '';
          map.style.transform = 'scale(' + scale + ')';
          updateZoomUI();
        }

        var h = map.offsetHeight;
        var px = left + bw / 2;
        var py = top + bh / 2;

        scene.dataset.eased = '1';

        if (bw * scale + PAD * 2 <= canvas.clientWidth) {
          // 靠左对齐，右半边空着等下一级
          tx = PAD - map.offsetLeft - left * scale;
        } else {
          tx = canvas.clientWidth / 2 - map.offsetLeft - px * scale;
        }
        ty = scene.clientHeight / 2 - map.offsetTop - h / 2 - (py - h / 2) * scale;
        measure();
      }

      // 收起之后回到展开前：倍率和平移都还原。
      // userZoom 复原后 fit() 自己会算出对的倍率——此时卡片已经退场，
      // 自动适应算出来的正是展开前那个值
      function restoreView(group) {
        var v = group.__view;
        group.__view = null;
        map.dataset.instant = '';
        scene.dataset.eased = '1';
        if (v) {
          userZoom = v.userZoom;
          tx = v.tx;
          ty = v.ty;
          // 直接还原倍率，不走 fit()——fit() 会按当前布局重算自动适应，
          // 那不一定等于展开前实际用的倍率
          scale = v.scale;
          map.style.transform = 'scale(' + scale + ')';
          updateZoomUI();
        } else {
          fit();
        }
        drawWires(false);
        measure();
      }

      function resetZoom() {
        userZoom = null;
        tx = 0;
        ty = 0;
        map.dataset.instant = '';
        scene.dataset.eased = '1';
        fit();
        drawWires(false);
        measure();
      }

      // 拖动范围按「整张图在画布里的实际位置」算，上下左右四边都要量。
      // map 的 transform-origin 是 left center：x 从 map 左边起按倍率放，
      // y 要绕着 map 自身的中线换算，和 focusOn 用的是同一套公式。
      //
      // 以前这里只量了右边和下边，等于假定图的左上角永远在画布原点。
      // 卡片全展开、倍率又是 100% 时，图会往上长出画布，
      // 而上边界被写死成固定余量，于是往上拖到一半就卡住，顶上的卡片够不着
      function measure() {
        if (!wide) return;
        var mh = map.offsetHeight;
        var left = Infinity;
        var top = Infinity;
        var right = -Infinity;
        var bottom = -Infinity;

        map.querySelectorAll('[data-pan-item]').forEach(function (el) {
          var box = boxIn(el, map);
          var x = map.offsetLeft + box.x * scale;
          var y = map.offsetTop + mh / 2 + (box.y - mh / 2) * scale;
          left = Math.min(left, x);
          top = Math.min(top, y);
          right = Math.max(right, x + box.w * scale);
          bottom = Math.max(bottom, y + box.h * scale);
        });

        if (left === Infinity) return;

        // 四周各留一屏七成的余量，随便怎么拖都够
        var slackX = canvas.clientWidth * 0.7;
        var slackY = scene.clientHeight * 0.7;
        minX = Math.min(0, canvas.clientWidth - right) - slackX;
        maxX = Math.max(0, -left) + slackX;
        minY = Math.min(0, scene.clientHeight - bottom) - slackY;
        maxY = Math.max(0, -top) + slackY;

        tx = Math.min(maxX, Math.max(minX, tx));
        ty = Math.min(maxY, Math.max(minY, ty));
        apply();
        canvas.dataset.pannable = '1';
      }

      function onDown(event) {
        if (!wide || event.button !== 0) return;
        if (event.target.closest('button, input, textarea, select, [data-zoombar]')) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        startY = event.clientY;
        originX = tx;
        originY = ty;
        scene.dataset.eased = '';
        canvas.dataset.dragging = '1';
        // 这里不能 preventDefault：会连带压掉兼容鼠标事件，链接的 click 一起没掉
      }

      function onMove(event) {
        glow(event);
        if (!dragging) return;
        var dx = event.clientX - startX;
        var dy = event.clientY - startY;
        moved = Math.max(moved, Math.abs(dx) + Math.abs(dy));
        tx = Math.min(maxX, Math.max(minX, originX + dx));
        ty = Math.min(maxY, Math.max(minY, originY + dy));
        apply();
      }

      function onUp() {
        if (!dragging) return;
        dragging = false;
        canvas.dataset.dragging = '';
      }

      function onLeave() {
        clearGlow(litCard);
        litCard = null;
      }

      function onClick(event) {
        if (moved > DRAG_THRESHOLD) {
          event.preventDefault();
          event.stopPropagation();
          moved = 0;
          return;
        }
        var knob = event.target.closest('[data-knob]');
        if (knob) {
          event.preventDefault();
          toggle(knob);
        }
      }

      function onDragStart(event) {
        event.preventDefault();
      }

      // deltaX/deltaY 的单位看 deltaMode：0 是像素，1 是行，2 是页。
      // Firefox 常报「行」，不归一化的话一格才滚 3，几乎动不了
      function wheelPx(value, mode) {
        if (mode === 1) return value * 16;
        if (mode === 2) return value * 100;
        return value;
      }

      // Ctrl/⌘ + 滚轮缩放，不按就是平移画布。
      // 必须 passive:false 才能 preventDefault，否则浏览器会把 ctrl+滚轮
      // 当成整页缩放
      function onWheel(event) {
        // 窄屏是正常滚动的页面，一律不拦
        if (!wide) return;

        if (event.ctrlKey || event.metaKey) {
          event.preventDefault();
          // 触控板的 deltaY 很碎，用指数缩放手感才线性；
          // 一格滚轮约 1.2 倍，和按钮的步长对齐
          zoomTo(
            scale * Math.exp(-wheelPx(event.deltaY, event.deltaMode) * 0.002),
            event.clientX,
            event.clientY,
          );
          return;
        }

        var dx = wheelPx(event.deltaX, event.deltaMode);
        var dy = wheelPx(event.deltaY, event.deltaMode);

        // 按住 shift 横向平移。浏览器通常自己会把 shift+滚轮转成 deltaX，
        // 但不是所有浏览器都转，所以这里兜一手
        if (event.shiftKey && !dx) {
          dx = dy;
          dy = 0;
        }

        if (!dx && !dy) return;
        event.preventDefault();

        // 平移要跟手，把重置留下的缓动去掉
        scene.dataset.eased = '';
        tx = Math.min(maxX, Math.max(minX, tx - dx));
        ty = Math.min(maxY, Math.max(minY, ty - dy));
        apply();
      }

      function onZoomClick(event) {
        var btn = event.target.closest ? event.target.closest('[data-zoom]') : null;
        if (!btn) return;
        event.preventDefault();
        var act = btn.getAttribute('data-zoom');
        if (act === 'reset') resetZoom();
        else zoomTo(scale * (act === 'in' ? 1.2 : 1 / 1.2));
      }

      function onKey(event) {
        if (!wide || !(event.ctrlKey || event.metaKey)) return;
        if (event.key === '=' || event.key === '+') {
          event.preventDefault();
          zoomTo(scale * 1.2);
        } else if (event.key === '-' || event.key === '_') {
          event.preventDefault();
          zoomTo(scale / 1.2);
        } else if (event.key === '0') {
          event.preventDefault();
          resetZoom();
        }
      }

      function onResize() {
        wide = window.matchMedia('(min-width: 60.0625rem)').matches;
        if (!wide) {
          tx = 0;
          ty = 0;
          scene.style.transform = '';
          syncInset();
          map.style.transform = '';
          scale = 1;
          canvas.dataset.pannable = '';
          userZoom = null;
          updateZoomUI();
          clampTags(map);
          // 竖版树的线也要跟着重新量，横竖屏切换时几何整个换了一套
          drawWires(false);
          return;
        }
        syncInset();
        clampTags(map);
        fit();
        drawWires(false);
        measure();
      }

      canvas.addEventListener('pointerdown', onDown);
      canvas.addEventListener('click', onClick, true);
      canvas.addEventListener('wheel', onWheel, { passive: false });
      if (zoombar) zoombar.addEventListener('click', onZoomClick);

      // 尺子：按下就跳到那个位置，按住拖动连续缩放；键盘左右键一格 10%
      var track = zoombar ? zoombar.querySelector('[data-zoom-track]') : null;
      if (track) {
        var slide = function (event) {
          var box = track.getBoundingClientRect();
          zoomTo(zoomAt((event.clientX - box.left) / box.width));
        };
        track.addEventListener('pointerdown', function (event) {
          if (event.button !== 0) return;
          // 捕获指针，拖出尺子范围也继续跟手；个别情况下捕获会抛错，不影响点一下就跳
          try {
            track.setPointerCapture(event.pointerId);
          } catch (e) {}
          zoombar.dataset.sliding = '1';
          slide(event);
        });
        track.addEventListener('pointermove', function (event) {
          if (zoombar.dataset.sliding === '1') slide(event);
        });
        var stop = function () {
          zoombar.dataset.sliding = '';
        };
        track.addEventListener('pointerup', stop);
        track.addEventListener('pointercancel', stop);
        track.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowRight' || event.key === 'ArrowUp') zoomTo(scale * 1.1);
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') zoomTo(scale / 1.1);
          else return;
          event.preventDefault();
        });
      }
      window.addEventListener('keydown', onKey);
      canvas.addEventListener('dragstart', onDragStart);
      canvas.addEventListener('pointerleave', onLeave);
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('pointerup', onUp);
      window.addEventListener('resize', onResize);

      window.__nnMap = {
        canvas: canvas,
        onDown: onDown,
        onMove: onMove,
        onUp: onUp,
        onClick: onClick,
        onDragStart: onDragStart,
        onLeave: onLeave,
        onResize: onResize,
        onWheel: onWheel,
        onKey: onKey,
      };

      syncInset();
      fit();
      measure();

      // 手机上一进来只有一张孤零零的根卡片，看着像站是空的。
      // 默认把一级分支展开，文章那一层仍然收着
      if (!wide) {
        var rootKnob = map.querySelector('[data-knob="root"]');
        var rootGroup = map.querySelector('[data-group="root"]');
        if (rootKnob && rootGroup && rootGroup.hidden) {
          rootKnob.setAttribute('aria-expanded', 'true');
          pop(rootGroup, true);
          requestAnimationFrame(function () {
            drawWires(true);
          });
        }
      } else {
        drawWires(false);
      }
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', teardown);
    if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    }
  })();
</script>
