---
import BaseLayout from '../layouts/BaseLayout.astro';
import KindIcon from '../components/KindIcon.astro';
import TargetCursor from '../components/TargetCursor.astro';
import { profile, branches, BRANCH_LEAF_LIMIT, site } from '../config/site';
import {
  getPublished,
  formatDate,
  entryHref,
  entryCover,
  thumbUrl,
  type ContentKind,
} from '../lib/content';

type Leaf = {
  id: string;
  title: string;
  meta: string;
  at: string;
  summary: string;
  href: string;
  cover?: string;
  tags: string[];
};

// 背景插画：有图就作为 CSS 变量交给背景层，没有就是 none，背景层退回 CSS 画的占位。
// 竖屏图没给就沿用横屏那张
const bg = site.homeBackdrop;
const toUrl = (u: string) => (u ? `url("${u}")` : 'none');
const backdropVars = [
  `--bd-day: ${toUrl(bg.light)}`,
  `--bd-night: ${toUrl(bg.dark)}`,
  `--bd-day-tall: ${toUrl(bg.lightPortrait || bg.light)}`,
  `--bd-night-tall: ${toUrl(bg.darkPortrait || bg.dark)}`,
].join('; ');

// 每条分支挂最新的若干篇；条数由 BRANCH_LEAF_LIMIT 统一控制
// 首页的封面全部走 OSS 缩略图样式：展开五条分支就是十几张图，拉原图太费流量
const avatar = thumbUrl(profile.avatar);
const branchCovers: Record<string, string | undefined> = Object.fromEntries(
  branches.map((branch) => [branch.key, thumbUrl(branch.cover)]),
);

const leaves: Record<string, Leaf[]> = {};
// 超出 BRANCH_LEAF_LIMIT 的部分不挂到图上，末尾用一张卡片交代还剩多少
const overflow: Record<string, number> = {};
// 每个分类最新一篇的时间，给「NEW」标记用。是否在 24 小时内要在浏览器里判断：
// 静态站只在推送时构建，构建时算好的话，两天没推送 NEW 也会一直挂着
const latest: Record<string, string | undefined> = {};
// 「还有 N 篇」那张卡上顺手列出接下来的三篇标题
const rest: Record<string, string[]> = {};
for (const branch of branches) {
  const kind = branch.key as ContentKind;
  const entries = await getPublished(kind);
  overflow[branch.key] = Math.max(0, entries.length - BRANCH_LEAF_LIMIT);
  rest[branch.key] = entries.slice(BRANCH_LEAF_LIMIT, BRANCH_LEAF_LIMIT + 3).map((entry) => entry.data.title);
  latest[branch.key] = entries[0]?.data.publishedAt.toISOString();
  leaves[branch.key] = entries.slice(0, BRANCH_LEAF_LIMIT).map((entry, i) => ({
    id: `l-${branch.key}-${i}`,
    title: entry.data.title,
    meta: formatDate(entry.data.publishedAt),
    at: entry.data.publishedAt.toISOString(),
    summary: entry.data.summary,
    href: entryHref(kind, entry.data.slug),
    cover: thumbUrl(entryCover(entry)),
    tags: [...entry.data.tags],
  }));
}
---

<BaseLayout variant="canvas">
  <TargetCursor />
  <div class="canvas" data-canvas>
    <!-- 背景插画：白天、夜里各一层，跟着主题交叉淡入；拖动导图时反方向轻轻挪一点（视差） -->
    <div class:list={['backdrop', { 'backdrop--illustrated': Boolean(bg.light && bg.dark) }]} aria-hidden="true" style={backdropVars}>
      <div class="backdrop__layer backdrop__layer--day"></div>
      <div class="backdrop__layer backdrop__layer--night"></div>
    </div>
    <!-- 深浅两套插画齐全时不叠加点阵，避免网点覆盖人物与色块。 -->
    {!(bg.light && bg.dark) && <div class="dots" aria-hidden="true"></div>}

    <div class="zoombar" data-zoombar hidden>
      <!-- 四个角上的小折角，和门户页四周的装饰同一个意思 -->
      <span class="zoombar__corner zoombar__corner--tl" aria-hidden="true"></span>
      <span class="zoombar__corner zoombar__corner--tr" aria-hidden="true"></span>
      <span class="zoombar__corner zoombar__corner--bl" aria-hidden="true"></span>
      <span class="zoombar__corner zoombar__corner--br" aria-hidden="true"></span>

      <button class="zoombar__btn" type="button" data-zoom="out" aria-label="缩小">
        <span class="zoombar__minus"></span>
      </button>

      <!-- 刻度尺：一只小猫爪沿着尺子走，按住拖或者点哪里就缩放到哪里；那根高一点的刻度是 100% -->
      <div
        class="zoombar__track"
        data-zoom-track
        role="slider"
        tabindex="0"
        aria-label="缩放比例"
        aria-valuemin="30"
        aria-valuemax="200"
        aria-valuenow="100"
      >
        <span class="zoombar__rail" aria-hidden="true"></span>
        <span class="zoombar__fill" aria-hidden="true"></span>
        <span class="zoombar__one" aria-hidden="true"></span>
        <span class="zoombar__paw" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 12.6c-2.6 0-5 2.3-5 4.6 0 1.6 1.2 2.6 2.7 2.6 1 0 1.5-.5 2.3-.5s1.3.5 2.3.5c1.5 0 2.7-1 2.7-2.6 0-2.3-2.4-4.6-5-4.6z" />
            <ellipse class="zoombar__bean" cx="6.2" cy="10.6" rx="1.7" ry="2.1" />
            <ellipse class="zoombar__bean" cx="9.6" cy="6.9" rx="1.7" ry="2.2" />
            <ellipse class="zoombar__bean" cx="14.4" cy="6.9" rx="1.7" ry="2.2" />
            <ellipse class="zoombar__bean" cx="17.8" cy="10.6" rx="1.7" ry="2.1" />
          </svg>
        </span>
      </div>

      <button class="zoombar__btn" type="button" data-zoom="in" aria-label="放大">
        <span class="zoombar__minus"></span>
        <span class="zoombar__bar"></span>
      </button>

      <button
        class="zoombar__level"
        type="button"
        data-zoom="reset"
        aria-label="恢复到适应屏幕"
        title="恢复到适应屏幕"
      >
        <svg class="zoombar__fit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
        </svg>
        <span data-zoom-level>100%</span>
      </button>
    </div>

    <div class="scene" data-scene>
      <div class="map" data-map>
        <svg class="wires" data-wires aria-hidden="true"></svg>

        <div class="node node--root" data-node="root" data-pan-item>
          {
            avatar ? (
              <img class="root__cover" src={avatar} alt="" width="256" height="256" />
            ) : (
              <div class="root__cover cover-ph">头像待补</div>
            )
          }

          <div class="node__body">
            <h1 class="root__name">{profile.name}</h1>
            <p class="root__bio">{profile.bio}</p>
          </div>

          <button
            class="knob"
            type="button"
            data-knob="root"
            aria-expanded="false"
            aria-label="展开分支"
          >
            <span class="knob__h"></span>
            <span class="knob__v"></span>
          </button>
        </div>

        <div class="branches" data-group="root" hidden>
          {
            branches.map((branch) => (
              <div class="row">
                <div class="node node--branch" data-node={`b-${branch.key}`} data-pan-item data-pop>
                  {branchCovers[branch.key] ? (
                    <img class="branch__cover" src={branchCovers[branch.key]} alt="" loading="lazy" />
                  ) : (
                    <div class="branch__cover cover-ph">封面待补</div>
                  )}

                  <div class="node__body">
                    <div class="branch__head">
                      <div class="branch__name">
                        <h2 class="branch__title">
                          <KindIcon name={branch.key as ContentKind} class="branch__icon" />
                          {branch.label}
                        </h2>
                        {latest[branch.key] && (
                          <span class="new-badge" data-new-since={latest[branch.key]} hidden>
                            NEW
                          </span>
                        )}
                      </div>
                      <a class="text-link" href={branch.href}>
                        查看全部
                      </a>
                    </div>
                    <p class="branch__desc">{branch.desc}</p>
                  </div>

                  {leaves[branch.key].length > 0 && (
                    <button
                      class="knob"
                      type="button"
                      data-knob={branch.key}
                      aria-expanded="false"
                      aria-label={`展开${branch.label}`}
                    >
                      <span class="knob__h" />
                      <span class="knob__v" />
                    </button>
                  )}
                </div>

                <div class="leaves" data-group={branch.key} hidden>
                  <div
                    class="node node--shelf"
                    data-node={`s-${branch.key}`}
                    data-pan-item
                    data-pop
                    style={`--cols: ${Math.min(3, leaves[branch.key].length + (overflow[branch.key] > 0 ? 1 : 0))}`}
                  >
                    <div class="shelf__head">
                      <span class="shelf__title">
                        <KindIcon name={branch.key as ContentKind} class="shelf__icon" />
                        {branch.label}
                      </span>
                      <a class="shelf__all" href={branch.href}>
                        {`全部 ${leaves[branch.key].length + overflow[branch.key]} 篇`}
                      </a>
                    </div>

                    <div class="shelf__grid">
                      {leaves[branch.key].map((leaf) => (
                        <article class="node card" data-pop>
                          {leaf.cover ? (
                            <img class="card__cover" src={leaf.cover} alt="" loading="lazy" />
                          ) : (
                            <div class="card__cover cover-ph">封面待补</div>
                          )}

                          <div class="card__body">
                            <span class="card__meta">
                              {leaf.meta}
                              <span class="new-badge" data-new-since={leaf.at} hidden>NEW</span>
                            </span>
                            <span class="card__title">{leaf.title}</span>
                            <span class="card__summary">{leaf.summary}</span>
                            {leaf.tags.length > 0 && (
                              <span class="card__tags" data-tag-clamp>
                                {leaf.tags.map((tag) => (
                                  <a class="card__tag" href={`/tags/${encodeURIComponent(tag)}/`} title={tag}>
                                    {tag}
                                  </a>
                                ))}
                                <span class="card__tag card__tag--more" hidden />
                              </span>
                            )}
                          </div>

                          <a class="card__hit" href={leaf.href} aria-label={leaf.title} />
                        </article>
                      ))}

                      {overflow[branch.key] > 0 && (
                        <a class="node card card--more" href={branch.href} data-pop>
                          <span class="more__count">还有 {overflow[branch.key]} 篇</span>
                          <span class="more__list">
                            {rest[branch.key].map((title) => (
                              <span class="more__item">{title}</span>
                            ))}
                          </span>
                          <span class="more__go">查看全部 →</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .canvas {
    /* 画布平移 / 缩放的时长。比卡片入场略长一点，
       让「图在挪」这件事托住「卡片在长出来」，整体才不显得一顿一顿 */
    --dur-view: 620ms;
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  /* ---------- 背景插画 ----------
     白天：小萌在房间里写字（左下角书桌，右上角窗户，左上角花枝）
     夜里：小萌坐在空间站甲板边上看黑洞（左下角人物，右上角黑洞，右下角行星弧光）
     图片地址来自 site.ts 的 homeBackdrop；没给图时用下面这组渐变画一个同构图的占位，
     换上真图以后位置关系不变。比画布大一圈，视差挪动时边缘不会露出来 */
  .backdrop {
    position: absolute;
    inset: -3%;
    z-index: 0;
    pointer-events: none;
    transform: translate3d(calc(var(--pan-x, 0px) * -0.03), calc(var(--pan-y, 0px) * -0.03), 0);
    transition: transform var(--dur-view) var(--ease-out);
  }

  .canvas[data-dragging='1'] .backdrop { transition: none; }

  .backdrop__layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    /* 靠左（人物在左边），上下居中：画布比图更扁时上下各裁一点，
       贴底对齐的话多出来的全从顶上裁，右上角的黑洞会被顶栏切掉 */
    background-position: left center;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  .backdrop__layer--day {
    background-image:
      var(--bd-day),
      /* 左上角花枝的粉色光晕 */
      radial-gradient(circle at 7% 8%, rgba(255, 182, 206, 0.55), transparent 16%),
      /* 右上角窗户透进来的天光 */
      radial-gradient(ellipse 22% 34% at 94% 14%, rgba(176, 216, 255, 0.7), transparent 72%),
      /* 左下角书桌那一团暖紫 */
      radial-gradient(ellipse 30% 28% at 14% 86%, rgba(198, 176, 240, 0.4), transparent 70%),
      /* 地板 */
      linear-gradient(to top, #e4daf3 0 7%, rgba(200, 186, 236, 0.6) 7% 7.2%, transparent 7.2%),
      linear-gradient(#faf6fc, #f4eefa);
  }

  .backdrop__layer--night {
    opacity: 0;
    background-image:
      var(--bd-night),
      /* 右上角的小黑洞：黑色阴影、一圈亮边、斜着的吸积盘 */
      radial-gradient(circle at 89% 17%, #05060c 0 2.6vw, rgba(255, 228, 176, 0.95) 2.75vw, rgba(255, 206, 140, 0.25) 3.4vw, transparent 5vw),
      radial-gradient(ellipse 8.5vw 1.5vw at 89% 18%, transparent 55%, rgba(255, 222, 168, 0.75) 66%, transparent 80%),
      /* 右下角行星的弧光 */
      radial-gradient(circle at 104% 118%, #2a4fc2 0 26vw, rgba(110, 160, 255, 0.85) 26.2vw, rgba(110, 160, 255, 0.18) 27.5vw, transparent 31vw),
      /* 几颗星 */
      radial-gradient(circle at 9% 8%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 53% 5%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 76% 7%, #fff 0 1.2px, transparent 2px),
      radial-gradient(circle at 34% 22%, rgba(255, 255, 255, 0.7) 0 1px, transparent 2px),
      radial-gradient(circle at 64% 30%, rgba(255, 255, 255, 0.6) 0 1px, transparent 2px),
      /* 甲板 */
      linear-gradient(to top, #283152 0 9%, rgba(150, 170, 235, 0.7) 9% 9.25%, transparent 9.25%),
      linear-gradient(#0a0f20, #0d1328);
  }

  :global(:root[data-theme='dark']) .backdrop__layer--day { opacity: 0; }
  :global(:root[data-theme='dark']) .backdrop__layer--night { opacity: 1; }

  /* 插画上盖一层底色遮罩，透明度给高一点：插画退到后面当氛围，不和卡片抢眼，
     卡片、连线和标签在上面也读得清 */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 32%, transparent);
  }

  /* 点阵底：只用一个 token 色，深浅两套主题都成立。叠在插画上，调成淡淡一层纹理 */
  .dots {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.32;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 40%, transparent 100%);
  }


  /* ---------- 右下角缩放条 ---------- */
  /* 一把刻度尺：减号、尺子（一只小猫爪当游标）、加号，最右边是倍率和「适应屏幕」。
     四角各一个小折角做装饰，还是发丝线，不加圆角和阴影 */

  .zoombar {
    --zoom-pos: 0.635;
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 4;
    display: flex;
    align-items: stretch;
    border: var(--hair) solid var(--line);
    /* 微透明，和顶栏一样隐约透出底下的插画 */
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: blur(10px);
  }

  .zoombar__corner {
    position: absolute;
    width: 6px;
    height: 6px;
    border: 0 solid var(--fg-faint);
    pointer-events: none;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .zoombar__corner--tl { left: -4px; top: -4px; border-left-width: 1px; border-top-width: 1px; }
  .zoombar__corner--tr { right: -4px; top: -4px; border-right-width: 1px; border-top-width: 1px; }
  .zoombar__corner--bl { left: -4px; bottom: -4px; border-left-width: 1px; border-bottom-width: 1px; }
  .zoombar__corner--br { right: -4px; bottom: -4px; border-right-width: 1px; border-bottom-width: 1px; }

  .zoombar:hover .zoombar__corner { border-color: var(--accent); }

  .zoombar__btn,
  .zoombar__level {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out), background var(--dur-1) var(--ease-out);
  }

  .zoombar__btn {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
  }

  /* 加号减号用两根线拼，和展开按钮同一套语言 */
  .zoombar__minus,
  .zoombar__bar {
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
  }

  .zoombar__minus {
    width: 0.6rem;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .zoombar__bar {
    width: 1px;
    height: 0.6rem;
    transform: translate(-50%, -50%);
  }

  /* 尺子：一根底线 + 每 10% 一格的短刻度；走过的那一段描深 */
  .zoombar__track {
    position: relative;
    width: 6.5rem;
    margin-inline: 0.35rem;
    cursor: pointer;
    touch-action: none;
    outline: none;
  }

  .zoombar__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 7px;
    border-bottom: var(--hair) solid var(--line-strong);
    background: repeating-linear-gradient(
      to right,
      var(--line-strong) 0 1px,
      transparent 1px 10%
    );
    background-size: 100% 4px;
    background-repeat: no-repeat;
    background-position: left bottom;
  }

  .zoombar__fill {
    position: absolute;
    left: 0;
    top: calc(50% + 6px);
    width: calc(var(--zoom-pos) * 100%);
    height: 1px;
    background: var(--fg-muted);
  }

  /* 100% 那一格：高一点的刻度 */
  .zoombar__one {
    position: absolute;
    left: 63.5%;
    top: calc(50% - 3px);
    width: 1px;
    height: 10px;
    background: var(--fg-muted);
  }

  .zoombar__paw {
    position: absolute;
    left: calc(var(--zoom-pos) * 100%);
    top: calc(50% - 0.95rem);
    width: 1.05rem;
    height: 1.05rem;
    color: var(--fg);
    transform: translateX(-50%);
    transition: left var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }

  .zoombar__paw svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .zoombar__bean {
    fill: var(--icon-pink);
    stroke: none;
  }

  /* 拖动时游标跟手，不要过渡 */
  .zoombar[data-sliding='1'] .zoombar__paw { transition: none; }

  .zoombar__track:hover .zoombar__paw,
  .zoombar__track:focus-visible .zoombar__paw,
  .zoombar[data-sliding='1'] .zoombar__paw { transform: translateX(-50%) scale(1.15) rotate(-8deg); }

  .zoombar__track:focus-visible .zoombar__rail { border-bottom-color: var(--accent); }

  .zoombar__level {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 4.6rem;
    padding-inline: 0.6rem;
    border-left: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .zoombar__fit {
    width: 0.85rem;
    height: 0.85rem;
    flex: none;
  }

  .zoombar__btn:hover,
  .zoombar__level:hover { color: var(--accent); background: var(--accent-wash); }

  .zoombar__btn:disabled { color: var(--line-strong); cursor: default; background: none; }

  /* 手动缩放过之后标出来，提示这里可以点回自动适应 */
  .zoombar[data-manual='1'] .zoombar__level { color: var(--accent); }

  /* 画布光标。系统自带的 grab 手在浅色底上跟着系统光标主题走，
     用户那边是白的、几乎看不见，所以自己画一只：实心描边 + 反色光晕，
     深浅两套主题各一份，任何底色上都读得出来 */
  .canvas[data-pannable='1'] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2226%22%20height%3D%2226%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M8%2013V5.6a1.4%201.4%200%201%201%202.8%200V12M10.8%2012V4.4a1.4%201.4%200%201%201%202.8%200V12M13.6%2012.4V6a1.4%201.4%200%201%201%202.8%200v6.4M16.4%2011.6a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%223.4%22%2F%3E%3Cpath%20d%3D%22M8%2013V5.6a1.4%201.4%200%201%201%202.8%200V12M10.8%2012V4.4a1.4%201.4%200%201%201%202.8%200V12M13.6%2012.4V6a1.4%201.4%200%201%201%202.8%200v6.4M16.4%2011.6a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%2316171a%22%20stroke-width%3D%221.5%22%2F%3E%3C%2Fsvg%3E") 12 10, grab;
    touch-action: none;
  }

  .canvas[data-dragging='1'] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2226%22%20height%3D%2226%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M7%2013v-1.6a1.4%201.4%200%201%201%202.8%200V13M9.8%2013v-2.2a1.4%201.4%200%201%201%202.8%200V13M12.6%2013v-1.8a1.4%201.4%200%201%201%202.8%200V13M15.4%2013.2v-1a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%223.4%22%2F%3E%3Cpath%20d%3D%22M7%2013v-1.6a1.4%201.4%200%201%201%202.8%200V13M9.8%2013v-2.2a1.4%201.4%200%201%201%202.8%200V13M12.6%2013v-1.8a1.4%201.4%200%201%201%202.8%200V13M15.4%2013.2v-1a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%2316171a%22%20stroke-width%3D%221.5%22%2F%3E%3C%2Fsvg%3E") 12 10, grabbing;
    user-select: none;
  }

  :global(:root[data-theme='dark']) .canvas[data-pannable='1'] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2226%22%20height%3D%2226%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M8%2013V5.6a1.4%201.4%200%201%201%202.8%200V12M10.8%2012V4.4a1.4%201.4%200%201%201%202.8%200V12M13.6%2012.4V6a1.4%201.4%200%201%201%202.8%200v6.4M16.4%2011.6a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23101114%22%20stroke-width%3D%223.4%22%2F%3E%3Cpath%20d%3D%22M8%2013V5.6a1.4%201.4%200%201%201%202.8%200V12M10.8%2012V4.4a1.4%201.4%200%201%201%202.8%200V12M13.6%2012.4V6a1.4%201.4%200%201%201%202.8%200v6.4M16.4%2011.6a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23e9e8e4%22%20stroke-width%3D%221.5%22%2F%3E%3C%2Fsvg%3E") 12 10, grab;
  }

  :global(:root[data-theme='dark']) .canvas[data-dragging='1'] {
    cursor: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2226%22%20height%3D%2226%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M7%2013v-1.6a1.4%201.4%200%201%201%202.8%200V13M9.8%2013v-2.2a1.4%201.4%200%201%201%202.8%200V13M12.6%2013v-1.8a1.4%201.4%200%201%201%202.8%200V13M15.4%2013.2v-1a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23101114%22%20stroke-width%3D%223.4%22%2F%3E%3Cpath%20d%3D%22M7%2013v-1.6a1.4%201.4%200%201%201%202.8%200V13M9.8%2013v-2.2a1.4%201.4%200%201%201%202.8%200V13M12.6%2013v-1.8a1.4%201.4%200%201%201%202.8%200V13M15.4%2013.2v-1a1.4%201.4%200%200%201%202.8%200V16c0%203.3-2.4%206-5.6%206h-1.9c-1.6%200-3.1-.6-4.2-1.7l-2.4-2.5a1.4%201.4%200%200%201%202-2l1.7%201.5%22%20stroke%3D%22%23e9e8e4%22%20stroke-width%3D%221.5%22%2F%3E%3C%2Fsvg%3E") 12 10, grabbing;
  }

  .scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  /* will-change 只在真正逐帧改 transform 的时候挂。
     常挂着会把这一层永久提升成合成层：文字按提升那一刻的倍率栅格化一次，
     之后画布缩放只是把那张位图拉大，于是字发虚；鼠标悬浮到卡片上会改动
     该元素、逼它按当前倍率重新栅格化，所以「悬浮就清晰、移走又模糊」 */
  .canvas[data-dragging='1'] .scene { will-change: transform; }

  .scene[data-eased='1'] { transition: transform var(--dur-view) var(--ease-out); }

  /* 滚轮连续缩放时必须去掉过渡：每一格都跑 420ms 会糊成一片橡皮筋。
     只有点「重置」回到自动适应时才让它动画过去 */
  .map[data-instant='1'] { transition: none; }

  .map {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    width: max-content;
    padding: 2.5rem clamp(2rem, 6vw, 5rem);
    transform-origin: left center;
    transition: transform var(--dur-view) var(--ease-out);
  }

  /* 连线层：路径由脚本按实际盒子位置算出来 */
  .wires {
    position: absolute;
    top: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
  }

  .wires :global(path) {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  /* 连线上的光点：零长度 + 圆头线帽渲染出来就是一个圆点，沿路径循环移动 */
  .wires :global(.wire-flow) {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .branches {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .leaves {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ---------- 节点卡片 ---------- */

  .node {
    --glow: 0;
    --glow-angle: 0deg;
    /* 三色跟着主题色走，色值在 global.css 的 --glow-* 里；
       后面那个是万一 token 没加载时的兜底 */
    --g1: var(--glow-1, #c084fc);
    --g2: var(--glow-2, #f472b6);
    --g3: var(--glow-3, #38bdf8);
    position: relative;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    transition: transform var(--dur-2) var(--ease-out);
  }

  /* 彩色描边：透明边框 + padding-box 不透明填充，网格渐变就只在那 1px 边上显色。
     圆锥遮罩按指针角度开一段口子，光就跟着鼠标沿边走 */
  .node.is-lit::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 0;
    pointer-events: none;
    border: 1px solid transparent;
    background:
      linear-gradient(var(--bg) 0 100%) padding-box,
      radial-gradient(at 80% 55%, var(--g1) 0, transparent 50%) border-box,
      radial-gradient(at 69% 34%, var(--g2) 0, transparent 50%) border-box,
      radial-gradient(at 8% 6%, var(--g3) 0, transparent 50%) border-box,
      radial-gradient(at 41% 38%, var(--g1) 0, transparent 50%) border-box,
      radial-gradient(at 86% 85%, var(--g2) 0, transparent 50%) border-box,
      radial-gradient(at 82% 18%, var(--g3) 0, transparent 50%) border-box,
      radial-gradient(at 51% 4%, var(--g2) 0, transparent 50%) border-box,
      linear-gradient(var(--g1) 0 100%) border-box;
    opacity: var(--glow);
    mask-image: conic-gradient(
      from var(--glow-angle) at center,
      #000 0%,
      transparent 22%,
      transparent 78%,
      #000 100%
    );
    -webkit-mask-image: conic-gradient(
      from var(--glow-angle) at center,
      #000 0%,
      transparent 22%,
      transparent 78%,
      #000 100%
    );
    transition: opacity 260ms var(--ease-out);
  }

  /* 卡片外的三色柔光 */
  .node.is-lit::after {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 0;
    pointer-events: none;
    opacity: calc(var(--glow) * 0.9);
    box-shadow:
      0 0 6px color-mix(in srgb, var(--g1) 60%, transparent),
      0 0 16px color-mix(in srgb, var(--g2) 45%, transparent),
      0 0 34px color-mix(in srgb, var(--g3) 35%, transparent);
    transition: opacity 260ms var(--ease-out);
  }

  /* 不能写 .node > *：Astro 作用域会给通配子选择器也加上属性，
     特异性变成 0,3,0 压过 .knob 的 0,2,0，把按钮的绝对定位覆盖掉 */
  .node__body,
  .root__cover,
  .branch__cover,
  .card__cover,
  .card__body {
    position: relative;
    z-index: 1;
  }

  /* ---------- 根节点：左半封面，右半内容 ---------- */

  .node--root {
    display: grid;
    grid-template-columns: 50% minmax(0, 1fr);
    width: 28rem;
    /* 用 start 而不是 stretch，否则 aspect-ratio 会被拉伸吃掉 */
    align-items: start;
  }

  /* 头像原始比例 215×232，竖版，不要按横图裁 */
  .root__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 215 / 232;
    align-self: start;
    object-fit: cover;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .node--root .node__body {
    align-self: stretch;
    padding: 1.5rem 1.35rem;
    /* 分隔线放在右栏，才能跟着整行高度撑满 */
    border-left: var(--hair) solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .root__name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .root__bio {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  /* ---------- 分类节点 ---------- */

  .node--branch { width: 17rem; }

  .branch__cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .node--branch .node__body { padding: 0.95rem 1.1rem 1.1rem; }

  .branch__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .branch__head .text-link {
    padding-bottom: 0;
    line-height: 1;
  }

  .branch__title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .branch__title :global(.branch__icon) {
    font-size: 0.95em;
    color: var(--fg-muted);
  }

  .branch__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .branch__desc {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  /* ---------- 文章书架：展开一个分类，右边铺开一块面板 ---------- */
  /* 以前是一列横向长卡片再往右挂标签卡，一支展开就有一屏多高、四层深，聚焦放大也装不下。
     现在一个分类只长出一块面板：最新几篇排成三列竖卡，标签直接写在卡片底部，少了一层 */

  .node--shelf {
    --card-w: 13.5rem;
    padding: 0.9rem 1rem 1rem;
  }

  .shelf__head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .shelf__title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .shelf__title :global(.shelf__icon) {
    font-size: 1.05em;
    color: var(--fg-muted);
  }

  /* 「全部 N 篇」：汉字和数字用同一套字体。以前套的是 .text-link（等宽 + 字距 + 大写），
     数字落在等宽字体、汉字退回别的字体，看上去大小不一 */
  .shelf__all {
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    border-bottom: var(--hair) solid var(--line-strong);
    padding-bottom: 0.2rem;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .shelf__all:hover { color: var(--accent); border-color: var(--accent); }

  .shelf__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), var(--card-w));
    gap: 0.75rem;
  }

  /* 竖卡：封面在上，日期、标题、两行摘要、标签依次往下 */
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card:hover { transform: translateY(-0.25rem); }

  .card__cover {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.7rem 0.8rem 0.8rem;
    min-width: 0;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .card__title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card:hover .card__title { color: var(--accent); }

  .card__summary {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 标签贴在卡片底部；要能单独点，所以压在整卡链接上面 */
  .card__tags {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  /* 最多两行，由脚本按实际排版收（clampTags）；单个标签比一行还长就在标签里截断加省略号 */
  .card__tag {
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0.1rem 0.4rem;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  a.card__tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .card__tag--more { border-style: dashed; }

  /* 整卡可点：铺一层透明链接，标签在它上面 */
  .card__hit {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* 「还有 N 篇」：虚线卡，顺手列出剩下几篇的标题，不只是一个数字 */
  .card--more {
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 0.95rem;
    border-style: dashed;
  }

  .more__count {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: 1rem;
  }

  .more__list {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.45rem;
  }

  .more__item {
    padding-left: 0.7rem;
    border-left: var(--hair) solid var(--line-strong);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more__go {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .card--more:hover .more__count,
  .card--more:hover .more__go { color: var(--accent); }

  /* ---------- 展开按钮：两根线拼成的 + ---------- */

  .knob {
    position: absolute;
    right: -0.8rem;
    top: 50%;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: -0.8rem;
    padding: 0;
    border: var(--hair) solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg-muted);
    cursor: pointer;
    z-index: 3;
