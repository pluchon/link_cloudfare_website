    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .branch__head .text-link {
    padding-bottom: 0;
    line-height: 1;
  }

  .branch__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .branch__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .branch__desc {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  /* ---------- 帖子节点：左半封面，右半内容 ---------- */

