  .leaf__hit {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* ---------- 「还有 N 篇」 ---------- */

  /* 比文章卡片矮一档、窄一截，一眼看出它不是一篇文章而是个出口 */
  .node--more {
    display: flex;
    /* 两侧字号差了 4px，基线对齐会让小字看着往下坠，改按中心对齐 */
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* 宽度跟文章卡片对齐，不然它挂在一列的末尾会短一截 */
    width: 29rem;
    padding: 0.85rem 1rem;
    border-style: dashed;
