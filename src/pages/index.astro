          if (pairs.length > FLOW_LIMIT) return;

          // 零长度虚线段 + 圆头线帽，渲染出来就是一个沿路径循环移动的圆点
          var flow = wires.querySelector('path.wire-flow[data-key="' + key + '"]');
          var flowFresh = !flow;
          if (flowFresh) {
            flow = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            flow.setAttribute('class', 'wire-flow');
            flow.setAttribute('data-key', key);
            flow.setAttribute('data-owner', pair[2]);
            wires.appendChild(flow);
          }
          flow.setAttribute('d', d);
          flow.style.opacity = '';
          flow.style.transition = '';
          flow.style.setProperty('--wire-len', len + 'px');
          flow.style.strokeDasharray = '0 ' + len;
