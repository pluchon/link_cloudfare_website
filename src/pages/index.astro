  .root__name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .root__bio {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  /* ---------- 分类节点 ---------- */

  .node--branch { width: 17rem; }

  .branch__cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .node--branch .node__body { padding: 0.95rem 1.1rem 1.1rem; }

