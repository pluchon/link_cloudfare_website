  .node__body,
  .root__cover,
  .branch__cover,
  .leaf__cover,
  .leaf__body,
  .node--tags .tag-row {
    position: relative;
    z-index: 1;
  }

  /* ---------- 根节点：左半封面，右半内容 ---------- */

  .node--root {
    display: grid;
    grid-template-columns: 50% minmax(0, 1fr);
    width: 28rem;
    /* 用 start 而不是 stretch，否则 aspect-ratio 会被拉伸吃掉 */
    align-items: start;
  }

  /* 头像原始比例 215×232，竖版，不要按横图裁 */
  .root__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 215 / 232;
    align-self: start;
    object-fit: cover;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .node--root .node__body {
    align-self: stretch;
    padding: 1.5rem 1.35rem;
    /* 分隔线放在右栏，才能跟着整行高度撑满 */
    border-left: var(--hair) solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
