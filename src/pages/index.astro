        map.querySelectorAll('[data-knob]').forEach(function (knob) {
          var key = knob.getAttribute('data-knob');
          var group = map.querySelector('[data-group="' + key + '"]');
          if (!isOpen(group)) return;
          var parent = knob.closest('.node');
          if (!parent) return;

          group.querySelectorAll('[data-node]').forEach(function (child) {
