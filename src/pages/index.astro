      /* ---------- 连线 ---------- */

      // 收起时让线沿原路缩回父节点，和卡片一起退场
      function retractWires(key) {
        wires.querySelectorAll('[data-owner="' + key + '"]').forEach(function (p) {
          if (p.classList.contains('wire-flow')) {
            p.style.transition = 'opacity 180ms linear';
            p.style.opacity = '0';
            return;
