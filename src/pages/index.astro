      m.canvas.removeEventListener('pointerdown', m.onDown);
      m.canvas.removeEventListener('click', m.onClick, true);
      m.canvas.removeEventListener('dragstart', m.onDragStart);
      m.canvas.removeEventListener('pointerleave', m.onLeave);
      m.canvas.removeEventListener('wheel', m.onWheel);
      window.removeEventListener('keydown', m.onKey);
      window.removeEventListener('pointermove', m.onMove);
      window.removeEventListener('pointerup', m.onUp);
