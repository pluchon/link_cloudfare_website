---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DotBackdrop from '../../components/DotBackdrop.astro';
import { getAllPublished, tagCounts } from '../../lib/content';

const all = await getAllPublished();
const tags = tagCounts(all.map((item) => item.entry));
---

<BaseLayout title="标签" description="按话题浏览全部内容。">
  <DotBackdrop />

  <section class="wrap head">
    <div class="head__row" data-reveal>
      <h1 class="head__title">标签</h1>
      <p class="head__meta">共 {tags.length} 个话题，{all.length} 篇内容</p>
    </div>
  </section>

  <section class="wrap body">
    {
      tags.length > 0 ? (
        <ul class="tag-index">
          {tags.map(({ tag, count }) => (
            <li class="tag-index__item">
              <a href={`/tags/${encodeURIComponent(tag)}/`}>
                <span class="tag-index__name">{tag}</span>
                <span class="tag-index__count">{String(count).padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">这里还空着...</p>
      )
    }
  </section>
</BaseLayout>

<style>
  /* 背景是 fixed 的，内容层要抬上来 */
  .head,
  .body {
    position: relative;
    z-index: 1;
  }

  .head {
    padding-block: 2rem 1.5rem;
  }

  /* 标题在左，统计贴到同一行的最右侧 */
  .head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 1.25rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .head__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .head__meta {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    text-align: right;
  }

  .body {
    padding-bottom: 4rem;
  }

  .empty-state {
    display: grid;
    place-content: center;
    min-height: 45vh;
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.9375rem;
  }

  .tag-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    border-top: var(--hair) solid var(--line);
    border-left: var(--hair) solid var(--line);
  }

  .tag-index__item {
    border-right: var(--hair) solid var(--line);
    border-bottom: var(--hair) solid var(--line);
  }

  .tag-index__item a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }

  .tag-index__item a:hover {
    background: var(--accent-wash);
    color: var(--accent);
  }

  .tag-index__name {
    font-family: var(--font-serif);
    font-size: 1rem;
  }

  .tag-index__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  @media (max-width: 44rem) {
    .head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .head__title { white-space: normal; }
    .head__meta { text-align: left; }
  }
</style>
