---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import PixelBackdrop from '../../components/PixelBackdrop.astro';
import { getAllPublished, tagCounts, type ContentKind, type AnyEntry } from '../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const all = await getAllPublished();
  return tagCounts(all.map((item) => item.entry)).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      items: all.filter((item) => item.entry.data.tags.includes(tag)),
    },
  }));
};

const { tag, items } = Astro.props as {
  tag: string;
  items: { kind: ContentKind; entry: AnyEntry }[];
};
---

<BaseLayout title={`标签：${tag}`} description={`标记为「${tag}」的全部内容。`}>
  <PixelBackdrop />

  <section class="wrap head">
    <div class="head__row" data-reveal>
      <h1 class="head__title">{tag}</h1>
      <p class="head__meta">
        共 {items.length} 篇 · <a class="text-link" href="/tags/">全部标签</a>
      </p>
    </div>
  </section>

  <section class="wrap body">
    <div class="entry-list">
      {items.map(({ kind, entry }) => <EntryRow kind={kind} entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* 背景是 fixed 的，内容层要抬上来 */
  .head,
  .body {
    position: relative;
    z-index: 1;
  }

  .head {
    padding-block: 2rem 1.5rem;
  }

  /* 标题在左，篇数和入口贴到同一行的最右侧 */
  .head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 1.25rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .head__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .head__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .body {
    padding-bottom: 4rem;
  }

  @media (max-width: 44rem) {
    .head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .head__title { white-space: normal; }
  }
</style>
