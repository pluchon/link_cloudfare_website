---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getAllPublished, tagCounts, type ContentKind, type AnyEntry } from '../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const all = await getAllPublished();
  return tagCounts(all.map((item) => item.entry)).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      items: all.filter((item) => item.entry.data.tags.includes(tag)),
    },
  }));
};

const { tag, items } = Astro.props as {
  tag: string;
  items: { kind: ContentKind; entry: AnyEntry }[];
};
---

<BaseLayout title={`标签：${tag}`} description={`标记为「${tag}」的全部文章与资料。`}>
  <section class="wrap head">
    <p class="label">Topic</p>
    <h1 class="head__title">{tag}</h1>
    <p class="head__desc">
      共 {items.length} 篇 · <a class="text-link" href="/tags/">全部标签</a>
    </p>
  </section>

  <section class="wrap body">
    <div class="entry-list">
      {items.map(({ kind, entry }) => <EntryRow kind={kind} entry={entry} showKind />)}
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2.75rem, 7vw, 4.5rem) 2rem;
  }

  .head__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0.9rem 0 0;
    letter-spacing: 0.02em;
  }

  .head__desc {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 1.1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }

  .body {
    padding-bottom: 4rem;
  }
</style>
