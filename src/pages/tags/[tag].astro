---
import type { GetStaticPaths } from 'astro';
import ListLayout from '../../layouts/ListLayout.astro';
import { pageBackdrops } from '../../config/site';
import { getAllPublished, tagCounts, paginateEntries, type ContentKind, type AnyEntry } from '../../lib/content';

// 单个标签的聚合页：和分类页同一套布局（标题行、搜索框、列表、翻页），只是条目跨分类、没有封面位
export const getStaticPaths: GetStaticPaths = async () => {
  const all = await getAllPublished();
  return tagCounts(all.map((item) => item.entry)).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      items: all.filter((item) => item.entry.data.tags.includes(tag)),
    },
  }));
};

const { tag, items } = Astro.props as {
  tag: string;
  items: { kind: ContentKind; entry: AnyEntry }[];
};
const pages = paginateEntries(items);
---

<ListLayout
  title={tag}
  docTitle={`标签：${tag}`}
  description={`标记为「${tag}」的内容，共 ${items.length} 篇`}
  icon="tags"
  backdrop={pageBackdrops.tagDetail}
  cover={null}
  items={pages[0]}
  allItems={items}
  page={1}
  totalPages={pages.length}
  basePath={`/tags/${encodeURIComponent(tag)}/`}
/>
