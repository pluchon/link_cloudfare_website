---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaletteDecor from '../components/PaletteDecor.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import '../styles/prose.css';
import { getCollection, render } from 'astro:content';
import { site, profile, pageBackdrops } from '../config/site';

// 正文与仓库同步：内容来自 src/content/profile/，改完推送即上线
const docs = await getCollection('profile');
const doc = docs.find((d) => d.id === 'my_introduction') ?? docs[0];
const Intro = doc ? (await render(doc)).Content : null;
// 技能标签来自 profile 正文里的 tags 行
const skills = doc?.data.skills ?? [];
---

<BaseLayout title="关于" description={`关于 ${site.name}`}>
  <PageBackdrop art={pageBackdrops.about} quiet />
  <PaletteDecor />

  <section class="wrap card-wrap">
    <div class="card" data-reveal>
      {
        profile.avatar ? (
          <img class="card__cover" src={profile.avatar} alt="" width="215" height="232" />
        ) : (
          <div class="card__cover cover-ph">头像待补</div>
        )
      }

      <div class="card__body">
        <h1 class="card__name">{profile.name}</h1>
        <p class="card__bio">{profile.bio}</p>

        <ul class="links">
          {
            profile.links.map((link) => (
              <li>
                <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
                  <img
                    class:list={['link__icon', link.mono && 'link__icon--mono']}
                    src={link.icon}
                    alt=""
                    width="18"
                    height="18"
                  />
                  <span class="link__label">{link.label}</span>
                  <span class="link__out" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        {
          skills.length > 0 && (
            <div class="skills">
              {skills.map((skill) => (
                <span class="tag">{skill}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    Intro && (
      <>
        <div class="wrap">
          <div class="rule-tab" aria-hidden="true" />
        </div>

        <section class="wrap body">
          <div class="body__sheet" data-reveal>
            <i class="body__corner body__corner--tl" aria-hidden="true" />
            <i class="body__corner body__corner--tr" aria-hidden="true" />
            <i class="body__corner body__corner--bl" aria-hidden="true" />
            <i class="body__corner body__corner--br" aria-hidden="true" />

            <header class="body__head" aria-hidden="true">
              <span class="body__dots"><i /><i /><i /></span>
              <span class="body__meta">PROFILE · NOTES</span>
              <span class="body__code">ABOUT // 01</span>
            </header>

            <div class="prose body__prose">
              <Intro />
            </div>

            <footer class="body__foot" aria-hidden="true">
              <span class="body__foot-line" />
              <span class="body__foot-mark">✦ NUONUO · BASE ARCHIVE ✦</span>
              <span class="body__foot-line" />
            </footer>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>

<style>
  .card-wrap {
    padding-block: 2.5rem 2.25rem;
  }

  /* 名片：左半头像，右半信息，和首页根节点保持同一个构图 */
  .card {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    align-items: start;
    border: var(--hair) solid var(--line);
  }

  /* 头像原始比例 215×232，竖版 */
  .card__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 215 / 232;
    align-self: start;
    object-fit: cover;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .card__body {
    align-self: stretch;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-left: var(--hair) solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card__name {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .card__bio {
    margin: 1rem 0 1.5rem;
    color: var(--fg-muted);
    line-height: 1.85;
  }

  /* ---------- 社交链接 ---------- */

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem 0.5rem 0.6rem;
    border: var(--hair) solid var(--line);
    border-radius: 8px;
    background: var(--bg-elev);
    font-size: 0.875rem;
    line-height: 1;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  :root[data-theme='dark'] .link { background: var(--bg-sunken); }

  .link:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* 各图标源文件的 viewBox 从 24 到 512 都有，
     所以必须钉死盒子尺寸再 contain，否则渲染出来大小不一 */
  .link__icon {
    width: 18px;
    height: 18px;
    flex: none;
    object-fit: contain;
  }

  /* GitHub 那个图标的 path 没写 fill，默认就是纯黑，深色模式下等于隐形。
     图标是 <img> 引进来的，CSS 够不着 SVG 内部，只能整体反色把黑翻成白 */
  :global(:root[data-theme='dark']) .link__icon--mono {
    filter: invert(1);
  }

  .link__label { font-weight: 500; }

  .link__out {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .link:hover .link__out { color: var(--accent); }

  /* ---------- 技能标签 ---------- */

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: var(--hair) solid var(--line);
  }

  .body {
    padding-block: 2.25rem 4.5rem;
  }

  .body__sheet {
    position: relative;
    border: var(--hair) solid var(--line);
    background: color-mix(in srgb, var(--bg) 62%, transparent);
  }

  .body__corner {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    pointer-events: none;
  }

  .body__corner--tl {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
  }

  .body__corner--tr {
    top: -1px;
    right: -1px;
    border-top: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
  }

  .body__corner--bl {
    bottom: -1px;
    left: -1px;
    border-bottom: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
  }

  .body__corner--br {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
  }

  .body__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem clamp(1.25rem, 3vw, 2.25rem);
    border-bottom: var(--hair) dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .body__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .body__dots i {
    width: 0.45rem;
    height: 0.45rem;
    border: var(--hair) solid var(--fg-faint);
    border-radius: 50%;
  }

  .body__dots i:first-child {
    border-color: var(--accent);
    background: var(--accent);
  }

  .body__code {
    margin-left: auto;
  }

  /* 正文与上方名片等宽，不再收进 46rem 的阅读栏宽 */
  .body .prose {
    max-width: none;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .body__prose :global(h2) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.55rem;
    border-bottom: var(--hair) dashed var(--line);
  }

  .body__prose :global(h2::before) {
    content: '§';
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 400;
    color: var(--accent);
  }

  .body__foot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 clamp(1.25rem, 3vw, 2.25rem) 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--fg-faint);
  }

  .body__foot-line {
    flex: 1;
    border-top: var(--hair) dashed var(--line);
  }

  @media (max-width: 44rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }

    .card__cover {
      max-width: 15rem;
      margin-inline: auto;
      margin-top: clamp(1.5rem, 3vw, 2.25rem);
    }

    .card__body {
      border-left: 0;
    }
  }
</style>
