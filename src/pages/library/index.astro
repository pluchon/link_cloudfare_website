---
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublished, paginateEntries } from '../../lib/content';

const entries = await getPublished('library');
const pages = paginateEntries(entries);
---

<ListLayout
  kind="library"
  label="Library"
  title="学习资料"
  description="整理过的教程、清单与外链附件，按主题归档。"
  entries={pages[0]}
  page={1}
  totalPages={pages.length}
  basePath="/library/"
  emptyText="资料区还空着。"
/>
