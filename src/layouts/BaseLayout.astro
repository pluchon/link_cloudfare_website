---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  // canvas：整屏不滚动的画布式页面（首页）；page：常规滚动页面
  variant?: 'page' | 'canvas';
  // 分页页面的上下页地址，用于 rel=prev/next
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = site.description,
  ogImage,
  noindex = false,
  variant = 'page',
  prevUrl,
  nextUrl,
} = Astro.props;

// 浏览器标签只显示页面标题；首页没有 title，用站点全称
const pageTitle = title ?? site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, site.url).href} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, site.url).href} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/icon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <ClientRouter />

    <!-- 主题必须在首帧前定好，否则深色模式会闪一下白；
         .js 也在这里打上，入场动画的初始隐藏状态只在有 JS 时才生效 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');

        var stored = null;
        try {
          stored = localStorage.getItem('nn-theme');
        } catch (e) {
          /* 隐私模式读取失败时退回系统偏好 */
        }
        var dark =
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';

        // 主题色也要在首帧前定好，否则会先闪一下默认的墨色
        var palette = null;
        try {
          palette = localStorage.getItem('nn-palette');
        } catch (e) {
          /* 隐私模式读取失败时用默认色 */
        }
        root.dataset.palette = palette || 'ink';
      })();
    </script>

    <!-- 放在 head：ClientRouter 换页时不会重复执行，事件不会重复绑定 -->
    <script is:inline>
      (function () {
        function setTheme(next) {
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('nn-theme', next);
          } catch (e) {
            /* 隐私模式下写入失败时静默降级 */
          }
        }

        function setPalette(next) {
          document.documentElement.dataset.palette = next;
          try {
            localStorage.setItem('nn-palette', next);
          } catch (e) {
            /* 隐私模式下写入失败时静默降级 */
          }
          markPalette();
        }

        // 菜单里打钩的那一项跟着当前主题色走
        function markPalette() {
          var now = document.documentElement.dataset.palette || 'ink';
          document.querySelectorAll('[data-palette-set]').forEach(function (btn) {
            btn.setAttribute('aria-checked', btn.dataset.paletteSet === now ? 'true' : 'false');
          });
        }

        // ClientRouter 换页时会用新文档的 <html> 属性覆盖当前的，
        // 而 data-theme / data-palette 是运行时加的、新文档里没有，
        // 于是一导航就被抹掉退回默认。每次换完页重新贴一次
        function restoreTheme() {
          var root = document.documentElement;
          root.classList.add('js');
          var stored = null;
          var palette = null;
          try {
            stored = localStorage.getItem('nn-theme');
            palette = localStorage.getItem('nn-palette');
          } catch (e) {
            /* 隐私模式读取失败时退回系统偏好 */
          }
          var dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'dark' : 'light';
          root.dataset.palette = palette || 'ink';
          markPalette();
        }

        document.addEventListener('astro:after-swap', restoreTheme);
        document.addEventListener('astro:page-load', markPalette);

        // 不走 View Transitions API：它被浏览器跳过时 ready 会 reject，
        // 动画不执行而主题已经切了，表现就是整屏瞬间换色。
        //
        // 幕布淡入 → 完全不透明后才切主题 → 幕布上放一整幅线条画 → 幕布淡出。
        // 白天：黑底白线，太阳从群山背后升起，出山之后才长出光线并慢慢转；
        //       天上有云（灰→白）和一群飞向远处的大雁，地上是带小花的草地。
        // 夜里：白底黑线，月亮从湖对岸的地平线升起，然后流星划过；
        //       湖里有鸭子和荷叶荷花，岸边是草，空中有萤火虫和银河。
        //
        // 图层从后往前：sky（天上的东西）→ icon（日月）→ terrain（群山 / 湖面）
        // → ground（近处的草）。日月被 terrain 挡住，所以「升起」才成立。
        //
        // 幕布淡入 240ms，淡入结束（transitionend）就切主题；SWAP_AT 只是兜底
        var SWAP_AT = 600;
        var RETRACT_AT = 3000;
        var LEAVE_AT = 3400;
        var DONE_AT = 3900;
        var switching = false;

        // 固定种子的伪随机：每次画出来的山形、草地、银河都一样，不会忽密忽疏
        function seeded(seed) {
          return function () {
            seed = (seed + 0x6d2b79f5) | 0;
            var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }

        // 一朵线条云：从右下角起笔，先沿底边画到左端，再一路拱回起点。
        // 一笔画完自己的轮廓，不会「绕一圈再回头补一条底线」
        var CLOUD = 'M46 0H0a8 8 0 0 1 6-12a12 12 0 0 1 22-4a9 9 0 0 1 16 8a6 6 0 0 1 2 8Z';

        // 太阳：圆本身不画线，它是升上来的；光线等它整个出了山才长出来
        function sunMarkup() {
          var rays = '';
          for (var i = 0; i < 8; i++) {
            var a = (i * Math.PI) / 4 - Math.PI / 2;
            var inner = 36;
            var outer = i % 2 ? 44 : 48;
            // 八条光线一起淡入，不逐条错开——错开看着仍然像在「一笔一笔画轮廓」。
            // 等太阳快升到位（升起是 800~2400ms）才亮起来
            rays +=
              '<line class="theme-scene__ray" stroke-width="2" style="--delay:' +
              1900 +
              'ms" x1="' +
              (100 + inner * Math.cos(a)).toFixed(1) +
              '" y1="' +
              (100 + inner * Math.sin(a)).toFixed(1) +
              '" x2="' +
              (100 + outer * Math.cos(a)).toFixed(1) +
              '" y2="' +
              (100 + outer * Math.sin(a)).toFixed(1) +
              '"/>';
          }
          return (
            '<circle class="theme-scene__orb" cx="100" cy="100" r="25" stroke-width="2.2"/>' +
            '<g class="theme-scene__rays">' +
            rays +
            '</g>'
          );
        }

        // 月亮：同样不画线，从地平线升起来。星星等它升到位再冒出来
        function moonMarkup() {
          var moon =
            '<path class="theme-scene__orb" stroke-width="0.44"' +
            ' transform="translate(40 40) scale(5)"' +
            ' d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
          var stars = [
            [143, 57, 1.1],
            [40, 81, 0.7],
            [154, 81, 0.75],
            [21, 121, 0.55],
            [57, 152, 0.75],
            [138, 161, 0.7],
            [196, 131, 0.55],
          ];
          var out = '';
          stars.forEach(function (s, i) {
            out +=
              '<g transform="translate(' +
              s[0] +
              ' ' +
              s[1] +
              ') scale(' +
              s[2] +
              ')"><path class="theme-scene__star" style="--delay:' +
              (1700 + i * 120) +
              'ms" d="M0 -6L0.8 -0.8L6 0L0.8 0.8L0 6L-0.8 0.8L-6 0L-0.8 -0.8Z"/></g>';
          });
          return moon + out;
        }

        // 月亮周围的流星：画在月亮这张图里、排在月亮后面，所以压在月亮上一层。
        // 起点只挑离「穿过圆心的 45° 斜线」足够远的位置，划过时不会从月亮身上穿过
        function meteorMarkup() {
          var rand = seeded(7);
          var out =
            '<defs><linearGradient id="nn-meteor-trail" x1="0" y1="1" x2="1" y2="0">' +
            '<stop offset="0" stop-color="currentColor" stop-opacity="0"/>' +
            '<stop offset="1" stop-color="currentColor" stop-opacity="0.75"/>' +
            '</linearGradient></defs>';
          var made = 0;
          var tries = 0;
          while (made < 14 && tries < 400) {
            tries++;
            var angle = rand() * Math.PI * 2;
            var dist = 50 + rand() * 105;
            var dx = Math.cos(angle) * dist;
            var dy = Math.sin(angle) * dist;
            if (Math.abs(dx + dy) / Math.SQRT2 < 42) continue;

            var x = 100 + dx;
            var y = 100 + dy;
            var len = Math.round(12 + rand() * 14);
            out +=
              '<line class="theme-scene__meteor" x1="' +
              x.toFixed(1) +
              '" y1="' +
              y.toFixed(1) +
              '" x2="' +
              (x + len).toFixed(1) +
              '" y2="' +
              (y - len).toFixed(1) +
              '" style="--delay:' +
              Math.round(1900 + made * 150 + rand() * 160) +
              'ms;--dur:' +
              Math.round(1900 + rand() * 700) +
              'ms;--run:' +
              Math.round(34 + rand() * 22) +
              'px"/>';
            made++;
          }
          return out;
        }

        // 天上：白天是云和大雁，夜里是银河、星星和更远的流星。
        // 这一层压在最后面，会被群山和湖面挡住
        function skyMarkup(night, geom) {
          var W = geom.W;
          var rand = seeded(night ? 31 : 37);
          var out = '';

          function pick(top, bottom) {
            for (var i = 0; i < 40; i++) {
              var x = rand() * W;
              var y = top + rand() * (bottom - top);
              if (Math.hypot(x - W / 2, y - geom.centerY) > geom.keepOut) return [x, y];
            }
            return null;
          }

          if (night) {
            // 银河：一条从左下贯穿到右上的星带，中间厚两侧薄，一直铺到地平线。
            // 垂直方向用三个随机数相加逼近正态分布。
            // 不在月亮那一圈挖空——银河是最底层，月亮内部填了底色，
            // 自然就把穿过它的那一段挡住了，月亮之外照常看得见
            var bandW = Math.max(120, Math.min(260, geom.H * 0.3));
            var dust = Math.round(Math.min(420, (W * geom.horizonY) / 2400));
            for (var d = 0; d < dust; d++) {
              var t = rand();
              var bx = -W * 0.2 + t * W * 1.4;
              var by = geom.horizonY + 40 - t * (geom.horizonY + 140);
              var spread = ((rand() + rand() + rand()) / 1.5 - 1) * bandW;
              var px = bx + spread * 0.3;
              var py = by + spread;
              if (py < -20 || py > geom.horizonY - 6 || px < -20 || px > W + 20) continue;
              var near = 1 - Math.min(1, Math.abs(spread) / bandW);
              out +=
                '<circle class="theme-scene__dust" cx="' +
                px.toFixed(0) +
                '" cy="' +
                py.toFixed(0) +
                '" r="' +
                (0.5 + near * 1.2 + rand() * 0.4).toFixed(2) +
                '" style="--o:' +
                (0.2 + near * 0.7).toFixed(2) +
                ';--delay:' +
                Math.round(400 + rand() * 1500) +
                'ms"/>';
            }

            var stars = Math.max(8, Math.min(22, Math.round((W * geom.H) / 52000)));
            for (var s = 0; s < stars; s++) {
              var sp = pick(10, geom.horizonY - 40);
              if (!sp) continue;
              out +=
                '<g transform="translate(' +
                sp[0].toFixed(0) +
                ' ' +
                sp[1].toFixed(0) +
                ') scale(' +
                (0.35 + rand() * 0.45).toFixed(2) +
                ')"><path class="theme-scene__star" style="--delay:' +
                Math.round(1700 + rand() * 900) +
                'ms" d="M0 -6L0.8 -0.8L6 0L0.8 0.8L0 6L-0.8 0.8L-6 0L-0.8 -0.8Z"/></g>';
            }

            // 更远处的流星：都压在地平线以上，不会像之前那样从湖里冒出来
            for (var m = 0; m < 6; m++) {
              var mp = pick(20, geom.horizonY - 70);
              if (!mp) continue;
              var len = Math.round(26 + rand() * 26);
              out +=
                '<line class="theme-scene__meteor" x1="' +
                mp[0].toFixed(0) +
                '" y1="' +
                mp[1].toFixed(0) +
                '" x2="' +
                (mp[0] + len).toFixed(0) +
                '" y2="' +
                (mp[1] - len).toFixed(0) +
                '" style="--delay:' +
                Math.round(2000 + m * 300 + rand() * 200) +
                'ms;--dur:' +
                Math.round(2400 + rand() * 800) +
                'ms;--run:' +
                Math.round(110 + rand() * 90) +
                'px"/>';
            }
          } else {
            // 云：全都挂在远处的天上，画完之后由灰转白、慢慢飘
            for (var c = 0; c < 6; c++) {
              var cp = pick(60, geom.horizonY - 90);
              if (!cp) continue;
              var scale = 1.3 + rand() * 1.2;
              var delay = Math.round(500 + c * 170 + rand() * 160);
              out +=
                '<g transform="translate(' +
                cp[0].toFixed(0) +
                ' ' +
                cp[1].toFixed(0) +
                ') scale(' +
                scale.toFixed(2) +
                ')"><g class="theme-scene__cloud" style="--drift:' +
                (rand() < 0.5 ? '' : '-') +
                Math.round(5 + rand() * 6) +
                'px;--drift-delay:' +
                (delay + 900) +
                'ms"><path class="draw" pathLength="1" style="--delay:' +
                delay +
                'ms;--dur:900ms" d="' +
                CLOUD +
                '"/></g></g>';
            }

            // 一行大雁：排成人字，一边扇翅膀一边往右上方飞远（越飞越小）
            var flockX = W * 0.62;
            var flockY = geom.horizonY - geom.H * 0.34;
            var geese = '';
            [
              [0, 0, 1],
              [-26, 12, 0.9],
              [-52, 24, 0.82],
              [26, 12, 0.9],
              [52, 24, 0.82],
              [-78, 36, 0.72],
            ].forEach(function (g, i) {
              geese +=
                '<g transform="translate(' +
                g[0] +
                ' ' +
                g[1] +
                ') scale(' +
                g[2] +
                ')"><path class="theme-scene__bird" style="--delay:' +
                (1500 + i * 120) +
                'ms" d="M-7 0q3.5-4.5 7 0q3.5-4.5 7 0"/></g>';
            });
            // 位置写在外层的 transform 属性上，飞远写在内层的 CSS 动画里：
            // 同一个元素上这两者会互相覆盖
            out +=
              '<g transform="translate(' +
              flockX.toFixed(0) +
              ' ' +
              flockY.toFixed(0) +
              ')"><g class="theme-scene__flock">' +
              geese +
              '</g></g>';
          }

          return (
            '<svg class="theme-scene__sky" viewBox="0 0 ' +
            Math.round(W) +
            ' ' +
            Math.round(geom.H) +
            '" preserveAspectRatio="none" aria-hidden="true">' +
            out +
            '</svg>'
          );
        }

        // 中景：白天是层叠的群山，夜里是湖。
        // 这一层不透明，而且压在日月之上——日月正是从它背后升起来的。
        // 每道山脊、湖面都是填了幕布底色的封闭形状，近的自然盖住远的
        function terrainMarkup(night, geom) {
          var W = geom.W;
          var H = geom.H;
          var rand = seeded(night ? 53 : 59);
          var out = '';

          if (night) {
            // 湖：从对岸的地平线一直铺到近岸的草地
            var lakeBottom = H - geom.groundH + 10;
            out +=
              '<path class="theme-scene__water" d="M-40 ' +
              geom.horizonY.toFixed(0) +
              'Q' +
              (W * 0.3).toFixed(0) +
              ' ' +
              (geom.horizonY - 8).toFixed(0) +
              ' ' +
              (W * 0.62).toFixed(0) +
              ' ' +
              (geom.horizonY - 1).toFixed(0) +
              'T' +
              (W + 40).toFixed(0) +
              ' ' +
              (geom.horizonY - 5).toFixed(0) +
              'L' +
              (W + 40).toFixed(0) +
              ' ' +
              lakeBottom.toFixed(0) +
              'L-40 ' +
              lakeBottom.toFixed(0) +
              'Z"/>' +
              // 对岸那条线单独描一遍，地平线要清楚。
              // 和群山同理：要在月亮升起（800ms）之前画完
              '<path class="draw" pathLength="1" style="--delay:80ms;--dur:620ms" d="M-40 ' +
              geom.horizonY.toFixed(0) +
              'Q' +
              (W * 0.3).toFixed(0) +
              ' ' +
              (geom.horizonY - 8).toFixed(0) +
              ' ' +
              (W * 0.62).toFixed(0) +
              ' ' +
              (geom.horizonY - 1).toFixed(0) +
              'T' +
              (W + 40).toFixed(0) +
              ' ' +
              (geom.horizonY - 5).toFixed(0) +
              '"/>';

            var lakeH = lakeBottom - geom.horizonY;

            // 水面波纹
            var ripples = Math.round(Math.min(26, W / 64));
            for (var w = 0; w < ripples; w++) {
              var ry = geom.horizonY + 18 + rand() * (lakeH - 30);
              var deep = (ry - geom.horizonY) / lakeH;
              var rw = 24 + rand() * (60 + deep * 170);
              var rx = rand() * (W - rw);
              out +=
                '<line class="draw" pathLength="1" stroke-opacity="' +
                (0.3 + deep * 0.4).toFixed(2) +
                '" x1="' +
                rx.toFixed(0) +
                '" y1="' +
                ry.toFixed(0) +
                '" x2="' +
                (rx + rw).toFixed(0) +
                '" y2="' +
                ry.toFixed(0) +
                '" style="--delay:' +
                Math.round(1000 + w * 70 + rand() * 200) +
                'ms;--dur:700ms"/>';
            }

            // 月亮的倒影：正下方一列短横线，越往下越散
            for (var g = 0; g < 7; g++) {
              var my = geom.horizonY + 24 + g * ((lakeH - 40) / 7);
              var mw = (56 - g * 4) * (0.7 + rand() * 0.6);
              var jitter = (rand() - 0.5) * 26;
              out +=
                '<line class="draw" pathLength="1" stroke-opacity="' +
                (0.85 - g * 0.08).toFixed(2) +
                '" x1="' +
                (W / 2 + jitter - mw / 2).toFixed(0) +
                '" y1="' +
                my.toFixed(0) +
                '" x2="' +
                (W / 2 + jitter + mw / 2).toFixed(0) +
                '" y2="' +
                my.toFixed(0) +
                '" style="--delay:' +
                Math.round(2100 + g * 130) +
                'ms;--dur:600ms"/>';
            }

            // 荷叶：一个完整的椭圆加一道缺口线。
            // 之前用「绕一大圈再收回圆心」的路径画缺口，配上虚线画线动画收不齐，
            // 看着就是没闭合。现在轮廓归轮廓、缺口归缺口，两笔各画各的。
            // 椭圆填幕布底色，把身下的水纹挡掉
            [
              [W * 0.16, 0.5, 1.2],
              [W * 0.23, 0.72, 0.95],
              [W * 0.3, 0.9, 0.78],
              [W * 0.75, 0.6, 1.1],
              [W * 0.83, 0.82, 0.88],
            ].forEach(function (p, i) {
              var py = geom.horizonY + lakeH * p[1];
              out +=
                '<g transform="translate(' +
                p[0].toFixed(0) +
                ' ' +
                py.toFixed(0) +
                ') scale(' +
                p[2] +
                ')"><ellipse class="theme-scene__pad" rx="22" ry="12" style="--delay:' +
                (1600 + i * 170) +
                'ms"/>' +
                '<path class="draw" pathLength="1" style="--delay:' +
                (1950 + i * 170) +
                'ms;--dur:350ms" d="M0 0l21 4"/></g>';
            });
          } else {
            // 群山：远处高而尖，近处矮而缓，最前面一层是只有远山一半高的小丘。
            // 每道都是封闭并填底色的形状，从远到近依次画，近的盖住远的，
            // 太阳也藏在它们后面。
            // [峰高占屏高, 线的浓淡, 基线比地平线低多少, 每段宽度, 是否画成圆缓的曲线]
            [
              [0.3, 0.4, 0, 6, false],
              [0.15, 0.68, 46, 4, false],
              [0.07, 0.95, 104, 3, true],
            ].forEach(function (cfg, i) {
              var base = geom.horizonY + cfg[2];
              var ceiling = geom.centerY + geom.keepOut * 0.5;
              var maxLift = Math.max(40, Math.min(H * cfg[0], base - ceiling));
              var step = W / cfg[3];
              var pts = 'M-40 ' + base.toFixed(0);

              for (var x = -40 + step * (0.3 + rand() * 0.4); x < W + 40; x += step) {
                var peak = base - maxLift * (0.5 + rand() * 0.5);
                var dip = base - maxLift * 0.18 * rand();
                var half = step * (0.35 + rand() * 0.3);
                if (cfg[4]) {
                  // 近处的小丘：用二次曲线，圆缓，没有尖角
                  pts +=
                    'Q' + (x - step * 0.25).toFixed(0) + ' ' + peak.toFixed(0) +
                    ' ' + x.toFixed(0) + ' ' + ((peak + dip) / 2).toFixed(0) +
                    'Q' + (x + half * 0.6).toFixed(0) + ' ' + dip.toFixed(0) +
                    ' ' + (x + half).toFixed(0) + ' ' + dip.toFixed(0);
                } else {
                  pts +=
                    'L' + x.toFixed(0) + ' ' + peak.toFixed(0) +
                    'L' + (x + half).toFixed(0) + ' ' + dip.toFixed(0);
                }
              }

              // 右端落回基线，再沿屏幕底边绕回左端封口
              pts +=
                'L' + (W + 40).toFixed(0) + ' ' + base.toFixed(0) +
                'L' + (W + 40).toFixed(0) + ' ' + (H + 40).toFixed(0) +
                'L-40 ' + (H + 40).toFixed(0) + 'Z';
              out +=
                '<path class="draw theme-scene__ridge" pathLength="1" stroke-opacity="' +
                cfg[1] +
                // 山要在太阳升起之前画完，否则太阳会先从还没画出来的山那里冒出来。
                // 三道山脊在 800ms 内全部画完，太阳 800ms 才开始升
                '" style="--delay:' +
                (60 + i * 120) +
                'ms;--dur:' +
                (620 - i * 60) +
                'ms" d="' +
                pts +
                '"/>';
            });
          }

          return (
            '<svg class="theme-scene__terrain" viewBox="0 0 ' +
            Math.round(W) +
            ' ' +
            Math.round(H) +
            '" preserveAspectRatio="none" aria-hidden="true">' +
            out +
            '</svg>'
          );
        }

        // 近处的地面：一丛丛的草，白天点几朵小花，夜里是岸边的草和萤火虫。
        // viewBox 的宽度按屏幕比例现算，所以手机和电脑上草的粗细高矮一致
        function groundMarkup(night, geom) {
          var rand = seeded(11);
          var groundH = geom.groundH;
          var width = Math.max(200, Math.round((160 * geom.W) / groundH));
          var out = '';

          // 一丛草：三五根从同一点散出来，比一根根等距排开自然。
          // 从 30 开始，太靠边的一丛会被屏幕切掉，看着像一块白团
          for (var x = 30; x < width - 20; x += 16 + rand() * 20) {
            var blades = 2 + Math.round(rand() * 3);
            var delay = Math.round(300 + (x / width) * 1000 + rand() * 160);
            for (var b = 0; b < blades; b++) {
              var h = 18 + rand() * 34 + (rand() < 0.12 ? 26 : 0);
              var lean = (b - (blades - 1) / 2) * (5 + rand() * 5) + (rand() - 0.5) * 6;
              var bx = x + (rand() - 0.5) * 5;
              out +=
                '<path class="draw theme-scene__blade" pathLength="1" style="--delay:' +
                (delay + b * 40) +
                'ms;--sway:' +
                Math.round(2600 + rand() * 1600) +
                'ms" d="M' +
                bx.toFixed(1) +
                ' 160Q' +
                (bx + lean * 0.3).toFixed(1) +
                ' ' +
                (160 - h * 0.55).toFixed(1) +
                ' ' +
                (bx + lean).toFixed(1) +
                ' ' +
                (160 - h).toFixed(1) +
                '"/>';
            }

            // 白天在草里点几朵小花：一根细茎顶着五片花瓣。
            // 花瓣要描边、填幕布底色——以前是整片填白，缩小之后糊成一小团白点，
            // 贴着屏幕边缘时看着就像画面上多了一块脏东西
            if (!night && x > 70 && x < width - 70 && rand() < 0.2) {
              var fx = x + (rand() - 0.5) * 8;
              var fh = 40 + rand() * 26;
              var petals = '';
              for (var p = 0; p < 5; p++) {
                petals +=
                  '<ellipse rx="2.2" ry="4" transform="rotate(' +
                  (p * 72) +
                  ') translate(0 -4)"/>';
              }
              out +=
                '<g class="theme-scene__flower theme-scene__blade" style="--delay:' +
                (delay + 260) +
                'ms;--sway:' +
                Math.round(3000 + rand() * 1400) +
                'ms">' +
                '<path class="draw" pathLength="1" style="--delay:' +
                (delay + 200) +
                'ms;--dur:600ms" d="M' +
                fx.toFixed(1) +
                ' 160Q' +
                (fx + 3).toFixed(1) +
                ' ' +
                (160 - fh * 0.6).toFixed(1) +
                ' ' +
                fx.toFixed(1) +
                ' ' +
                (160 - fh).toFixed(1) +
                '"/>' +
                // 位置放外层、张开动画放内层：同一个元素上 transform 属性会被动画覆盖，
                // 所有的花会一起塌到原点，在屏幕左边堆成一团
                '<g transform="translate(' +
                fx.toFixed(1) +
                ' ' +
                (160 - fh).toFixed(1) +
                ')"><g class="theme-scene__petals" style="--delay:' +
                (delay + 520) +
                'ms">' +
                petals +
                '</g></g></g>';
            }
          }

          // 白天草上飞几只小虫：两笔的小翅膀，飘来飘去
          if (!night) {
            var bug = seeded(29);
            var bugs = Math.max(4, Math.round(width / 150));
            for (var k = 0; k < bugs; k++) {
              // 位置放外层，飘动放内层：同一个元素上 transform 属性会被动画覆盖
              out +=
                '<g transform="translate(' +
                (((k + 0.3 + bug() * 0.5) / bugs) * width).toFixed(1) +
                ' ' +
                (56 + bug() * 60).toFixed(1) +
                ')"><g class="theme-scene__firefly theme-scene__bug" style="--delay:' +
                Math.round(1600 + bug() * 900) +
                'ms;--float:' +
                Math.round(1600 + bug() * 900) +
                'ms;--glow:' +
                Math.round(700 + bug() * 500) +
                'ms;--dx:' +
                Math.round((bug() - 0.5) * 26) +
                'px;--dy:' +
                Math.round(-8 - bug() * 12) +
                'px"><path d="M-3 0q1.5-2.5 3 0q1.5-2.5 3 0"/></g></g>';
            }
          }

          if (night) {
            var glow = seeded(23);
            var count = Math.max(5, Math.round(width / 90));
            for (var i = 0; i < count; i++) {
              out +=
                '<circle class="theme-scene__firefly" r="' +
                (1.1 + glow() * 0.8).toFixed(2) +
                '" cx="' +
                (((i + 0.2 + glow() * 0.6) / count) * width).toFixed(1) +
                '" cy="' +
                (60 + glow() * 70).toFixed(1) +
                '" style="--delay:' +
                Math.round(1600 + glow() * 1000) +
                'ms;--float:' +
                Math.round(2200 + glow() * 1400) +
                'ms;--glow:' +
                Math.round(900 + glow() * 900) +
                'ms;--dx:' +
                Math.round((glow() - 0.5) * 16) +
                'px;--dy:' +
                Math.round(-6 - glow() * 10) +
                'px"/>';
            }
          }

          return (
            '<svg class="theme-scene__ground" viewBox="0 0 ' +
            width +
            ' 160" preserveAspectRatio="none" aria-hidden="true" style="--ground-h:' +
            groundH +
            'px">' +
            out +
            '</svg>'
          );
        }

        // 切换期间整页锁住，免得误操作。光靠幕布挡住鼠标不够：
        // 键盘还能 Tab 到底下的链接、回车就跳走了；滚轮和手指还能滚动底下的页面；
        // 首页画布的缩放快捷键挂在 window 上，幕布也挡不住。
        // 所以底下的元素全部设 inert，滚动锁掉，键盘和滚轮在捕获阶段拦下
        function lockPage(scene) {
          var root = document.documentElement;
          var overflow = root.style.overflow;
          root.style.overflow = 'hidden';

          var muted = [];
          Array.prototype.forEach.call(document.body.children, function (node) {
            if (node === scene || node.inert) return;
            node.inert = true;
            muted.push(node);
          });

          function swallow(event) {
            event.stopPropagation();
            // 带修饰键的交给浏览器（刷新、开发者工具之类），只是不让页面自己的快捷键响应
            if (event.type === 'keydown' && (event.ctrlKey || event.metaKey || event.altKey)) return;
            if (event.cancelable) event.preventDefault();
          }

          var opts = { capture: true, passive: false };
          ['keydown', 'wheel', 'touchmove'].forEach(function (type) {
            window.addEventListener(type, swallow, opts);
          });

          return function unlock() {
            root.style.overflow = overflow;
            muted.forEach(function (node) {
              node.inert = false;
            });
            ['keydown', 'wheel', 'touchmove'].forEach(function (type) {
              window.removeEventListener(type, swallow, opts);
            });
          };
        }

        function playScene(next, btn, onSwap) {
          var night = next === 'dark';
          var W = window.innerWidth;
          var H = window.innerHeight;
          var landscape = W > H;

          // 画面的几何：近处的草占底下一条，地平线（山脚线 / 湖对岸）压在中间偏下，
          // 日月从地平线后面升到画面中央附近
          var iconSize = Math.min(W * 0.66, 280);
          var geom = {
            W: W,
            H: H,
            iconSize: iconSize,
            keepOut: iconSize * 0.72,
            centerY: night ? H * 0.42 : H / 2,
            groundH: Math.round(Math.min(H * (landscape ? 0.16 : 0.12), 150)),
            horizonY: Math.round(H * (night ? 0.68 : 0.62)),
          };

          var el = document.createElement('div');
          el.className = 'theme-scene';
          el.dataset.mode = night ? 'night' : 'day';
          el.setAttribute('aria-hidden', 'true');
          // 顺序就是层级：天空在最后面，然后日月，再是群山 / 湖面，最后是近处的草
          el.innerHTML =
            skyMarkup(night, geom) +
            '<svg class="theme-scene__icon" viewBox="0 0 200 200">' +
            (night ? moonMarkup() + meteorMarkup() : sunMarkup()) +
            '</svg>' +
            terrainMarkup(night, geom) +
            groundMarkup(night, geom);

          // 日月都从地平线后面升起：起点压到地平线下方一点
          el.style.setProperty(
            '--rise-y',
            Math.round(geom.horizonY - geom.centerY + iconSize * 0.3) + 'px',
          );

          document.body.appendChild(el);
          var unlock = lockPage(el);

          var timers = [];
          var swapped = false;
          var finished = false;

          function swap() {
            if (swapped) return;
            swapped = true;
            onSwap();
          }

          // 只能收尾一次：兜底计时器晚到时，下一次切换可能已经开始了，
          // 再跑一遍会把新一轮的滚动锁和 switching 标志一起解掉
          function finish() {
            if (finished) return;
            finished = true;
            timers.forEach(clearTimeout);
            swap();
            el.remove();
            unlock();
            switching = false;
          }

          function leave() {
            swap();
            el.dataset.leaving = '1';
            timers.push(setTimeout(finish, DONE_AT - LEAVE_AT));
          }

          // 主题等幕布真的淡入完了再切，不能只靠计时器：
          // 页面一卡，淡入会晚开始，计时器到点时幕布可能还是透明的，
          // 主题一切就是整屏跳色
          el.addEventListener('transitionend', function (event) {
            if (event.target === el && el.dataset.open === '1' && !el.dataset.leaving) swap();
          });

          // 先强制算一次样式，让透明成为过渡的起点，再改成不透明。
          // 不用 rAF：它在后台或卡顿时会被推迟，淡入也跟着推迟
          void el.offsetWidth;
          el.dataset.open = '1';

          // 兜底：transitionend 没来（比如过渡被跳过）也要切
          timers.push(setTimeout(swap, SWAP_AT));
          timers.push(
            setTimeout(function () {
              el.dataset.retract = '1';
            }, RETRACT_AT),
          );
          timers.push(setTimeout(leave, LEAVE_AT));
          // 兜底：别让幕布一直挂着
          timers.push(setTimeout(finish, DONE_AT + 1500));
        }

        // 主题色菜单：开合和选色都走事件委托，顶栏被换掉也不用重新绑
        function closePalette() {
          var menu = document.getElementById('palette-menu');
          var btn = document.getElementById('palette-toggle');
          if (menu) menu.hidden = true;
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', function (event) {
          var target = event.target.closest && event.target.closest('#palette-toggle, [data-palette-set]');

          if (target && target.id === 'palette-toggle') {
            var menu = document.getElementById('palette-menu');
            if (!menu) return;
            var open = menu.hidden;
            menu.hidden = !open;
            target.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) markPalette();
            return;
          }

          if (target) {
            setPalette(target.dataset.paletteSet);
            closePalette();
            return;
          }

          // 点到别处就收起来
          closePalette();
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') closePalette();
        });

        // 主题切换走事件委托，顶栏被换掉也不用重新绑
        document.addEventListener('click', function (event) {
          var btn = event.target.closest && event.target.closest('#theme-toggle');
          if (!btn) return;
          if (switching) return;

          var root = document.documentElement;
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';

          btn.dataset.spin = '1';
          setTimeout(function () {
            btn.dataset.spin = '';
          }, 780);

          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduced) {
            setTheme(next);
            return;
          }

          switching = true;
          try {
            playScene(next, btn, function () {
              setTheme(next);
            });
          } catch (e) {
            // 动画搭不起来也要把主题切掉，不能让按钮点了没反应
            setTheme(next);
            switching = false;
          }
        });

        // 入场动画：进入视口才播，播完就不再管
        function reveal() {
          var targets = document.querySelectorAll('[data-reveal]');
          if (!targets.length) return;

          function showAll() {
            targets.forEach(function (el) {
              el.classList.add('is-in');
            });
          }

          if (!('IntersectionObserver' in window)) {
            showAll();
            return;
          }

          try {
            var observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (item) {
                  if (!item.isIntersecting) return;
                  item.target.classList.add('is-in');
                  observer.unobserve(item.target);
                });
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0 },
            );
            targets.forEach(function (el) {
              observer.observe(el);
            });
          } catch (e) {
            // 观察器建不起来就直接全部显示，绝不能把内容留在隐藏状态
            showAll();
          }
        }

        // 换页靠 astro:page-load；没有 ClientRouter 时退回 DOMContentLoaded，
        // 保证内容不会永远停在隐藏状态
        document.addEventListener('astro:page-load', reveal);
        if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', reveal);
          } else {
            reveal();
          }
        }
      })();
    </script>

    <script is:inline>
      (function () {
        // 24 小时内的新内容亮出 NEW（首页分类、首页帖子、列表、详情页共用）。
        // 必须按访问时刻算：静态站只在推送时构建，构建时算好的会一直挂着过期的 NEW。
        // 列表检索是在浏览器里临时拼卡片的，拼完调 nnMarkNew(卡片) 补一次
        var NEW_WINDOW = 24 * 60 * 60 * 1000;

        function markNew(root) {
          var now = Date.now();
          (root || document).querySelectorAll('[data-new-since]').forEach(function (badge) {
            var at = Date.parse(badge.getAttribute('data-new-since'));
            badge.hidden = !(now - at < NEW_WINDOW);
          });
        }

        window.nnMarkNew = markNew;

        document.addEventListener('astro:page-load', function () {
          markNew();
        });
        if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
              markNew();
            });
          } else {
            markNew();
          }
        }
      })();
    </script>

    <MermaidRenderer />

    <slot name="head" />
  </head>

  <body class:list={[variant === 'canvas' && 'is-canvas']}>
    <SiteHeader />
    <main>
      <slot />
    </main>
    {variant !== 'canvas' && <SiteFooter />}
  </body>
</html>
