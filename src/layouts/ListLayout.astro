---
import BaseLayout from './BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import PixelBackdrop from '../components/PixelBackdrop.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import KindIcon, { type IconName } from '../components/KindIcon.astro';
import { pageBackdrops, type PageBackdrop as BackdropArt } from '../config/site';
import type { AnyEntry, ContentKind } from '../lib/content';
import { getPublished, entryHref, formatDate, bodyPreview, entryCover } from '../lib/content';
import { encodePinyin } from '../lib/search-index';

type Item = { kind: ContentKind; entry: AnyEntry };

// 两种用法：分类页给 kind + entries（这一页的条目）；
// 单个标签页的条目跨分类，给 items（这一页）+ allItems（全部，检索用），图标、背景、封面各自指定
interface Props {
  kind?: ContentKind;
  entries?: AnyEntry[];
  items?: Item[];
  allItems?: Item[];
  icon?: IconName;
  backdrop?: BackdropArt;
  title: string;
  // 浏览器标签页上的标题，不给就用 title（标签页写成「标签：xx」）
  docTitle?: string;
  description: string;
  // null 表示这一页没有封面位（标签页），undefined 是分类还没配封面、显示占位框
  cover?: string | null;
  page?: number;
  totalPages?: number;
  basePath: string;
  emptyText?: string;
}

const {
  kind,
  entries = [],
  items,
  allItems,
  icon,
  backdrop,
  title,
  docTitle,
  description,
  cover,
  page = 1,
  totalPages = 1,
  basePath,
  emptyText = '这里还没有内容。',
} = Astro.props;

const rows: Item[] = items ?? (kind ? entries.map((entry) => ({ kind, entry })) : []);

// 检索索引覆盖全部条目，不只是当前这一页
const all: Item[] = allItems ?? (kind ? (await getPublished(kind)).map((entry) => ({ kind, entry })) : []);
const index = all.map(({ kind: itemKind, entry }) => {
  const q = bodyPreview(entry);
  return {
    t: entry.data.title,
    pt: encodePinyin(entry.data.title, true),
    s: entry.data.summary,
    ps: encodePinyin(entry.data.summary, true),
    d: formatDate(entry.data.publishedAt),
    p: entry.data.publishedAt.toISOString(),
    h: entryHref(itemKind, entry.data.slug),
    c: entryCover(entry) ?? '',
    g: [...entry.data.tags],
    pg: entry.data.tags.map((tag) => encodePinyin(tag, true)),
    k: entry.data.category,
    pk: encodePinyin(entry.data.category, true),
    q,
    pq: encodePinyin(q, false),
  };
});
// 全文索引按分类分文件，标签页的条目来自哪几个分类就拉哪几份
const fullIndex = [...new Set(all.map((item) => item.kind))].map((k) => `/search/${k}.json`).join(',');
const headIcon: IconName = icon ?? kind ?? 'tags';
const art = backdrop ?? (kind ? pageBackdrops[kind] : pageBackdrops.tags);

// 第一页回到列表根路径，其余走 /page/N/
function pageHref(target: number): string {
  return target <= 1 ? basePath : `${basePath}page/${target}/`;
}

const pageTitle = page > 1 ? `${docTitle ?? title} · 第 ${page} 页` : (docTitle ?? title);

// 满 5 篇才出翻页器；不足 5 篇时列表也不撑高，免得底下一大片空白
const showPager = all.length >= 5;
// 一篇都没有时只留居中的空状态，搜索框和翻页器都没有意义
const isEmpty = all.length === 0;
const prevUrl = page > 1 ? pageHref(page - 1) : undefined;
const nextUrl = page < totalPages ? pageHref(page + 1) : undefined;
---

<BaseLayout title={pageTitle} description={description} prevUrl={prevUrl} nextUrl={nextUrl}>
  <PageBackdrop art={art} />
  <PixelBackdrop />

  <section class="wrap list-head">
    {
      cover ? (
        <img class="list-cover" src={cover} alt="" data-reveal />
      ) : cover === null ? null : (
        <div class="list-cover cover-ph" data-reveal>
          封面待补
        </div>
      )
    }

    <div class="list-head__text">
      <div class="list-head__row" data-reveal style="--reveal-i: 1">
        <h1 class="list-title"><KindIcon name={headIcon} class="list-title__icon" />{title}</h1>
        <p class="list-desc">{description}</p>
      </div>

      <div class="search" data-reveal style="--reveal-i: 2" hidden={isEmpty}>
        <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <input
          class="search__input"
          type="search"
          data-search-input
          placeholder="搜索内容（支持拼音 / 注音）"
          aria-label={`在${title}中搜索`}
          autocomplete="off"
        />
        <span class="search__count" data-search-count aria-live="polite"></span>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="rule-tab" aria-hidden="true"></div>
  </div>

  <section class="wrap list-body" data-reserve={showPager ? '1' : undefined}>
    {
      rows.length > 0 ? (
        <div class="entry-list" data-entry-list>
          {rows.map((row) => (
            <EntryRow kind={row.kind} entry={row.entry} />
          ))}
        </div>
      ) : (
        <p class="empty-state">{emptyText}</p>
      )
    }

    <div class="entry-list" data-search-results hidden></div>
    <p class="empty" data-search-empty hidden>没有匹配的内容。</p>

    {
      showPager && (
        <nav class="pagination" aria-label="分页" data-pagination>
          <a
            class="pagination__step"
            href={pageHref(page - 1)}
            aria-disabled={page <= 1 ? 'true' : undefined}
          >
            ← 上一页
          </a>
          <span class="pagination__count">
            {String(page).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}
          </span>
          <a
            class="pagination__step"
            href={pageHref(page + 1)}
            aria-disabled={page >= totalPages ? 'true' : undefined}
          >
            下一页 →
          </a>
        </nav>
      )
    }
  </section>

  <script type="application/json" data-search-index data-full={fullIndex} set:html={JSON.stringify(index)} />
</BaseLayout>

<style>
  /* 背景是 fixed 的，内容层要抬上来 */
  .list-head,
  .list-body,
  .rule-tab {
    position: relative;
    z-index: 1;
  }

  .list-head {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(2.75rem, 7vw, 4.5rem) 1.75rem;
  }

  /* 分类封面：标题左侧的固定位置，没图时是同尺寸线框 */
  .list-cover {
    width: 12rem;
    aspect-ratio: 4 / 3;
    flex: none;
    object-fit: cover;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  .list-head__text {
    min-width: 0;
    flex: 1;
  }

  /* 标题与介绍同一行，介绍靠右 */
  .list-head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .list-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin: 0;
    white-space: nowrap;
  }

  /* 标题前的分类图标：和顶栏同一枚，放大到标题的一半出头 */
  .list-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .list-title :global(.list-title__icon) {
    font-size: 0.8em;
    color: var(--fg-muted);
  }

  .list-desc {
    max-width: 28em;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-align: right;
  }

  /* ---------- 搜索框 ---------- */

  .search {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding: 0.55rem 0.85rem;
    border: var(--hair) solid var(--line);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .search:focus-within { border-color: var(--line-strong); }

  .search__icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--fg-faint);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.9375rem;
    outline: none;
  }

  .search__input::placeholder { color: var(--fg-faint); }

  .search__input::-webkit-search-cancel-button { filter: grayscale(1) opacity(0.5); }

  /* 搜索结果里命中的词：朱红字 + 下划线，不铺底色 */
  .list-body :global(mark) {
    background: none;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .search__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  /* ---------- 标题区与列表区之间的分隔：虚线 + 左端一截实心色块 ---------- */

  .rule-tab {
    position: relative;
    height: var(--hair);
    background: repeating-linear-gradient(
      to right,
      var(--line) 0 5px,
      transparent 5px 10px
    );
  }

  .rule-tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 4.5rem;
    height: 3px;
    background: var(--accent);
  }

  .list-body {
    padding-block: 2.25rem 4rem;
    display: flex;
    flex-direction: column;
  }

  /* 空集合：内容区撑起一屏，文字水平垂直居中 */
  .empty-state {
    flex: 1;
    display: grid;
    place-content: center;
    min-height: 45vh;
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  /* 一条列表项 = 封面高(14rem × 10/16) + 上下内边距，撑满一页五条，
     这样最后一页只有一两条时翻页器也停在同一个位置 */
  .list-body[data-reserve='1'] .entry-list {
    min-height: calc(11.8rem * 5);
  }

  .list-body[data-reserve='1'] .pagination {
    margin-top: auto;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .pagination__step {
    transition: color var(--dur-1) var(--ease-out);
  }

  .pagination__step:hover {
    color: var(--accent);
  }

  .pagination__step[aria-disabled='true'] {
    color: var(--fg-faint);
    opacity: 0.4;
    pointer-events: none;
  }

  .pagination__count {
    color: var(--fg-faint);
  }

  @media (max-width: 56rem) {
    .list-head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .list-desc { text-align: left; }
    .list-title { white-space: normal; }
  }

  @media (max-width: 44rem) {
    .list-head {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }

    .list-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  import {
    escapeHtml,
    extractSnippet,
    highlightRanges,
    matchField,
    parseQuery,
    prepareField,
    type ParsedQuery,
    type PreparedField,
  } from '../lib/search-engine';

  interface RawIndexItem {
    t: string;
    pt?: string;
    s: string;
    ps?: string;
    d: string;
    p: string;
    h: string;
    c: string;
    g?: string[];
    pg?: string[];
    k?: string;
    pk?: string;
    q: string;
    pq?: string;
  }

  interface PreparedItem extends RawIndexItem {
    ft: PreparedField;
    fs: PreparedField;
    fg: PreparedField[];
    fk: PreparedField;
    fq: PreparedField;
  }

  interface FullRow {
    h: string;
    b: string;
    pb?: string;
  }

  interface SearchHit {
    item: PreparedItem;
    score: number;
    inBody: boolean;
    bodyField: PreparedField;
    titleRanges: [number, number][];
    summaryRanges: [number, number][];
  }

  interface ActiveSearch {
    input: HTMLInputElement;
    onInput: () => void;
    loadFull: () => void;
    onKey: (event: KeyboardEvent) => void;
  }

  declare global {
    interface Window {
      __nnSearch?: ActiveSearch | null;
      nnMarkNew?: (root: ParentNode) => void;
    }
  }

  function teardown() {
    const active = window.__nnSearch;
    if (!active) return;
    active.input.removeEventListener('input', active.onInput);
    active.input.removeEventListener('focus', active.loadFull);
    active.input.removeEventListener('keydown', active.onKey);
    window.__nnSearch = null;
  }

  function init() {
    teardown();

    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const source = document.querySelector<HTMLScriptElement>('[data-search-index]');
    const list = document.querySelector<HTMLElement>('[data-entry-list]');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const empty = document.querySelector<HTMLElement>('[data-search-empty]');
    const counter = document.querySelector<HTMLElement>('[data-search-count]');
    const pagination = document.querySelector<HTMLElement>('[data-pagination]');
    if (!input || !source || !results) return;

    let rawIndex: RawIndexItem[] = [];
    try {
      rawIndex = JSON.parse(source.textContent || '[]');
    } catch {
      return;
    }

    const index: PreparedItem[] = rawIndex.map((item) => {
      const tags = item.g || [];
      const tagPys = item.pg || [];
      return {
        ...item,
        ft: prepareField(item.t, item.pt || ''),
        fs: prepareField(item.s, item.ps || ''),
        fg: tags.map((tag, i) => prepareField(tag, tagPys[i] || '')),
        fk: prepareField(item.k || '', item.pk || ''),
        fq: prepareField(item.q || '', item.pq || ''),
      };
    });

    // 全文：链接 → PreparedField。没拉到之前退回内嵌的正文前 500 字
    let full: Record<string, PreparedField> | null = null;
    let loading = false;

    function loadFull() {
      if (full || loading || !source?.dataset.full) return;
      loading = true;
      Promise.all(
        source.dataset.full.split(',').map((url) =>
          fetch(url).then((res) => {
            if (!res.ok) throw new Error(String(res.status));
            return res.json() as Promise<FullRow[]>;
          }),
        ),
      )
        .then((parts) => {
          const map: Record<string, PreparedField> = {};
          parts.forEach((rows) => {
            rows.forEach((row) => {
              map[row.h] = prepareField(row.b, row.pb || '');
            });
          });
          full = map;
          if (input && input.value.trim()) onInput();
        })
        .catch(() => {
          loading = false;
        });
    }

    // 每个词都要命中（与搜索），按 标题 > 标签 > 摘要 > 分类 > 正文 给分并乘上匹配精确度，同分按时间新的在前
    function search(parsed: ParsedQuery): SearchHit[] {
      const hits: SearchHit[] = [];
      const { terms, phrase } = parsed;

      index.forEach((item) => {
        const bodyField = full && full[item.h] ? full[item.h] : item.fq;
        let score = 0;
        let inBody = false;
        const titleRanges: [number, number][] = [];
        const summaryRanges: [number, number][] = [];

        for (let i = 0; i < terms.length; i++) {
          const term = terms[i];
          let gain = 0;

          const tm = matchField(item.ft, term, { allowTypo: true, collectAll: true });
          if (tm) {
            const atStart = tm.ranges.some((r) => r[0] === 0);
            gain += (atStart ? 12 : 8.5) * tm.quality;
            titleRanges.push(...tm.ranges);
          }

          let bestTagScore = 0;
          for (let j = 0; j < item.fg.length; j++) {
            const gf = item.fg[j];
            const gm = matchField(gf, term, { allowTypo: true });
            if (gm) {
              const fullTag = gm.ranges.some((r) => r[0] === 0 && r[1] === gf.raw.length);
              const sc = (fullTag ? 6.5 : 4.5) * gm.quality;
              if (sc > bestTagScore) bestTagScore = sc;
            }
          }
          gain += bestTagScore;

          const sm = matchField(item.fs, term, { allowTypo: true, collectAll: true });
          if (sm) {
            gain += 3.2 * sm.quality;
            summaryRanges.push(...sm.ranges);
          }

          if (item.fk.raw) {
            const km = matchField(item.fk, term, { allowTypo: false });
            if (km) gain += 2.2 * km.quality;
          }

          const bm = matchField(bodyField, term, { isBody: true, allowTypo: false, collectAll: true });
          if (bm) {
            gain += (1.1 + bm.count * 0.3) * bm.quality;
            inBody = true;
          }

          if (!gain) return;
          score += gain;
        }

        if (phrase) {
          const pt = matchField(item.ft, phrase, { allowTypo: false, collectAll: true });
          if (pt) {
            score += 4.5 * pt.quality;
            titleRanges.push(...pt.ranges);
          }
          for (let j = 0; j < item.fg.length; j++) {
            const pgm = matchField(item.fg[j], phrase, { allowTypo: false });
            if (pgm) {
              score += 2.5 * pgm.quality;
              break;
            }
          }
          const ps = matchField(item.fs, phrase, { allowTypo: false, collectAll: true });
          if (ps) {
            score += 1.8 * ps.quality;
            summaryRanges.push(...ps.ranges);
          }
          const pb = matchField(bodyField, phrase, { isBody: true, allowTypo: false });
          if (pb) score += 1.2 * pb.quality;
        }

        hits.push({ item, score, inBody, bodyField, titleRanges, summaryRanges });
      });

      hits.sort((a, b) => b.score - a.score || (a.item.p < b.item.p ? 1 : -1));
      return hits;
    }

    function card(hit: SearchHit, parsed: ParsedQuery): HTMLElement {
      const { item } = hit;
      const a = document.createElement('article');
      a.className = 'entry';
      a.innerHTML =
        '<div class="entry__cover-wrap"></div>' +
        '<div class="entry__body">' +
        '<div class="entry__date"><time></time><span class="new-badge" hidden>NEW</span></div>' +
        '<h3 class="entry__title"><a></a></h3>' +
        '<p class="entry__summary"></p>' +
        '</div>' +
        '<a class="entry__hit"></a>';

      const wrap = a.querySelector('.entry__cover-wrap')!;
      if (item.c) {
        const img = document.createElement('img');
        img.className = 'entry__cover';
        img.src = item.c;
        img.alt = '';
        img.loading = 'lazy';
        wrap.appendChild(img);
      } else {
        const ph = document.createElement('div');
        ph.className = 'entry__cover cover-ph';
        ph.textContent = '封面待补';
        wrap.appendChild(ph);
      }

      const date = a.querySelector<HTMLTimeElement>('.entry__date time')!;
      date.textContent = item.d;
      date.dateTime = item.p;
      a.querySelector('.new-badge')!.setAttribute('data-new-since', item.p);
      if (window.nnMarkNew) window.nnMarkNew(a);

      const link = a.querySelector<HTMLAnchorElement>('.entry__title a')!;
      link.innerHTML = highlightRanges(item.t, hit.titleRanges);
      link.href = item.h;

      const summaryEl = a.querySelector('.entry__summary')!;
      if (hit.summaryRanges.length > 0) {
        summaryEl.innerHTML = highlightRanges(item.s, hit.summaryRanges);
      } else if (hit.inBody) {
        const snip = extractSnippet(hit.bodyField, parsed.terms, parsed.phrase);
        summaryEl.innerHTML = snip ? highlightRanges(snip.text, snip.ranges) : escapeHtml(item.s);
      } else {
        summaryEl.textContent = item.s;
      }

      const cover = a.querySelector<HTMLAnchorElement>('.entry__hit')!;
      cover.href = item.h;
      cover.setAttribute('aria-label', item.t);
      return a;
    }

    function onInput() {
      if (!input || !results) return;
      const parsed = parseQuery(input.value);

      if (!parsed.terms.length) {
        results.hidden = true;
        results.innerHTML = '';
        if (empty) empty.hidden = true;
        if (list) list.hidden = false;
        if (pagination) pagination.hidden = false;
        if (list && list.parentElement && pagination) {
          list.parentElement.dataset.reserve = '1';
        }
        if (counter) counter.textContent = '';
        return;
      }

      loadFull();
      const hits = search(parsed);

      if (list) list.hidden = true;
      if (pagination) pagination.hidden = true;
      if (list && list.parentElement) list.parentElement.dataset.reserve = '';
      if (counter) counter.textContent = `${hits.length} / ${index.length}`;

      results.innerHTML = '';
      hits.forEach((hit, i) => {
        const node = card(hit, parsed);
        node.style.setProperty('--reveal-i', String(Math.min(i, 7)));
        node.classList.add('is-in');
        node.setAttribute('data-reveal', '');
        results.appendChild(node);
      });

      results.hidden = hits.length === 0;
      if (empty) empty.hidden = hits.length > 0;
    }

    function onKey(event: KeyboardEvent) {
      if (!input || event.key !== 'Escape' || !input.value) return;
      input.value = '';
      onInput();
    }

    input.addEventListener('input', onInput);
    input.addEventListener('focus', loadFull);
    input.addEventListener('keydown', onKey);
    window.__nnSearch = { input, onInput, loadFull, onKey };
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
