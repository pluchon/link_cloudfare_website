---
import BaseLayout from './BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import PixelBackdrop from '../components/PixelBackdrop.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import KindIcon from '../components/KindIcon.astro';
import { pageBackdrops } from '../config/site';
import type { AnyEntry, ContentKind } from '../lib/content';
import { getPublished, entryHref, formatDate, searchText, entryCover } from '../lib/content';

interface Props {
  kind: ContentKind;
  title: string;
  description: string;
  cover?: string;
  entries: AnyEntry[];
  page?: number;
  totalPages?: number;
  basePath: string;
  emptyText?: string;
}

const {
  kind,
  title,
  description,
  cover,
  entries,
  page = 1,
  totalPages = 1,
  basePath,
  emptyText = '这里还没有内容。',
} = Astro.props;

// 检索索引覆盖该分类的全部条目，不只是当前这一页
const all = await getPublished(kind);
const index = all.map((entry) => ({
  t: entry.data.title,
  s: entry.data.summary,
  d: formatDate(entry.data.publishedAt),
  p: entry.data.publishedAt.toISOString(),
  h: entryHref(kind, entry.data.slug),
  c: entryCover(entry) ?? '',
  g: [...entry.data.tags],
  q: searchText(entry),
}));

// 第一页回到列表根路径，其余走 /page/N/
function pageHref(target: number): string {
  return target <= 1 ? basePath : `${basePath}page/${target}/`;
}

const pageTitle = page > 1 ? `${title} · 第 ${page} 页` : title;

// 满 5 篇才出翻页器；不足 5 篇时列表也不撑高，免得底下一大片空白
const showPager = all.length >= 5;
// 一篇都没有时只留居中的空状态，搜索框和翻页器都没有意义
const isEmpty = all.length === 0;
const prevUrl = page > 1 ? pageHref(page - 1) : undefined;
const nextUrl = page < totalPages ? pageHref(page + 1) : undefined;
---

<BaseLayout title={pageTitle} description={description} prevUrl={prevUrl} nextUrl={nextUrl}>
  <PageBackdrop art={pageBackdrops[kind]} />
  <PixelBackdrop />

  <section class="wrap list-head">
    {
      cover ? (
        <img class="list-cover" src={cover} alt="" data-reveal />
      ) : (
        <div class="list-cover cover-ph" data-reveal>
          封面待补
        </div>
      )
    }

    <div class="list-head__text">
      <div class="list-head__row" data-reveal style="--reveal-i: 1">
        <h1 class="list-title"><KindIcon name={kind} class="list-title__icon" />{title}</h1>
        <p class="list-desc">{description}</p>
      </div>

      <div class="search" data-reveal style="--reveal-i: 2" hidden={isEmpty}>
        <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <input
          class="search__input"
          type="search"
          data-search-input
          placeholder="搜索标题或内容"
          aria-label={`在${title}中搜索`}
          autocomplete="off"
        />
        <span class="search__count" data-search-count aria-live="polite"></span>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="rule-tab" aria-hidden="true"></div>
  </div>

  <section class="wrap list-body" data-reserve={showPager ? '1' : undefined}>
    {
      entries.length > 0 ? (
        <div class="entry-list" data-entry-list>
          {entries.map((entry) => (
            <EntryRow kind={kind} entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty-state">{emptyText}</p>
      )
    }

    <div class="entry-list" data-search-results hidden></div>
    <p class="empty" data-search-empty hidden>没有匹配的内容。</p>

    {
      showPager && (
        <nav class="pagination" aria-label="分页" data-pagination>
          <a
            class="pagination__step"
            href={pageHref(page - 1)}
            aria-disabled={page <= 1 ? 'true' : undefined}
          >
            ← 上一页
          </a>
          <span class="pagination__count">
            {String(page).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}
          </span>
          <a
            class="pagination__step"
            href={pageHref(page + 1)}
            aria-disabled={page >= totalPages ? 'true' : undefined}
          >
            下一页 →
          </a>
        </nav>
      )
    }
  </section>

  <script type="application/json" data-search-index data-full={`/search/${kind}.json`} set:html={JSON.stringify(index)} />
</BaseLayout>

<style>
  /* 背景是 fixed 的，内容层要抬上来 */
  .list-head,
  .list-body,
  .rule-tab {
    position: relative;
    z-index: 1;
  }

  .list-head {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(2.75rem, 7vw, 4.5rem) 1.75rem;
  }

  /* 分类封面：标题左侧的固定位置，没图时是同尺寸线框 */
  .list-cover {
    width: 12rem;
    aspect-ratio: 4 / 3;
    flex: none;
    object-fit: cover;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
  }

  .list-head__text {
    min-width: 0;
    flex: 1;
  }

  /* 标题与介绍同一行，介绍靠右 */
  .list-head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .list-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin: 0;
    white-space: nowrap;
  }

  /* 标题前的分类图标：和顶栏同一枚，放大到标题的一半出头 */
  .list-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .list-title :global(.list-title__icon) {
    font-size: 0.8em;
    color: var(--fg-muted);
  }

  .list-desc {
    max-width: 28em;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-align: right;
  }

  /* ---------- 搜索框 ---------- */

  .search {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding: 0.55rem 0.85rem;
    border: var(--hair) solid var(--line);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .search:focus-within { border-color: var(--line-strong); }

  .search__icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--fg-faint);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.9375rem;
    outline: none;
  }

  .search__input::placeholder { color: var(--fg-faint); }

  .search__input::-webkit-search-cancel-button { filter: grayscale(1) opacity(0.5); }

  /* 搜索结果里命中的词：朱红字 + 下划线，不铺底色 */
  .list-body :global(mark) {
    background: none;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .search__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  /* ---------- 标题区与列表区之间的分隔：虚线 + 左端一截实心色块 ---------- */

  .rule-tab {
    position: relative;
    height: var(--hair);
    background: repeating-linear-gradient(
      to right,
      var(--line) 0 5px,
      transparent 5px 10px
    );
  }

  .rule-tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 4.5rem;
    height: 3px;
    background: var(--accent);
  }

  .list-body {
    padding-block: 2.25rem 4rem;
    display: flex;
    flex-direction: column;
  }

  /* 空集合：内容区撑起一屏，文字水平垂直居中 */
  .empty-state {
    flex: 1;
    display: grid;
    place-content: center;
    min-height: 45vh;
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  /* 一条列表项 = 封面高(14rem × 10/16) + 上下内边距，撑满一页五条，
     这样最后一页只有一两条时翻页器也停在同一个位置 */
  .list-body[data-reserve='1'] .entry-list {
    min-height: calc(11.8rem * 5);
  }

  .list-body[data-reserve='1'] .pagination {
    margin-top: auto;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .pagination__step {
    transition: color var(--dur-1) var(--ease-out);
  }

  .pagination__step:hover {
    color: var(--accent);
  }

  .pagination__step[aria-disabled='true'] {
    color: var(--fg-faint);
    opacity: 0.4;
    pointer-events: none;
  }

  .pagination__count {
    color: var(--fg-faint);
  }

  @media (max-width: 56rem) {
    .list-head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .list-desc { text-align: left; }
    .list-title { white-space: normal; }
  }

  @media (max-width: 44rem) {
    .list-head {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }

    .list-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script is:inline>
  (function () {
    function teardown() {
      if (!window.__nnSearch) return;
      var m = window.__nnSearch;
      m.input.removeEventListener('input', m.onInput);
      m.input.removeEventListener('focus', m.loadFull);
      m.input.removeEventListener('keydown', m.onKey);
      window.__nnSearch = null;
    }

    // 检索前统一折叠：全角转半角（ＡＢＣ、１２３）、大写转小写。索引和查询走同一个函数，两边才对得上。
    // 逐字折叠、折完长度变了的字保持原样：整段 NFKC 会把「…」展开成三个点，
    // 下标和原文对不上，高亮就标歪了
    function fold(text) {
      var out = '';
      for (var ch of String(text || '')) {
        var f = ch.normalize('NFKC').toLowerCase();
        if (f.length !== ch.length) f = ch.toLowerCase();
        out += f.length === ch.length ? f : ch;
      }
      return out;
    }

    function escapeHtml(text) {
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // 把命中的词包成 <mark>。位置在折叠后的文本里找，再按同样的下标切原文（fold 保证长度不变）
    function highlight(raw, terms) {
      var folded = fold(raw);
      var ranges = [];
      terms.forEach(function (term) {
        var from = 0;
        var at;
        while ((at = folded.indexOf(term, from)) !== -1) {
          ranges.push([at, at + term.length]);
          from = at + term.length;
        }
      });
      if (!ranges.length) return escapeHtml(raw);
      ranges.sort(function (a, b) {
        return a[0] - b[0];
      });
      var html = '';
      var cursor = 0;
      ranges.forEach(function (r) {
        if (r[1] <= cursor) return;
        var begin = Math.max(r[0], cursor);
        html += escapeHtml(raw.slice(cursor, begin)) + '<mark>' + escapeHtml(raw.slice(begin, r[1])) + '</mark>';
        cursor = r[1];
      });
      return html + escapeHtml(raw.slice(cursor));
    }

    // 只在正文里命中时，摘要换成命中处前后的一小段，让人看到为什么搜出了这篇
    function snippet(raw, terms) {
      var folded = fold(raw);
      var at = -1;
      terms.forEach(function (term) {
        var i = folded.indexOf(term);
        if (i !== -1 && (at === -1 || i < at)) at = i;
      });
      if (at === -1) return '';
      var begin = Math.max(0, at - 36);
      var end = Math.min(raw.length, at + 84);
      return (begin > 0 ? '…' : '') + raw.slice(begin, end) + (end < raw.length ? '…' : '');
    }

    // 一个词在正文里出现几次，数到 5 为止：出现得多说明这篇更相关，但不让长文靠篇幅压过标题命中
    function count(haystack, term) {
      var n = 0;
      var from = 0;
      var at;
      while (n < 5 && (at = haystack.indexOf(term, from)) !== -1) {
        n += 1;
        from = at + term.length;
      }
      return n;
    }

    function init() {
      teardown();

      var input = document.querySelector('[data-search-input]');
      var source = document.querySelector('[data-search-index]');
      var list = document.querySelector('[data-entry-list]');
      var results = document.querySelector('[data-search-results]');
      var empty = document.querySelector('[data-search-empty]');
      var counter = document.querySelector('[data-search-count]');
      var pagination = document.querySelector('[data-pagination]');
      if (!input || !source || !results) return;

      var index = [];
      try {
        index = JSON.parse(source.textContent || '[]');
      } catch (e) {
        return;
      }

      index.forEach(function (item) {
        item.ft = fold(item.t);
        item.fs = fold(item.s);
        item.fg = (item.g || []).map(fold);
        item.fq = fold(item.q);
      });

      // 全文：链接 → { 原文, 折叠后 }。没拉到之前退回内嵌的正文前段
      var full = null;
      var loading = false;

      function loadFull() {
        if (full || loading || !source.dataset.full) return;
        loading = true;
        fetch(source.dataset.full)
          .then(function (res) {
            if (!res.ok) throw new Error(String(res.status));
            return res.json();
          })
          .then(function (rows) {
            full = {};
            rows.forEach(function (row) {
              full[row.h] = { raw: row.b, folded: fold(row.b) };
            });
            // 全文到了以后，正在输入的那次查询按全文重搜一遍
            if (input.value.trim()) onInput();
          })
          .catch(function () {
            loading = false;
          });
      }

      // 每个词都要命中（与搜索），按命中位置给分：标题 > 标签 > 摘要 > 正文，同分按时间新的在前
      function search(terms) {
        var hits = [];
        index.forEach(function (item) {
          var body = full && full[item.h] ? full[item.h].folded : item.fq;
          var score = 0;
          var inBody = false;
          for (var i = 0; i < terms.length; i++) {
            var term = terms[i];
            var gain = 0;
            var at = item.ft.indexOf(term);
            if (at !== -1) gain += at === 0 ? 12 : 8;
            if (item.fg.indexOf(term) !== -1) gain += 6;
            else if (item.fg.some(function (tag) { return tag.indexOf(term) !== -1; })) gain += 4;
            if (item.fs.indexOf(term) !== -1) gain += 3;
            var n = count(body, term);
            if (n) {
              gain += 1 + n * 0.3;
              inBody = true;
            }
            if (!gain) return;
            score += gain;
          }
          hits.push({ item: item, score: score, inBody: inBody });
        });
        hits.sort(function (a, b) {
          return b.score - a.score || (a.item.p < b.item.p ? 1 : -1);
        });
        return hits;
      }

      function card(hit, terms) {
        var item = hit.item;
        var a = document.createElement('article');
        a.className = 'entry';
        a.innerHTML =
          '<div class="entry__cover-wrap"></div>' +
          '<div class="entry__body">' +
          '<div class="entry__date"><time></time><span class="new-badge" hidden>NEW</span></div>' +
          '<h3 class="entry__title"><a></a></h3>' +
          '<p class="entry__summary"></p>' +
          '</div>' +
          '<a class="entry__hit"></a>';

        var wrap = a.querySelector('.entry__cover-wrap');
        if (item.c) {
          var img = document.createElement('img');
          img.className = 'entry__cover';
          img.src = item.c;
          img.alt = '';
          img.loading = 'lazy';
          wrap.appendChild(img);
        } else {
          var ph = document.createElement('div');
          ph.className = 'entry__cover cover-ph';
          ph.textContent = '封面待补';
          wrap.appendChild(ph);
        }

        var date = a.querySelector('.entry__date time');
        date.textContent = item.d;
        date.dateTime = item.p;
        a.querySelector('.new-badge').setAttribute('data-new-since', item.p);
        if (window.nnMarkNew) window.nnMarkNew(a);
        var link = a.querySelector('.entry__title a');
        link.innerHTML = highlight(item.t, terms);
        link.href = item.h;

        // 摘要里没有命中、正文里有，就把摘要换成正文里命中的那一段
        var summary = item.s;
        var inSummary = terms.some(function (term) {
          return item.fs.indexOf(term) !== -1;
        });
        if (!inSummary && hit.inBody) {
          var raw = full && full[item.h] ? full[item.h].raw : '';
          summary = snippet(raw, terms) || item.s;
        }
        a.querySelector('.entry__summary').innerHTML = highlight(summary, terms);

        var cover = a.querySelector('.entry__hit');
        cover.href = item.h;
        cover.setAttribute('aria-label', item.t);
        return a;
      }

      function onInput() {
        var terms = fold(input.value).split(/\s+/).filter(Boolean);

        if (!terms.length) {
          results.hidden = true;
          results.innerHTML = '';
          if (empty) empty.hidden = true;
          if (list) list.hidden = false;
          if (pagination) pagination.hidden = false;
          if (list && list.parentElement && pagination) {
            list.parentElement.dataset.reserve = '1';
          }
          if (counter) counter.textContent = '';
          return;
        }

        loadFull();
        var hits = search(terms);

        // 搜索期间分页没有意义，索引本来就跨全部页
        if (list) list.hidden = true;
        if (pagination) pagination.hidden = true;
        // 搜索结果不分页，预留的固定高度要撤掉
        if (list && list.parentElement) list.parentElement.dataset.reserve = '';
        if (counter) counter.textContent = hits.length + ' / ' + index.length;

        results.innerHTML = '';
        hits.forEach(function (hit, i) {
          var node = card(hit, terms);
          node.style.setProperty('--reveal-i', Math.min(i, 7));
          node.classList.add('is-in');
          node.setAttribute('data-reveal', '');
          results.appendChild(node);
        });

        results.hidden = hits.length === 0;
        if (empty) empty.hidden = hits.length > 0;
      }

      // Esc 清空搜索、回到分页列表
      function onKey(event) {
        if (event.key !== 'Escape' || !input.value) return;
        input.value = '';
        onInput();
      }

      input.addEventListener('input', onInput);
      input.addEventListener('focus', loadFull);
      input.addEventListener('keydown', onKey);
      window.__nnSearch = { input: input, onInput: onInput, loadFull: loadFull, onKey: onKey };
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', teardown);
    if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    }
  })();
</script>
