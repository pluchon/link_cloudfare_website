---
import BaseLayout from './BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import type { AnyEntry, ContentKind } from '../lib/content';

interface Props {
  kind: ContentKind;
  title: string;
  label: string;
  description: string;
  entries: AnyEntry[];
  page?: number;
  totalPages?: number;
  basePath: string;
  emptyText?: string;
}

const {
  kind,
  title,
  label,
  description,
  entries,
  page = 1,
  totalPages = 1,
  basePath,
  emptyText = '这里还没有内容。',
} = Astro.props;

// 第一页回到列表根路径，其余走 /page/N/
function pageHref(target: number): string {
  return target <= 1 ? basePath : `${basePath}page/${target}/`;
}

const pageTitle = page > 1 ? `${title} · 第 ${page} 页` : title;
---

<BaseLayout title={pageTitle} description={description}>
  <section class="wrap list-head">
    <p class="label">{label}</p>
    <h1 class="list-title">{title}</h1>
    <p class="list-desc">{description}</p>
  </section>

  <section class="wrap list-body">
    {
      entries.length > 0 ? (
        <div class="entry-list">
          {entries.map((entry) => (
            <EntryRow kind={kind} entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">{emptyText}</p>
      )
    }

    {
      totalPages > 1 && (
        <nav class="pagination" aria-label="分页">
          <a
            class="pagination__step"
            href={pageHref(page - 1)}
            aria-disabled={page <= 1 ? 'true' : undefined}
          >
            ← 上一页
          </a>
          <span class="pagination__count">
            {String(page).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}
          </span>
          <a
            class="pagination__step"
            href={pageHref(page + 1)}
            aria-disabled={page >= totalPages ? 'true' : undefined}
          >
            下一页 →
          </a>
        </nav>
      )
    }
  </section>
</BaseLayout>

<style>
  .list-head {
    padding-block: clamp(2.75rem, 7vw, 4.5rem) 2rem;
  }

  .list-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin: 0.9rem 0 0;
  }

  .list-desc {
    max-width: 34em;
    margin: 1rem 0 0;
    color: var(--fg-muted);
    line-height: 1.8;
  }

  .list-body {
    padding-bottom: 4rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .pagination__step {
    transition: color 0.18s ease;
  }

  .pagination__step:hover {
    color: var(--accent);
  }

  .pagination__step[aria-disabled='true'] {
    color: var(--fg-faint);
    opacity: 0.4;
    pointer-events: none;
  }

  .pagination__count {
    color: var(--fg-faint);
  }
</style>
