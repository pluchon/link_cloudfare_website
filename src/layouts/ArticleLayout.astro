---
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import PaletteDecor from '../components/PaletteDecor.astro';
import type { MarkdownHeading } from 'astro';
import type { AnyEntry, ContentKind } from '../lib/content';
import { entryHref, formatDate, countWords, entryCover } from '../lib/content';

interface Props {
  kind: ContentKind;
  entry: AnyEntry;
  headings: MarkdownHeading[];
  prev?: AnyEntry;
  next?: AnyEntry;
  related?: AnyEntry[];
}

const { kind, entry, headings, prev, next, related = [] } = Astro.props;
const { data } = entry;
const body = entry.body ?? '';
const words = countWords(body);
const rawHref = `/${kind}/${data.slug}.md`;
const cover = entryCover(entry);

// 侧栏目录只取 h2 / h3，更深的层级在导航里没有意义
// 目录只到三级。按二级分组：每个二级标题带上它后面紧跟的三级标题，
// 三级默认收着，点二级才展开
const toc: { slug: string; text: string; subs: { slug: string; text: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    toc.push({ slug: h.slug, text: h.text, subs: [] });
  } else if (h.depth === 3 && toc.length > 0) {
    toc[toc.length - 1].subs.push({ slug: h.slug, text: h.text });
  }
}
---

<BaseLayout title={data.title} description={data.summary} ogImage={cover}>
  <PaletteDecor />
  <div class="progress" id="reading-progress" aria-hidden="true"></div>

  {
    toc.length > 0 && (
      <nav class="rail" aria-label="目录">
        <span class="rail__cap" aria-hidden="true" />
        <ol class="rail__list">
          {toc.map((item) => (
            <li class="rail__group" data-rail-group>
              <div class="rail__row">
                <a class="rail__item" href={`#${item.slug}`} data-toc-link={item.slug}>
                  <span class="rail__dash" aria-hidden="true" />
                  <span class="rail__text">{item.text}</span>
                </a>
                {item.subs.length > 0 && (
                  <button
                    class="rail__fold"
                    type="button"
                    data-rail-fold
                    aria-expanded="false"
                    aria-label={`展开「${item.text}」的小节`}
                  >
                    <span class="rail__chev" aria-hidden="true" />
                  </button>
                )}
              </div>

              {item.subs.length > 0 && (
                <ol class="rail__subs" data-rail-subs hidden>
                  {item.subs.map((sub) => (
                    <li>
                      <a class="rail__item rail__item--sub" href={`#${sub.slug}`} data-toc-link={sub.slug}>
                        <span class="rail__dash" aria-hidden="true" />
                        <span class="rail__text">{sub.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
        <span class="rail__cap" aria-hidden="true" />
      </nav>
    )
  }

  <article class="wrap article">
    <header class="article__head" data-reveal>
      {
        cover ? (
          <img class="article__cover" src={cover} alt="" width="1200" height="750" />
        ) : (
          <div class="article__cover cover-ph">封面待补</div>
        )
      }

      <div class="article__intro">
        <h1 class="article__title">{data.title}</h1>
        <p class="article__summary">{data.summary}</p>

        <div class="article__meta">
          <span class="article__date">
            <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
            <span class="new-badge" data-new-since={data.publishedAt.toISOString()} hidden>NEW</span>
          </span>
          <span>{words} 字</span>
          <a class="article__raw" href={rawHref} download>Markdown 原文</a>
        </div>

        {
          data.tags.length > 0 && (
            <div class="tag-row article__tags">
              {data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="rule-tab" aria-hidden="true"></div>

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="上下篇">
          <div class="pager__cell">
            {prev && (
              <a href={entryHref(kind, prev.data.slug)}>
                <span class="eyebrow">上一篇</span>
                <span class="pager__title">{prev.data.title}</span>
              </a>
            )}
          </div>
          <div class="pager__cell pager__cell--right">
            {next && (
              <a href={entryHref(kind, next.data.slug)}>
                <span class="eyebrow">下一篇</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <p class="eyebrow">相关阅读</p>
          <ul class="related__list">
            {related.map((item) => (
              <li>
                <a href={entryHref(kind, item.data.slug)}>{item.data.title}</a>
                <span class="related__date">{formatDate(item.data.publishedAt)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 2px;
    width: 0;
    background: var(--accent);
  }

  .article {
    padding-block: clamp(2rem, 5vw, 3.25rem) 4rem;
  }

  /* ---------- 头部：左封面右信息 ---------- */

  .article__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: center;
    padding-bottom: 1.25rem;
  }

  .article__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
  }

  .article__title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.4vw, 2.35rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .article__summary {
    margin: 1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
  }

  .article__date {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .article__raw {
    border-bottom: var(--hair) solid var(--line-strong);
    padding-bottom: 0.1rem;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .article__raw:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .article__tags {
    margin-top: 1.1rem;
  }

  /* 正文与上方头部等宽，不再被右侧目录挤窄 */
  .prose {
    max-width: none;
    padding-top: 1.75rem;
  }

  /* ---------- 左侧卷轴目录 ---------- */

  .rail {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem 0.9rem 0.9rem;
    max-height: 80vh;
  }

  /* 一层很淡的底板，压住可能透上来的内容；不画右侧竖线 */
  .rail::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* 卷轴两端的轴头 */
  .rail__cap {
    position: relative;
    width: 1.35rem;
    height: 2px;
    flex: none;
    background: var(--line-strong);
  }

  .rail__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0.55rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .rail__list::-webkit-scrollbar { display: none; }

  .rail__group { position: relative; }

  /* 二级标题一行：标题 + 折叠角 */
  .rail__row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .rail__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  /* 折叠角：一个 45° 的小角，沿用全站的发丝线语言，不用三角形图标 */
  .rail__fold {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .rail__chev {
    width: 0.32rem;
    height: 0.32rem;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transform: rotate(-45deg);
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .rail__fold:hover .rail__chev { border-color: var(--fg); }
  .rail__fold[aria-expanded='true'] .rail__chev { transform: rotate(45deg); }

  .rail__subs {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0 0 0 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* 收起时只剩一截短线，长度表示层级 */
  .rail__dash {
    display: block;
    width: 0.9rem;
    height: 1px;
    flex: none;
    background: var(--line-strong);
    transition:
      width var(--dur-2) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .rail__item--sub .rail__dash { width: 0.5rem; }

  /* 默认就显示条目文字，不用悬浮 */
  .rail__text {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--fg-muted);
    white-space: nowrap;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-1) var(--ease-out);
  }

  .rail__item:hover .rail__dash { background: var(--fg); }
  .rail__item:hover .rail__text { color: var(--fg); }

  .rail__item[data-active='1'] .rail__dash {
    width: 1.4rem;
    background: var(--accent);
  }

  .rail__item--sub[data-active='1'] .rail__dash { width: 1rem; }
  .rail__item[data-active='1'] .rail__text { color: var(--accent); }

  /* 目录常驻展开约需 12rem，版心 76rem 两侧腾不出这么多就整条收起 */
  @media (max-width: 93rem) {
    .rail { display: none; }
  }

  /* ---------- 页尾区块 ---------- */

  .related {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: var(--hair) solid var(--line);
  }

  .related__list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .related__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: var(--hair) solid var(--line);
    font-size: 0.9375rem;
  }

  .related__list a:hover {
    color: var(--accent);
  }

  .related__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 3rem;
    border-top: var(--hair) solid var(--line);
  }

  .pager__cell {
    padding: 1.5rem 1.25rem;
    min-height: 5.5rem;
  }

  .pager__cell + .pager__cell {
    border-left: var(--hair) solid var(--line);
  }

  .pager__cell--right {
    text-align: right;
  }

  .pager__cell a {
    display: grid;
    gap: 0.5rem;
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.5;
  }

  .pager__cell a:hover .pager__title {
    color: var(--accent);
  }

  @media (max-width: 56rem) {
    .article__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__cell + .pager__cell {
      border-left: 0;
      border-top: var(--hair) solid var(--line);
    }

    .pager__cell--right {
      text-align: left;
    }
  }
</style>

<script is:inline>
  (function () {
    // ClientRouter 换页后 body 里的脚本会再跑一次，
    // 所以监听器要先摘旧的、DOM 增强要判重，否则会成倍叠加
    function cleanup() {
      if (window.__nnScroll) {
        document.removeEventListener('scroll', window.__nnScroll);
        window.removeEventListener('resize', window.__nnScroll);
        window.__nnScroll = null;
      }
      if (window.__nnTocObserver) {
        window.__nnTocObserver.disconnect();
        window.__nnTocObserver = null;
      }
    }

    function initArticle() {
      cleanup();

      // 阅读进度
      var bar = document.getElementById('reading-progress');
      var article = document.querySelector('.prose');
      if (bar && article) {
        var onScroll = function () {
          var rect = article.getBoundingClientRect();
          var total = rect.height - window.innerHeight;
          var passed = -rect.top;
          var ratio = total > 0 ? Math.min(1, Math.max(0, passed / total)) : 0;
          bar.style.width = ratio * 100 + '%';
        };
        window.__nnScroll = onScroll;
        document.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();
      }

      // 代码块：语言标签 + 复制按钮。mermaid 块要排掉，
      // 它渲染出来是一张图，不该有复制按钮和展开条
      document.querySelectorAll('.prose pre:not(.mermaid)').forEach(function (pre) {
        if (pre.dataset.enhanced === '1') return;
        pre.dataset.enhanced = '1';

        var wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        var code = pre.querySelector('code');
        var lang = code && code.getAttribute('data-language');
        if (lang && lang !== 'plaintext') {
          var tag = document.createElement('span');
          tag.className = 'code-block__lang';
          tag.textContent = lang;
          wrapper.appendChild(tag);
        }

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-block__copy';
        btn.textContent = 'COPY';
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText(pre.innerText).then(
            function () {
              btn.textContent = 'COPIED';
              btn.dataset.copied = '1';
              setTimeout(function () {
                btn.textContent = 'COPY';
                btn.dataset.copied = '';
              }, 1600);
            },
            function () {
              btn.textContent = 'FAILED';
              setTimeout(function () {
                btn.textContent = 'COPY';
              }, 1600);
            },
          );
        });
        wrapper.appendChild(btn);

        // 触屏下代码块被截断时给一个展开按钮。
        // 竖滚已经在 CSS 里关掉了，不然手指想滚页面会先滚到代码块里去
        if (pre.scrollHeight > pre.clientHeight + 4) {
          wrapper.dataset.clipped = '1';
          // 桌面端：只有这种真的能在块内上下滚的，才拦住滚动链
          pre.dataset.scrolls = '1';

          var more = document.createElement('button');
          more.type = 'button';
          more.className = 'code-block__more';
          more.textContent = '展开全部';
          more.addEventListener('click', function () {
            var open = wrapper.dataset.expanded === '1';
            if (open) {
              // 收起前先把视口拉回代码块顶部，否则会停在页面很下面
              var top = wrapper.getBoundingClientRect().top + window.pageYOffset - 90;
              wrapper.dataset.expanded = '';
              more.textContent = '展开全部';
              window.scrollTo({ top: top, behavior: 'instant' });
            } else {
              wrapper.dataset.expanded = '1';
              more.textContent = '收起';
            }
          });
          wrapper.appendChild(more);
        }
      });

      // 目录高亮
      var links = document.querySelectorAll('[data-toc-link]');
      if (links.length) {
        var map = {};
        links.forEach(function (link) {
          map[link.getAttribute('data-toc-link')] = link;
        });
        var targets = Object.keys(map)
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean);

        // 目录默认只露二级，点折叠角展开它下面的三级
        function setFold(btn, open) {
          var subs = btn.closest('.rail__group').querySelector('[data-rail-subs]');
          if (!subs) return;
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          subs.hidden = !open;
        }

        var rail = document.querySelector('.rail');
        if (rail && !rail.dataset.foldBound) {
          rail.dataset.foldBound = '1';
          rail.addEventListener('click', function (event) {
            var btn = event.target.closest('[data-rail-fold]');
            if (!btn) return;
            event.preventDefault();
            setFold(btn, btn.getAttribute('aria-expanded') !== 'true');
          });
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (item) {
              if (!item.isIntersecting) return;
              links.forEach(function (link) {
                link.dataset.active = '';
              });
              var active = map[item.target.id];
              if (!active) return;
              active.dataset.active = '1';

              // 跟着滚动联动：只把当前所在的那一组展开，其余全部收起。
              // 默认全收（标记里就带 hidden），读到哪一节哪一节自己打开
              var group = active.closest('.rail__group');
              if (rail) {
                rail.querySelectorAll('[data-rail-fold]').forEach(function (btn) {
                  setFold(btn, btn.closest('.rail__group') === group);
                });
              }
            });
          },
          { rootMargin: '-90px 0px -70% 0px', threshold: 0 },
        );
        window.__nnTocObserver = observer;
        targets.forEach(function (el) {
          observer.observe(el);
        });
      }
    }

    // 点开看大图。正文里的图和 mermaid 图都限到七成屏高，细节靠这层补回来。
    // 用事件委托挂在 document 上：mermaid 是滚到附近才画的，图晚于绑定出现
    function closeBox() {
      var box = document.querySelector('.lightbox');
      if (!box) return;
      box.removeAttribute('data-open');
      document.documentElement.style.overflow = '';
      window.setTimeout(function () {
        if (box.parentNode) box.parentNode.removeChild(box);
      }, 200);
    }

    function openBox(node) {
      closeBox();
      var box = document.createElement('div');
      box.className = 'lightbox';
      box.appendChild(node);

      var hint = document.createElement('p');
      hint.className = 'lightbox__hint';
      hint.textContent = '点击任意处关闭';
      box.appendChild(hint);

      document.body.appendChild(box);
      // 打开期间锁住页面滚动，免得背后的正文跟着动
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        box.dataset.open = '1';
      });
    }

    function onZoom(event) {
      if (document.querySelector('.lightbox')) {
        closeBox();
        return;
      }

      // 图版之外的图片（正文里直接写的 <img>）也能点开
      var img = event.target.closest('.prose img');
      if (img) {
        var copy = new Image();
        copy.src = img.currentSrc || img.src;
        copy.alt = img.alt;
        openBox(copy);
        return;
      }

      var svg = event.target.closest('.prose pre.mermaid[data-ready="1"] svg');
      if (svg) {
        var clone = svg.cloneNode(true);
        // mermaid 会把渲染尺寸写进行内样式，留着的话放大也只有原来那么大
        clone.removeAttribute('style');
        clone.removeAttribute('width');
        clone.removeAttribute('height');

        // 按 viewBox 的比例算出能放多大：交给 CSS 拉满会把扁长的图
        // 摊在一块竖着的底板中间。48 是左右各 1.5rem 的内边距
        var box = svg.viewBox.baseVal;
        if (box && box.width && box.height) {
          var room = Math.min(
            (window.innerWidth - 64 - 48) / box.width,
            (window.innerHeight - 88 - 48) / box.height,
          );
          clone.style.width = Math.round(box.width * room) + 'px';
          clone.style.height = Math.round(box.height * room) + 'px';
        }

        openBox(clone);
      }
    }

    if (!window.__nnZoomBound) {
      window.__nnZoomBound = true;
      document.addEventListener('click', onZoom);
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeBox();
      });
    }

    if (!window.__nnArticleBound) {
      window.__nnArticleBound = true;
      document.addEventListener('astro:page-load', initArticle);
    }

    // 没有 ClientRouter 时的兜底，有则由 astro:page-load 触发，避免重复初始化
    if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initArticle);
      } else {
        initArticle();
      }
    }
  })();
</script>
