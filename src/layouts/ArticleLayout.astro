---
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';
import type { AnyEntry, ContentKind } from '../lib/content';
import { entryHref, formatDate, countWords, readingMinutes, entryCover } from '../lib/content';

interface Props {
  kind: ContentKind;
  entry: AnyEntry;
  headings: MarkdownHeading[];
  prev?: AnyEntry;
  next?: AnyEntry;
  related?: AnyEntry[];
}

const { kind, entry, headings, prev, next, related = [] } = Astro.props;
const { data } = entry;
const body = entry.body ?? '';
const words = countWords(body);
const minutes = readingMinutes(body);
const rawHref = `/${kind}/${data.slug}.md`;
const cover = entryCover(entry);

// 侧栏目录只取 h2 / h3，更深的层级在导航里没有意义
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={data.title} description={data.summary} ogImage={cover} variant="bare">
  <div class="progress" id="reading-progress" aria-hidden="true"></div>

  {
    toc.length > 0 && (
      <nav class="rail" aria-label="目录">
        <span class="rail__cap" aria-hidden="true" />
        <ol class="rail__list">
          {toc.map((item) => (
            <li class:list={['rail__item', item.depth === 3 && 'rail__item--sub']}>
              <a href={`#${item.slug}`} data-toc-link={item.slug}>
                <span class="rail__dash" aria-hidden="true" />
                <span class="rail__text">{item.text}</span>
              </a>
            </li>
          ))}
        </ol>
        <span class="rail__cap" aria-hidden="true" />
      </nav>
    )
  }

  <article class="wrap article">
    <header class="article__head" data-reveal>
      {
        cover ? (
          <img class="article__cover" src={cover} alt="" width="1200" height="750" />
        ) : (
          <div class="article__cover cover-ph">封面待补</div>
        )
      }

      <div class="article__intro">
        <h1 class="article__title">{data.title}</h1>
        <p class="article__summary">{data.summary}</p>

        <div class="article__meta">
          <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
          <span>{words} 字</span>
          <span>约 {minutes} 分钟</span>
          <a class="article__raw" href={rawHref} download>Markdown 原文</a>
        </div>

        {
          data.tags.length > 0 && (
            <div class="tag-row article__tags">
              {data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="rule-tab" aria-hidden="true"></div>

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="上下篇">
          <div class="pager__cell">
            {prev && (
              <a href={entryHref(kind, prev.data.slug)}>
                <span class="label">上一篇</span>
                <span class="pager__title">{prev.data.title}</span>
              </a>
            )}
          </div>
          <div class="pager__cell pager__cell--right">
            {next && (
              <a href={entryHref(kind, next.data.slug)}>
                <span class="label">下一篇</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <p class="label">相关阅读</p>
          <ul class="related__list">
            {related.map((item) => (
              <li>
                <a href={entryHref(kind, item.data.slug)}>{item.data.title}</a>
                <span class="related__date">{formatDate(item.data.publishedAt)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 2px;
    width: 0;
    background: var(--accent);
  }

  .article {
    padding-block: clamp(2rem, 5vw, 3.25rem) 4rem;
  }

  /* ---------- 头部：左封面右信息 ---------- */

  .article__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: center;
    padding-bottom: 2.25rem;
  }

  .article__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: var(--hair) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
  }

  .article__title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.4vw, 2.35rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .article__summary {
    margin: 1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
  }

  .article__raw {
    border-bottom: var(--hair) solid var(--line-strong);
    padding-bottom: 0.1rem;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .article__raw:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .article__tags {
    margin-top: 1.1rem;
  }

  /* 正文与上方头部等宽，不再被右侧目录挤窄 */
  .prose {
    max-width: none;
    padding-top: 2.5rem;
  }

  /* ---------- 左侧卷轴目录 ---------- */

  .rail {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem 0.9rem 0.9rem;
    max-height: 80vh;
  }

  /* 一层很淡的底板，压住可能透上来的内容；不画右侧竖线 */
  .rail::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* 卷轴两端的轴头 */
  .rail__cap {
    position: relative;
    width: 1.35rem;
    height: 2px;
    flex: none;
    background: var(--line-strong);
  }

  .rail__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0.55rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .rail__list::-webkit-scrollbar { display: none; }

  .rail__item a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* 收起时只剩一截短线，长度表示层级 */
  .rail__dash {
    display: block;
    width: 0.9rem;
    height: 1px;
    flex: none;
    background: var(--line-strong);
    transition:
      width var(--dur-2) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .rail__item--sub .rail__dash { width: 0.5rem; }

  /* 默认就显示条目文字，不用悬浮 */
  .rail__text {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--fg-muted);
    white-space: nowrap;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-1) var(--ease-out);
  }

  .rail__item a:hover .rail__dash { background: var(--fg); }
  .rail__item a:hover .rail__text { color: var(--fg); }

  .rail__item a[data-active='1'] .rail__dash {
    width: 1.4rem;
    background: var(--accent);
  }

  .rail__item--sub a[data-active='1'] .rail__dash { width: 1rem; }
  .rail__item a[data-active='1'] .rail__text { color: var(--accent); }

  /* 目录常驻展开约需 12rem，版心 76rem 两侧腾不出这么多就整条收起 */
  @media (max-width: 93rem) {
    .rail { display: none; }
  }

  /* ---------- 页尾区块 ---------- */

  .related {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: var(--hair) solid var(--line);
  }

  .related__list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .related__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: var(--hair) solid var(--line);
    font-size: 0.9375rem;
  }

  .related__list a:hover {
    color: var(--accent);
  }

  .related__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 3rem;
    border-top: var(--hair) solid var(--line);
  }

  .pager__cell {
    padding: 1.5rem 1.25rem;
    min-height: 5.5rem;
  }

  .pager__cell + .pager__cell {
    border-left: var(--hair) solid var(--line);
  }

  .pager__cell--right {
    text-align: right;
  }

  .pager__cell a {
    display: grid;
    gap: 0.5rem;
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.5;
  }

  .pager__cell a:hover .pager__title {
    color: var(--accent);
  }

  @media (max-width: 56rem) {
    .article__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__cell + .pager__cell {
      border-left: 0;
      border-top: var(--hair) solid var(--line);
    }

    .pager__cell--right {
      text-align: left;
    }
  }
</style>

<script is:inline>
  (function () {
    // ClientRouter 换页后 body 里的脚本会再跑一次，
    // 所以监听器要先摘旧的、DOM 增强要判重，否则会成倍叠加
    function cleanup() {
      if (window.__nnScroll) {
        document.removeEventListener('scroll', window.__nnScroll);
        window.removeEventListener('resize', window.__nnScroll);
        window.__nnScroll = null;
      }
      if (window.__nnTocObserver) {
        window.__nnTocObserver.disconnect();
        window.__nnTocObserver = null;
      }
    }

    function initArticle() {
      cleanup();

      // 阅读进度
      var bar = document.getElementById('reading-progress');
      var article = document.querySelector('.prose');
      if (bar && article) {
        var onScroll = function () {
          var rect = article.getBoundingClientRect();
          var total = rect.height - window.innerHeight;
          var passed = -rect.top;
          var ratio = total > 0 ? Math.min(1, Math.max(0, passed / total)) : 0;
          bar.style.width = ratio * 100 + '%';
        };
        window.__nnScroll = onScroll;
        document.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();
      }

      // 代码块：语言标签 + 复制按钮
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        if (pre.dataset.enhanced === '1') return;
        pre.dataset.enhanced = '1';

        var wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        var code = pre.querySelector('code');
        var lang = code && code.getAttribute('data-language');
        if (lang && lang !== 'plaintext') {
          var tag = document.createElement('span');
          tag.className = 'code-block__lang';
          tag.textContent = lang;
          wrapper.appendChild(tag);
        }

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-block__copy';
        btn.textContent = 'COPY';
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText(pre.innerText).then(
            function () {
              btn.textContent = 'COPIED';
              btn.dataset.copied = '1';
              setTimeout(function () {
                btn.textContent = 'COPY';
                btn.dataset.copied = '';
              }, 1600);
            },
            function () {
              btn.textContent = 'FAILED';
              setTimeout(function () {
                btn.textContent = 'COPY';
              }, 1600);
            },
          );
        });
        wrapper.appendChild(btn);
      });

      // 目录高亮
      var links = document.querySelectorAll('[data-toc-link]');
      if (links.length) {
        var map = {};
        links.forEach(function (link) {
          map[link.getAttribute('data-toc-link')] = link;
        });
        var targets = Object.keys(map)
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean);

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (item) {
              if (!item.isIntersecting) return;
              links.forEach(function (link) {
                link.dataset.active = '';
              });
              var active = map[item.target.id];
              if (active) active.dataset.active = '1';
            });
          },
          { rootMargin: '-90px 0px -70% 0px', threshold: 0 },
        );
        window.__nnTocObserver = observer;
        targets.forEach(function (el) {
          observer.observe(el);
        });
      }
    }

    if (!window.__nnArticleBound) {
      window.__nnArticleBound = true;
      document.addEventListener('astro:page-load', initArticle);
    }

    // 没有 ClientRouter 时的兜底，有则由 astro:page-load 触发，避免重复初始化
    if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initArticle);
      } else {
        initArticle();
      }
    }
  })();
</script>
