---
// 标签总览：做成一本按字母查的索引。左边是热度榜（最常用的几个，带一根按篇数伸缩的细线），
// 右边按首字母分组（每组一行、单列往下排），中文按拼音首字母归进同一套 A–Z。
// 标签一共几十个，一页放得下，所以不再分页（老的 /tags/page/N/ 由中间件 301 回来）
import BaseLayout from './BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import { pageBackdrops } from '../config/site';
import KindIcon from '../components/KindIcon.astro';
import { encodePinyin } from '../lib/search-index';

interface Props {
  tags: { tag: string; count: number }[];
  totalEntries: number;
}

const { tags, totalEntries } = Astro.props;

// 拼音首字母：拼音排序规则下，每个字母取一个最靠前的汉字当分界（I、U、V 没有汉字打头），
// 一个字落在哪两个分界之间，首字母就是哪个。Node 自带完整 ICU，构建时算好
const collator = new Intl.Collator('zh-Hans-CN-u-co-pinyin');
const BOUNDS = '阿八嚓哒妸发旮哈讥咔垃妈拏噢妑七呥扨它穵夕丫帀';
const BOUND_LETTERS = 'ABCDEFGHJKLMNOPQRSTWXYZ';

function initial(tag: string): string {
  const ch = tag.trim().charAt(0);
  if (/[a-z]/i.test(ch)) return ch.toUpperCase();
  if (!/[一-鿿]/.test(ch)) return '#';
  let letter = '#';
  for (let i = 0; i < BOUNDS.length; i++) {
    if (collator.compare(BOUNDS[i], ch) > 0) break;
    letter = BOUND_LETTERS[i];
  }
  return letter;
}

const LETTERS = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
const groups = LETTERS.map((letter) => ({
  letter,
  items: tags.filter((t) => initial(t.tag) === letter).sort((a, b) => collator.compare(a.tag, b.tag)),
})).filter((group) => group.items.length > 0);

// 热度榜：最常用的 10 个；细线长度按篇数占第一名的比例
const top = tags.slice(0, 10);
const topMax = top[0]?.count ?? 1;

const tagHref = (tag: string) => `/tags/${encodeURIComponent(tag)}/`;
const anchor = (letter: string) => (letter === '#' ? 'tag-other' : `tag-${letter}`);
---

<BaseLayout title="标签" description="按话题浏览全部内容。">
  <!-- 插画里的人物正好压在左栏热度榜下面，淡一档 -->
  <PageBackdrop art={pageBackdrops.tags} quiet />

  <section class="wrap head">
    <div class="head__row" data-reveal>
      <h1 class="head__title"><KindIcon name="tags" class="head__icon" />标签</h1>
      <p class="head__meta">共 {tags.length} 个话题，{totalEntries} 篇内容</p>
    </div>
  </section>

  {
    tags.length > 0 ? (
      <section class="wrap body" data-tag-index>
        <aside class="hot" data-reveal style="--reveal-i: 1">
          <h2 class="hot__title"><KindIcon name="hot" class="hot__icon" />常用 Top{top.length}</h2>
          <ol class="hot__list">
            {top.map(({ tag, count }, i) => (
              <li>
                <a class="hot__item" href={tagHref(tag)} title={tag}>
                  <span class="hot__rank">{String(i + 1).padStart(2, '0')}</span>
                  <span class="hot__name">{tag}</span>
                  <span class="hot__count">{count}</span>
                  <span class="hot__bar" style={`--w: ${((count / topMax) * 100).toFixed(1)}%`} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ol>
        </aside>

        <div class="dict">
          <div class="dict__tools" data-reveal style="--reveal-i: 2">
            <label class="filter glow-field">
              <span class="glow-field__halo" aria-hidden="true"></span>
              <svg class="filter__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.5-3.5" stroke-linecap="round"></path>
              </svg>
              <input
                class="filter__input"
                type="search"
                placeholder="筛选标签"
                aria-label="筛选标签"
                autocomplete="off"
                data-tag-filter
              />
            </label>

          </div>

          <div class="dict__groups">
          {groups.map((group, i) => (
            <section class="dict__group" id={anchor(group.letter)} data-group={group.letter} data-reveal style={`--reveal-i: ${Math.min(i + 3, 9)}`}>
              <h2 class="dict__letter">{group.letter}</h2>
              <ul class="dict__tags">
                {group.items.map(({ tag, count }) => (
                  <li data-tag={tag} data-py={encodePinyin(tag, true)}>
                    <a class="chip" href={tagHref(tag)}>
                      <span class="chip__name">{tag}</span>
                      <span class="chip__count">{count}</span>
                    </a>
                  </li>
                ))}
                <li data-more hidden>
                  <button class="chip chip--more" type="button">更多...</button>
                </li>
              </ul>
            </section>
          ))}
          </div>

          <EmptyState data-tag-empty hidden text="没有匹配内容" />
        </div>
      </section>
    ) : (
      <section class="wrap body body--empty">
        <EmptyState text="这里还空着" />
      </section>
    )
  }
</BaseLayout>

<style>
  /* 背景是 fixed 的，内容层要抬上来 */
  .head,
  .body {
    position: relative;
    z-index: 1;
  }

  .head {
    padding-block: 2rem 1.5rem;
  }

  /* 标题在左，统计贴到同一行的最右侧 */
  .head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 1.25rem;
    border-bottom: var(--hair) solid var(--line);
  }

  .head__title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .head__title :global(.head__icon) {
    font-size: 0.8em;
    color: var(--fg-muted);
  }

  .head__meta {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    text-align: right;
  }

  /* 左栏热度榜、右栏字母索引；热度榜滚动时钉在顶栏下面 */
  .body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 4rem;
  }

  .body--empty {
    grid-template-columns: minmax(0, 1fr);
  }

  /* ---------- 热度榜 ---------- */

  .hot {
    position: sticky;
    top: 5rem;
  }

  .hot__title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
  }

  .hot__title :global(.hot__icon) {
    font-size: 1.15em;
    color: var(--fg-muted);
  }

  .hot__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--hair) solid var(--line);
  }

  .hot__item {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.7rem 0 0.8rem;
    border-bottom: var(--hair) solid var(--line);
    transition: color var(--dur-1) var(--ease-out);
  }

  .hot__rank,
  .hot__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-faint);
  }

  .hot__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
  }

  /* 篇数条：贴在这一格的底边上，长度按篇数占第一名的比例 */
  .hot__bar {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--w);
    height: 1px;
    background: var(--fg-muted);
    transform-origin: left;
    transition: background var(--dur-1) var(--ease-out);
  }

  .hot__item:hover { color: var(--accent); }
  .hot__item:hover .hot__bar { background: var(--accent); }

  /* ---------- 字母索引 ---------- */

  .dict__tools {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .filter {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.85rem;
    border: var(--hair) solid var(--line);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .filter:focus-within { border-color: var(--line-strong); }

  .filter__icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--fg-faint);
  }

  .filter__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.9375rem;
    outline: none;
  }

  .filter__input::placeholder { color: var(--fg-faint); }

  /* 每组：左边一个大字母，右边一串标签；组与组之间一道发丝线 */
  .dict__group {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.1rem;
    border-top: var(--hair) solid var(--line);
    break-inside: avoid;
    /* 跳到锚点时别被顶栏盖住 */
    scroll-margin-top: 5rem;
  }

  .dict__letter {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 2rem;
    color: var(--fg-faint);
  }

  .dict__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    max-width: 100%;
    padding: 0.35rem 0.7rem;
    border: var(--hair) solid var(--line);
    transition: border-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .chip__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
  }

  .chip__count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--fg-faint);
  }

  .chip:hover .chip__count { color: var(--accent); }

  /* 「更多...」：虚线框，和标签同高 */
  .chip--more {
    border-style: dashed;
    background: none;
    color: var(--fg-muted);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .dict__tags :global(mark) {
    background: none;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 56rem) {
    /* 窄了就上下排：热度榜在上面，横着两列 */
    .body { grid-template-columns: minmax(0, 1fr); }
    .hot { position: static; }

    .hot__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (max-width: 44rem) {
    .head__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .head__title { white-space: normal; }
    .head__meta { text-align: left; }

    .hot__list { column-gap: 1rem; }
    .dict__group { grid-template-columns: 2rem minmax(0, 1fr); gap: 0.6rem; }
  }
</style>

<script>
  import { bindBorderGlow } from '../lib/border-glow';
  import {
    highlightRanges,
    matchField,
    parseQuery,
    prepareField,
    type PreparedField,
  } from '../lib/search-engine';

  // 每组标签平时最多三行，超出时第三行末尾换成「更多...」，每点一次多放两行；
  // 筛选框有内容时不收，只按名字/拼音/注音/容错过滤与高亮，组里一个不剩就整组藏起来
  const FIRST = 3;
  const STEP = 2;

  interface TagEntry {
    li: HTMLLIElement;
    nameEl: HTMLElement | null;
    raw: string;
    field: PreparedField;
  }

  interface TagGroupEl extends HTMLElement {
    __lines?: number;
  }

  let cleanupTags: (() => void) | null = null;

  function teardown() {
    cleanupTags?.();
    cleanupTags = null;
  }

  function init() {
    teardown();

    const root = document.querySelector<HTMLElement>('[data-tag-index]');
    if (!root) return;
    const input = root.querySelector<HTMLInputElement>('[data-tag-filter]');
    const empty = root.querySelector<HTMLElement>('[data-tag-empty]');
    const itemEls = root.querySelectorAll<HTMLLIElement>('[data-tag]');
    const groups = root.querySelectorAll<TagGroupEl>('[data-group]');
    if (!input) return;

    const tags: TagEntry[] = Array.from(itemEls).map((li) => {
      const raw = li.getAttribute('data-tag') || '';
      const py = li.getAttribute('data-py') || '';
      return {
        li,
        nameEl: li.querySelector<HTMLElement>('.chip__name'),
        raw,
        field: prepareField(raw, py),
      };
    });

    function lines(list: Element): number {
      const tops: Record<number, number> = {};
      let n = 0;
      for (let i = 0; i < list.children.length; i++) {
        const li = list.children[i] as HTMLElement;
        if (li.hidden) continue;
        const key = Math.round(li.offsetTop);
        if (!tops[key]) {
          tops[key] = 1;
          n += 1;
        }
      }
      return n;
    }

    function clamp(group: TagGroupEl) {
      const list = group.querySelector('.dict__tags');
      const items = group.querySelectorAll<HTMLElement>('[data-tag]');
      const more = group.querySelector<HTMLElement>('[data-more]');
      if (!list || !more) return;
      const max = group.__lines || FIRST;
      items.forEach((li) => {
        li.hidden = false;
      });
      more.hidden = true;
      if (lines(list) <= max) return;
      more.hidden = false;
      for (let k = items.length - 1; k > 0; k--) {
        items[k].hidden = true;
        if (lines(list) <= max) break;
      }
    }

    function clampAll() {
      if (input?.value.trim()) return;
      groups.forEach(clamp);
    }

    function onRootClick(event: Event) {
      const target = event.target as HTMLElement | null;
      const btn = target?.closest?.('[data-more]');
      if (!btn) return;
      const group = btn.closest<TagGroupEl>('[data-group]');
      if (!group) return;
      group.__lines = (group.__lines || FIRST) + STEP;
      clamp(group);
    }

    function onInput() {
      if (!input) return;
      const parsed = parseQuery(input.value);
      if (!parsed.terms.length) {
        tags.forEach((entry) => {
          entry.li.hidden = false;
          if (entry.nameEl && (entry.nameEl.firstElementChild || entry.nameEl.textContent !== entry.raw)) {
            entry.nameEl.textContent = entry.raw;
          }
        });
        groups.forEach((group) => {
          group.hidden = false;
        });
        clampAll();
        if (empty) empty.hidden = true;
        return;
      }

      let shown = 0;
      tags.forEach((entry) => {
        const ranges: [number, number][] = [];
        let ok = true;
        for (let i = 0; i < parsed.terms.length; i++) {
          const m = matchField(entry.field, parsed.terms[i], { allowTypo: true, collectAll: true });
          if (!m) {
            ok = false;
            break;
          }
          ranges.push(...m.ranges);
        }
        if (ok && parsed.phrase) {
          const pm = matchField(entry.field, parsed.phrase, { allowTypo: false, collectAll: true });
          if (pm) ranges.push(...pm.ranges);
        }

        entry.li.hidden = !ok;
        if (entry.nameEl) {
          if (ok) {
            entry.nameEl.innerHTML = highlightRanges(entry.raw, ranges);
          } else if (entry.nameEl.firstElementChild || entry.nameEl.textContent !== entry.raw) {
            entry.nameEl.textContent = entry.raw;
          }
        }
        if (ok) shown += 1;
      });

      groups.forEach((group) => {
        const more = group.querySelector<HTMLElement>('[data-more]');
        if (more) more.hidden = true;
        group.hidden = !group.querySelector('[data-tag]:not([hidden])');
      });

      if (empty) empty.hidden = shown > 0;
    }

    function onKey(event: KeyboardEvent) {
      if (!input || event.key !== 'Escape' || !input.value) return;
      input.value = '';
      onInput();
    }

    let timer = 0;
    function onResize() {
      clearTimeout(timer);
      timer = window.setTimeout(clampAll, 120);
    }

    const filterBox = input.closest<HTMLElement>('.filter');
    const stopGlow = filterBox ? bindBorderGlow(filterBox) : () => {};

    root.addEventListener('click', onRootClick);
    input.addEventListener('input', onInput);
    input.addEventListener('keydown', onKey);
    window.addEventListener('resize', onResize);
    clampAll();

    cleanupTags = () => {
      stopGlow();
      clearTimeout(timer);
      root.removeEventListener('click', onRootClick);
      input.removeEventListener('input', onInput);
      input.removeEventListener('keydown', onKey);
      window.removeEventListener('resize', onResize);
    };
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
