---
// 分类列表页和关于页的背景插画：钉在视口上，垫在所有内容下面，跟着深浅主题交叉淡入。
// 只靠降低插画本身的不透明度让位给正文，不加模糊、不叠遮罩（用户要求插画要看得清）。
// 原图是无损 WebP，一张 800KB 上下；这里走 OSS 实时压缩，q85 约 40KB，压在半透明底下看不出差别
import type { PageBackdrop } from '../config/site';

interface Props {
  art: PageBackdrop;
  // 正文是大段文字、整页都压在人物上的页面（关于页）再淡一档
  quiet?: boolean;
}

const { art, quiet = false } = Astro.props;

const QUALITY = '?x-oss-process=image/quality,q_85';
const vars = [
  `--pb-day: url('${art.light}${QUALITY}')`,
  `--pb-night: url('${art.dark}${QUALITY}')`,
  `--pb-day-tall: url('${art.lightPortrait}${QUALITY}')`,
  `--pb-night-tall: url('${art.darkPortrait}${QUALITY}')`,
].join('; ');
---

<div class:list={['page-bd', { 'page-bd--quiet': quiet }]} aria-hidden="true" style={vars}>
  <div class="page-bd__layer page-bd__layer--day"></div>
  <div class="page-bd__layer page-bd__layer--night"></div>
</div>

<style>
  /* z-index 负数：只压在页面底色之上，正文、封面、列表页的像素噪声都在它上面 */
  /* 高度用 lvh（地址栏收起时的大视口），不用 inset: 0：手机上滑动时地址栏一收一放，
     inset: 0 的高度跟着变，cover 跟着重新缩放，贴底的插画就一下一下地挪。lvh 不变，插画钉死不动，
     地址栏展开时只是底边被它挡住一点 */
  .page-bd {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
  }

  /* 人物都在左下角、中间留白：横图靠左贴底裁切，窗口比图窄时只裁掉右边的留白和小装饰，人物和桌面永远完整 */
  .page-bd__layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: left bottom;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  /* 夜图底色本来就接近页面深色，人物偏亮，透明度要比白天再低一点 */
  .page-bd {
    --pb-day-alpha: 0.5;
    --pb-night-alpha: 0.42;
  }

  .page-bd--quiet {
    --pb-day-alpha: 0.4;
    --pb-night-alpha: 0.32;
  }

  /* 窄屏正文铺满整宽，人物一定压在文字底下，再淡一点 */
  @media (max-width: 44rem) {
    .page-bd {
      --pb-day-alpha: 0.4;
      --pb-night-alpha: 0.32;
    }

    .page-bd--quiet {
      --pb-day-alpha: 0.32;
      --pb-night-alpha: 0.26;
    }
  }

  .page-bd__layer--day {
    background-image: var(--pb-day);
    opacity: var(--pb-day-alpha);
  }

  .page-bd__layer--night { background-image: var(--pb-night); }

  :global(:root[data-theme='dark']) .page-bd__layer--day { opacity: 0; }
  :global(:root[data-theme='dark']) .page-bd__layer--night { opacity: var(--pb-night-alpha); }

  /* 比正方形还窄就换竖图。横图 16:9、竖图 9:16，1:1 正好在两者中间，两边裁得都最少；
     以前在 4:5 才切，接近正方形的窗口用横图会被左右裁掉近一半。竖图人物占满底部整宽，左右各裁一点，居中 */
  @media (max-aspect-ratio: 1 / 1) {
    .page-bd__layer {
      background-position: center bottom;
    }

    .page-bd__layer--day { background-image: var(--pb-day-tall); }
    .page-bd__layer--night { background-image: var(--pb-night-tall); }
  }
</style>
