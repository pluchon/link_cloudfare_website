---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// 只取 h2 / h3，更深的层级在侧栏里没有意义
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="目录">
      <p class="label toc__label">目录</p>
      <ol class="toc__list">
        {items.map((item) => (
          <li class:list={['toc__item', item.depth === 3 && 'toc__item--sub']}>
            <a href={`#${item.slug}`} data-toc-link={item.slug}>
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
    padding-left: 1.5rem;
    border-left: var(--hair) solid var(--line);
  }

  .toc__label {
    margin: 0 0 0.9rem;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .toc__item + .toc__item {
    margin-top: 0.55rem;
  }

  .toc__item--sub {
    padding-left: 0.9rem;
  }

  .toc a {
    color: var(--fg-faint);
    transition: color 0.18s ease;
  }

  .toc a:hover {
    color: var(--fg);
  }

  .toc a[data-active='1'] {
    color: var(--accent);
  }
</style>
