---
// 文章伴奏与正文朗读：音频本身和滚动后右下角的小播放条。入口按钮在 ArticleLayout 的日期行里，
// 带 data-music-toggle / data-speech-toggle 的按钮都由这里的脚本管。
// 默认不播放，preload=none，点之前不产生任何音频流量。
// 小条不能放进文章头部：那里有 data-reveal 的 transform，fixed 会变成相对它定位
import MusicIcon from './MusicIcon.astro';

interface Track {
  name: string;
  url: string;
}

interface Props {
  name?: string;
  url?: string;
  music?: Track;
  speech?: Track;
}

const { name, url, music = name && url ? { name, url } : undefined, speech } = Astro.props;
const tracks = [
  ...(music ? [{ kind: 'music' as const, name: music.name, url: music.url, loop: true, volume: 50 }] : []),
  ...(speech ? [{ kind: 'speech' as const, name: speech.name, url: speech.url, loop: false, volume: 85 }] : []),
];
---

{
  tracks.map((t) => (
    <audio data-audio={t.kind} data-name={t.name} src={t.url} preload="none" loop={t.loop ? true : undefined} />
  ))
}

<div class="music-bar-dock">
  {
    tracks.map((t) => (
      <div class="music-bar" data-audio-bar={t.kind}>
        <button
          class="music-bar__toggle"
          type="button"
          data-audio-toggle={t.kind}
          aria-pressed="false"
          aria-label={`播放：${t.name}`}
        >
          <MusicIcon idle={t.kind === 'speech' ? 'speech' : 'play'} />
        </button>
        <span class="music-bar__name" title={t.name} data-audio-name={t.kind}>
          {t.name}
        </span>
        <input
          class="music-bar__volume"
          type="range"
          min="0"
          max="100"
          value={String(t.volume)}
          aria-label={`${t.name}音量`}
          data-audio-volume={t.kind}
        />
      </div>
    ))
  }
</div>

<style>
  .music-bar-dock {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.45rem;
    pointer-events: none;
  }

  .music-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100vw - 2.5rem);
    padding: 0.4rem 0.8rem 0.4rem 0.4rem;
    border: var(--hair) solid var(--line-strong);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.4rem);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      visibility var(--dur-2);
  }

  .music-bar[data-show='1'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .music-bar__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.0625rem;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .music-bar__toggle:hover,
  .music-bar__toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  .music-bar__name {
    min-width: 0;
    max-width: 10rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 音量条也是一根发丝线，滑块是一小截竖线 */
  .music-bar__volume {
    flex: none;
    width: 4.5rem;
    height: 1.5rem;
    margin: 0;
    background: none;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  .music-bar__volume::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--line-strong);
  }

  .music-bar__volume::-moz-range-track {
    height: 1px;
    background: var(--line-strong);
  }

  .music-bar__volume::-webkit-slider-thumb {
    width: 0.3rem;
    height: 0.8rem;
    margin-top: calc(-0.4rem + 0.5px);
    border: 0;
    background: var(--accent);
    appearance: none;
    -webkit-appearance: none;
  }

  .music-bar__volume::-moz-range-thumb {
    width: 0.3rem;
    height: 0.8rem;
    border: 0;
    border-radius: 0;
    background: var(--accent);
  }
</style>

<script>
  let teardown: (() => void) | null = null;
  let mountedKey = '';

  function init() {
    const audios = [...document.querySelectorAll<HTMLAudioElement>('audio[data-audio]')];
    const key = audios.map((a) => `${a.dataset.audio}:${a.getAttribute('src')}`).join('|');
    if (!audios.length || key === mountedKey) return;
    mountedKey = key;

    const events = new AbortController();
    const { signal } = events;
    const observers: IntersectionObserver[] = [];

    for (const audio of audios) {
      const kind = audio.dataset.audio!;
      const bar = document.querySelector<HTMLElement>(`[data-audio-bar="${kind}"]`);
      const volume = document.querySelector<HTMLInputElement>(`[data-audio-volume="${kind}"]`);
      if (!bar || !volume) continue;

      const toggles = [
        ...document.querySelectorAll<HTMLElement>(
          `[data-audio-toggle="${kind}"], [data-${kind}-toggle]`,
        ),
      ];
      const names = [
        ...document.querySelectorAll<HTMLElement>(
          `[data-audio-name="${kind}"], [data-${kind}-name]`,
        ),
      ];
      const entry = toggles.find((toggle) => !bar.contains(toggle));
      const name = audio.dataset.name ?? '';

      let started = false;
      let entryInView = true;

      audio.volume = Number(volume.value) / 100;

      const syncBar = () => {
        bar.dataset.show = started && !entryInView ? '1' : '';
      };

      const setPressed = (pressed: boolean) => {
        toggles.forEach((toggle) => {
          toggle.setAttribute('aria-pressed', String(pressed));
          toggle.setAttribute('aria-label', `${pressed ? '暂停' : '播放'}：${name}`);
        });
      };

      const setFailed = (failed: boolean) => {
        names.forEach((el) => (el.textContent = failed ? '加载失败，点击重试' : name));
      };

      toggles.forEach((toggle) => {
        toggle.addEventListener(
          'click',
          () => {
            if (!audio.paused) {
              audio.pause();
              return;
            }
            if (audio.error) {
              setFailed(false);
              audio.load();
            }
            audio.play().catch(() => {});
          },
          { signal },
        );
      });

      audio.addEventListener(
        'play',
        () => {
          started = true;
          setPressed(true);
          syncBar();
        },
        { signal },
      );
      audio.addEventListener('pause', () => setPressed(false), { signal });
      audio.addEventListener('ended', () => setPressed(false), { signal });
      audio.addEventListener(
        'error',
        () => {
          setPressed(false);
          setFailed(true);
        },
        { signal },
      );

      volume.addEventListener('input', () => (audio.volume = Number(volume.value) / 100), { signal });

      if (entry) {
        const observer = new IntersectionObserver(
          ([item]) => {
            entryInView = item.isIntersecting;
            syncBar();
          },
          { rootMargin: '-64px 0px 0px 0px' },
        );
        observer.observe(entry);
        observers.push(observer);
      }
    }

    teardown = () => {
      events.abort();
      observers.forEach((o) => o.disconnect());
      audios.forEach((audio) => {
        audio.pause();
        audio.removeAttribute('src');
        audio.load();
      });
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
    mountedKey = '';
  });
  init();
</script>
