---
// 顶栏导航、分类页标题、标签页标题前面的小图标。线条和顶栏那几个工具图标同一套（24 格、1.5 描边、圆头），
// 每个再点一处粉色（蝴蝶结、腮红、小爱心），和站标那条系着粉蝴蝶结的猫尾巴呼应。
// 粉色只是插画里的一点点缀，不是交互色，所以不用朱红
export type IconName = 'project' | 'tool' | 'explore' | 'daily' | 'xiaomeng' | 'about' | 'tags';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['kind-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'project' && (
      <>
        {/* 竖着猫耳朵的笔记本 */}
        <path d="M6.6 6.5 7.6 3.6l2.2 2.9M14.2 6.5l2.2-2.9 1 2.9" />
        <rect x="4.5" y="6.5" width="15" height="10" rx="1.6" />
        <path d="M4.5 16.5 2.8 19.6a.6.6 0 0 0 .5.9h17.4a.6.6 0 0 0 .5-.9l-1.7-3.1" />
        <path class="kind-icon__pink" d="M12 14.2c-2-1.3-3.1-2.4-3.1-3.5 0-.8.6-1.5 1.4-1.5.7 0 1.3.4 1.7 1.1.4-.7 1-1.1 1.7-1.1.8 0 1.4.7 1.4 1.5 0 1.1-1.1 2.2-3.1 3.5z" />
      </>
    )
  }
  {
    name === 'tool' && (
      <>
        {/* 扳手，柄上系一只蝴蝶结 */}
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.4-3.4a6 6 0 0 1-7.9 7.9l-6.6 6.6a2.1 2.1 0 0 1-3-3l6.6-6.6a6 6 0 0 1 7.9-7.9z" />
        <path class="kind-icon__pink" d="M8.2 15.8 5.2 14.6 7 12.8zM8.2 15.8l1.2 3 1.8-1.8z" />
        <circle cx="8.2" cy="15.8" r=".9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'explore' && (
      <>
        {/* 放大镜的镜片是一张猫脸 */}
        <path d="M6.3 6.7 6.2 3.3l3 1.9M14.7 6.7l.1-3.4-3 1.9" />
        <circle cx="10.5" cy="11" r="6" />
        <path d="m15 15.5 5.2 5.2" />
        <circle cx="8.5" cy="10.4" r=".6" fill="currentColor" stroke="none" />
        <circle cx="12.5" cy="10.4" r=".6" fill="currentColor" stroke="none" />
        <ellipse class="kind-icon__pink" cx="7.6" cy="12.6" rx="1.1" ry=".7" />
        <ellipse class="kind-icon__pink" cx="13.4" cy="12.6" rx="1.1" ry=".7" />
      </>
    )
  }
  {
    name === 'daily' && (
      <>
        {/* 冒热气的马克杯，杯身一颗小爱心 */}
        <path d="M8.5 6.6c-.7-.9.7-1.6 0-2.6M12.5 6.6c-.7-.9.7-1.6 0-2.6" />
        <path d="M4.5 9h12v6a4.5 4.5 0 0 1-4.5 4.5H9A4.5 4.5 0 0 1 4.5 15z" />
        <path d="M16.5 10.5h1.2a2.5 2.5 0 0 1 0 5h-1.4" />
        <path class="kind-icon__pink" d="M10.5 16.2c-1.7-1.1-2.6-2-2.6-3 0-.7.5-1.2 1.2-1.2.6 0 1.1.3 1.4.9.3-.6.8-.9 1.4-.9.7 0 1.2.5 1.2 1.2 0 1-.9 1.9-2.6 3z" />
      </>
    )
  }
  {
    name === 'xiaomeng' && (
      <>
        {/* 小萌的猫脸：尖耳朵、ω 嘴、两团腮红 */}
        <path d="M5 9.4 4.5 3.8l4.4 2.9a8.4 8.4 0 0 1 6.2 0l4.4-2.9-.5 5.6a7.4 7.4 0 0 1 1.5 4.3c0 3.8-3.8 6.8-8.5 6.8s-8.5-3-8.5-6.8A7.4 7.4 0 0 1 5 9.4z" />
        <circle cx="9" cy="12.4" r=".7" fill="currentColor" stroke="none" />
        <circle cx="15" cy="12.4" r=".7" fill="currentColor" stroke="none" />
        <path d="M10.6 15.1c.4.6 1 .6 1.4 0 .4.6 1 .6 1.4 0" />
        <ellipse class="kind-icon__pink" cx="7.2" cy="14.8" rx="1.2" ry=".75" />
        <ellipse class="kind-icon__pink" cx="16.8" cy="14.8" rx="1.2" ry=".75" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        {/* 站标那条猫尾巴的简笔版：卷起来的尾巴，根部一只粉蝴蝶结 */}
        <path d="M7.6 21.4C4.6 18.4 4.9 14.6 8.6 12c2.8-1.9 4-3.6 3.2-5.8-.6-1.8.8-3.6 3-3.2 3.4.6 4.6 3.8 3 6.6-1.4 2.6-4.6 4-5.8 6.4-.6 1.2-.6 3 .1 5.4z" />
        <path d="M14.2 5.4c1.2.5 1.9 1.6 1.8 2.8" />
        <path class="kind-icon__pink" d="M9.6 18.8 5.8 17.3l.2 3.9zM9.6 18.8l3.8-1.4-.1 3.9z" />
        <circle cx="9.6" cy="18.8" r="1.05" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'tags' && (
      <>
        {/* 吊牌：穿绳的小孔，牌面一颗小爱心 */}
        <path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z" />
        <circle cx="7.5" cy="7.5" r="1.4" />
        <path class="kind-icon__pink" d="M13.4 16.4c-1.9-1-2.9-1.9-3-3-.1-.8.4-1.4 1.2-1.5.7-.1 1.3.3 1.6.9.4-.6 1-.9 1.6-.8.8.1 1.3.8 1.1 1.5-.2 1.1-1.2 2-2.5 2.9z" />
      </>
    )
  }
</svg>

<style>
  .kind-icon {
    width: 1em;
    height: 1em;
    flex: none;
    overflow: visible;
  }

  .kind-icon__pink {
    fill: var(--icon-pink);
    stroke: none;
  }
</style>
