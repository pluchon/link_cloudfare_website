---
interface Props {
  label: string;
  title?: string;
}

const { label, title } = Astro.props;
---

<div class="label-rule">
  <span class="label">{label}</span>
  {title && <h2 class="section-title">{title}</h2>}
</div>

<style>
  .section-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.01em;
  }
</style>
