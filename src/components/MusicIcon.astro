---
// 伴奏按钮的图标：没在放时是音符或三角，放的时候换成暂停。跟着按钮的 aria-pressed 走，脚本不用管图标
interface Props {
  idle?: 'note' | 'play';
}

const { idle = 'note' } = Astro.props;
---

<svg class="music-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <g class="music-icon__idle">
    {
      idle === 'note' ? (
        <>
          <path d="M9 18V5.500l11-2V16" />
          <circle cx="6.500" cy="18" r="2.500" />
          <circle cx="17.500" cy="16" r="2.500" />
        </>
      ) : (
        <path d="M8 5.500v13l10-6.500z" />
      )
    }
  </g>
  <path class="music-icon__on" d="M9 5.500v13M15 5.500v13" />
</svg>

<style>
  .music-icon {
    flex: none;
    width: 1em;
    height: 1em;
  }

  .music-icon__on {
    display: none;
  }

  :global([aria-pressed='true']) .music-icon__idle {
    display: none;
  }

  :global([aria-pressed='true']) .music-icon__on {
    display: inline;
  }
</style>
