---
import type { ContentKind, AnyEntry } from '../lib/content';
import { entryHref, formatDate, entryCover } from '../lib/content';

interface Props {
  kind: ContentKind;
  entry: AnyEntry;
}

const { kind, entry } = Astro.props;
const { data } = entry;
const href = entryHref(kind, data.slug);
const cover = entryCover(entry);
---

<article class="entry" data-reveal>
  <div class="entry__cover-wrap">
    {
      cover ? (
        <img class="entry__cover" src={cover} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="entry__cover cover-ph">封面待补</div>
      )
    }
  </div>

  <div class="entry__body">
    <div class="entry__date">
      <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      <span class="new-badge" data-new-since={data.publishedAt.toISOString()} hidden>NEW</span>
    </div>
    <h3 class="entry__title">
      <a href={href}>{data.title}</a>
    </h3>
    <p class="entry__summary">{data.summary}</p>
  </div>

  <a class="entry__hit" href={href} aria-label={data.title}></a>
</article>

<style>
  /* 整行可点：覆盖一层透明链接，标题链接仍保留语义 */
  .entry__hit {
    position: absolute;
    inset: 0;
  }
  .entry__title a {
    position: relative;
    z-index: 1;
  }
</style>
